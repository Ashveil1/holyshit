# Int / Int is true division (the result is a Float); % follows Python's
# floor convention, so the remainder takes the divisor's sign. Both used
# to fall into the integer idiv path on the x64 backend.
print 7 / 2
print -7 / 2
print 7 / -2
print -7 / -2
print 1 / 3
print 1000000 / 7
print 0 / 5
print 7 % 3
print -7 % 3
print 7 % -3
print -7 % -3