def sq(xs):
  return [x * x for x in xs]
print sq([1, 2, 3])
print [x for x in [1, 2, 3, 4, 5, 6] if x % 2 == 0]
k = 10
print [x + k for x in [1, 2]]
def g(n):
  m = 3
  return [i * m for i in range(n) if i > 0]
print g(5)
print [[y for y in [1, 2, x]] for x in [7, 8]]
print [c for c in "abc"]
print len([x for x in []])
print [(lambda a: a + x)(1) for x in [1, 2]]
print [x if x > 1 else 0 for x in [1, 2, 3]]
x = 99
print [x for x in [1, 2]]
print x
print [i for i in range(3)] == [0, 1, 2]
print [x for x in (lambda: [1, 2, 3])() if (lambda v: v > 1)(x)]
print [(lambda a: a * x)(2) for x in [1, 2] if (lambda v: v > 0)(x)]
