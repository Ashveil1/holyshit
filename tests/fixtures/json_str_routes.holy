# C19: json_str byte-parity battery. Every line is "<idx>|<payload>" so the
# runner can diff routes against each other and against the CPython oracle
# (json.dumps(ensure_ascii=True, allow_nan=False)). Valid UTF-8 only: invalid
# byte sequences are outside the cross-route guarantee (see native/rt.c
# js_str). Long strings exercise encoder buffer growth.

print "01|" + json_str(json_parse("\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\u0008\\u0009\\u000a\\u000b\\u000c\\u000d\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\""))
print "02|" + json_str(json_parse("\"\\u007f\\u0080\\u00ff\\u0100\\u07ff\\u0800\""))
print "03|" + json_str("ก ข นก นกแก้ว ไทย สวัสดีครับ ผู้ใช้")
print "04|" + json_str("🙂 🙂🙂🙂 🚀✨")
print "05|" + json_str(json_parse("\"\\ud7ff\\ue000\\uffff\""))
print "06|" + json_str(json_parse("\"\\ud800\\udc00\""))
print "07|" + json_str(json_parse("\"\\udbff\\udfff\""))
print "08|" + json_str("a\"b\\c/d\te\nf")
print "09|" + json_str("nul\0here")
print "10|" + json_str([0.1, 3.0, -0.0, 0.5, -0.5, 1.5, 123456.789])
print "11|" + json_str([1e300, 1e-5, 1e16, 1e15, 1e-4, 9.999e-5, -1.5e-7])
print "12|" + json_str([5e-324, 1.7976931348623157e308, 2.2250738585072014e-308])
print "13|" + json_str([9007199254740992.0, 9007199254740994.0, 9999999999999998.0])
print "14|" + json_str({"s": "ไทย", "n": 42, "f": 0.1, "deep": [{"x": "🙂🙂"}], "ผู้ใช้": [true, null]})
print "15|" + json_str(json_parse(json_str(3.0)))
print "16|" + json_str(json_parse(json_str(-0.0)))
print "17|" + json_str(json_parse(json_str(0.1)))
print "18|" + json_str(json_parse(json_str("ก")))
print "19|" + json_str(json_parse("{\"t\": \"ไทย\", \"e\": \"🙂\", \"l\": [1, 2.5, \"x\"]}"))

# LCG differential: 200 pseudo-random picks from a pool of tricky strings.
pool = ["ก", "นกแก้ว", "a", "A", "é", "z", "🙂", "aa", "", " "]
append(pool, json_parse("\"\\u0001\\u001f\\u007f\\u0080\""))
append(pool, "ข้าว ข้า a robin")
append(pool, json_parse("\"\\ud83d\\ude42\\ud83d\\ude00\""))
x = 12345
i = 0
while i < 200:
  x = (48271 * x + 12345) % 2147483648
  v = pool[x % len(pool)]
  print "20|" + json_str([x, v])
  i = i + 1

# buffer growth: long string (doubling) and a wide list
s = "กขc def🙂"
i = 0
while i < 8:
  s = s + s
  i = i + 1
print "21|" + json_str(s)
big = []
i = 0
while i < 400:
  append(big, 0.1)
  i = i + 1
print "22|" + json_str(big)

# non-finite rejection surfaces (same text on every route, line included)
try:
  print json_str(float("1e" + "999"))
  print "23|no-raise"
except as e:
  print "23|err " + e
try:
  print json_str(0.0 - float("1e" + "999"))
  print "24|no-raise"
except as e:
  print "24|err " + e
try:
  print json_str(float("nan" + ""))
  print "25|no-raise"
except as e:
  print "25|err " + e
