print json_str(json_parse("[1, true, null, 1.5, {\"z\": \"\\u0e44\\u0e17\\u0e22\", \"a\": [\"\\ud83d\\ude42\", \"x\"]}]"))
print json_str(json_parse("{\"b\": 1, \"a\": 2}"))
def wrap(n):
  v = "leaf"
  i = 0
  while i < n:
    v = [v]
    i = i + 1
  return v
for n in [199, 200, 201]:
  try:
    print json_str(wrap(n))
  except as e:
    print e
cycle = []
append(cycle, cycle)
try:
  print json_str(cycle)
except as e:
  print e
