# agent/core.holy — a small local agent core in pure hs.
#
# What it is: an ordered pattern-rule matcher with a teachable memory
# (several facts per thing), user-taught paraphrases, short-term session
# notes, and a little dialogue context (it tracks the current topic,
# follows "it", and asks which thing you meant when a miss has a handful
# of plausible candidates). What it is not: a language model. Everything
# it "knows" was taught; anything else gets an honest fallback reply.
#
# The core is pure: respond(state, line) only reads/mutates the state
# Dict and returns the reply Str. State is JSON-serializable:
#   {"facts": {k: [v, ...]}, "order": [...], "aliases": {phrase: k},
#     "rels": [[subject, predicate, object], ...]}
#     persistent, saved by store.holy
#    "notes": [...], "topic": k|null, "pending": {...}|null}
#     session-only, never saved
#    "windex"/"nw"/"keyset"/"cooc": derived lookup structures, rebuilt
#     on load, never saved
# rels are relation edges derived from taught fact shapes ("in X",
# "a X"/"an X", "has X", Thai อยู่/คือ/หมายความว่า) plus means-teaches;
# they back the inference queries (is-in/is-a chains, where-is,
# what-does-mean).
# so agent/store.holy can persist the durable part and a future kernel
# port can carry the whole thing as plain data.
#
# Backend parity discipline (same as std.str): all matching is ASCII-only
# and byte-based. Non-ASCII text passes through untouched, so interp and
# every compiled backend agree byte for byte.
_UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
_LOWER = "abcdefghijklmnopqrstuvwxyz"
def _is_ws(c):
  return c == " " or c == "\t" or c == "\n" or c == "\r"
# Collapse every ASCII whitespace run to one space and trim the ends.
def normalize(s):
  out = ""
  ws = false
  i = 0
  while i < len(s):
    c = s[i]
    if _is_ws(c):
      ws = true
    else:
      if ws and len(out) > 0:
        out = out + " "
      out = out + c
      ws = false
    i = i + 1
  return out
# Lowercase ASCII letters only; every other byte is kept as is.
def lower_ascii(s):
  out = ""
  i = 0
  while i < len(s):
    c = s[i]
    j = find(_UPPER, c)
    if j >= 0:
      out = out + _LOWER[j]
    else:
      out = out + c
    i = i + 1
  return out
def new_state():
  # mode is session-only (like notes): strict unless the user explores.
  return {"facts": {}, "order": [], "aliases": {}, "notes": [], "topic": null, "pending": null, "windex": {}, "nw": {}, "keyset": {}, "rels": [], "cooc": {}, "relset": {}, "relby": {}, "forgotten": [], "session": [], "mode": "strict", "hypotheses": [], "hyp_retired": [], "readings": [], "read_src": {}, "read_n": 0, "url_srcs": [], "test_fetch": false}
def _has(state, key):
  # O(1) membership; keyset mirrors order exactly (built from it on
  # load, maintained on teach/forget), including for hand-edited files.
  return key in state["keyset"]
# Split normalized text into words (single-space separated by construction).
def _words(s):
  out = []
  cur = ""
  i = 0
  while i < len(s):
    c = s[i]
    if c == " ":
      if len(cur) > 0:
        append(out, cur)
      cur = ""
    else:
      cur = cur + c
    i = i + 1
  if len(cur) > 0:
    append(out, cur)
  return out
def _in(word, words):
  for w in words:
    if w == word:
      return true
  return false
# A one-byte string is ASCII when it is whitespace or printable ASCII.
def _ascii_byte(c):
  return c == "\t" or c == "\n" or c == "\r" or c >= " " and c <= "~"
# True when the token holds at least one non-ASCII byte (Thai, accents).
def _nonascii(s):
  i = 0
  while i < len(s):
    if not _ascii_byte(s[i]):
      return true
    i = i + 1
  return false
# Non-ASCII tokens (Thai has no spaces or case) also match by substring:
# one side found inside the other counts as a match. Two guards keep it
# honest and byte/char-model independent (interp counts characters, the
# compiled backends count bytes, so no length threshold is ever used):
# ASCII-only pairs stay exact-only ("cat" never matches "catalog"), and
# the needle must be substantial - never empty or a single ASCII letter.
# A single non-ASCII letter counts as substantial: on interp it equals
# its first element while on the byte backends it does not, so the
# _nonascii disjunct is what keeps both models agreeing.
def _sub(w, t):
  if not (_nonascii(w) or _nonascii(t)):
    return false
  if w != t:
    if find(t, w) >= 0 and (w != w[:1] or _nonascii(w)):
      return true
    if find(w, t) >= 0 and (t != t[:1] or _nonascii(t)):
      return true
  return false
def _wmatch(w, t):
  return w == t or _sub(w, t)
# Join fact values: v | v1 and v2 | v1, v2 and v3.
def _join(values):
  n = len(values)
  if n == 1:
    return values[0]
  if n == 2:
    return values[0] + " and " + values[1]
  out = values[0]
  i = 1
  while i < n - 1:
    out = out + ", " + values[i]
    i = i + 1
  return out + " and " + values[n - 1]
# Resolve a asked phrase to a fact key: direct hit wins, then a taught
# paraphrase (one hop, no chains). Returns null when nothing matches.
def _resolve(state, key):
  if _has(state, key):
    return key
  aliases = state["aliases"]
  for a in aliases:
    if a == key:
      target = aliases[a]
      if _has(state, target):
        return target
      return null
  return null
# Usage learning (A10): "cooc" maps every content word appearing in a
# taught fact (key or value) to the other content words of the same
# facts, with counts. Derived, never persisted: rebuilt on load,
# maintained on teach/forget. It is co-occurrence counting, not
# understanding - it can say two words appeared together, never how.
# Content words: non-glue tokens, ASCII of length 3+ or any non-ASCII
# token (the length check is ASCII-only so the char/byte len()
# difference between backends can never diverge on Thai text).
def _cwords(s):
  # One fused pass: lowercase ASCII letters and split on spaces in the
  # same walk (same result as _words(lower_ascii(s)) - lowercasing is a
  # pure per-character map, so fusing cannot change the words). A10
  # profiling showed this extraction, not the pair counting, dominated
  # interp cold loads: two full string rebuilds per call, called once
  # per key and once per fact value.
  out = []
  cur = ""
  i = 0
  while i < len(s):
    c = s[i]
    if c == " ":
      if len(cur) >= 3 or _nonascii(cur):
        if not _stop(cur) and not _in(cur, out):
          append(out, cur)
      cur = ""
    else:
      if c >= "A" and c <= "Z":
        cur = cur + _LOWER[find(_UPPER, c)]
      else:
        cur = cur + c
    i = i + 1
  if len(cur) >= 3 or _nonascii(cur):
    if not _stop(cur) and not _in(cur, out):
      append(out, cur)
  return out
# A11: the context-row lookup is hoisted out of the inner loop -
# counting is the same arithmetic with the same insertion orders, just
# far fewer dict operations per fact. (An index-based while-loop rewrite
# measured SLOWER on the interp than for-in iteration, so the loops
# stay for-in.)
def _cooc_add(state, key, value):
  ws = _cwords(key)
  for w in _cwords(value):
    if not _in(w, ws):
      append(ws, w)
  for w in ws:
    if not (w in state["cooc"]):
      state["cooc"][w] = {}
    ctx = state["cooc"][w]
    for u in ws:
      if u != w:
        if u in ctx:
          ctx[u] = ctx[u] + 1
        else:
          ctx[u] = 1
def _cooc_remove(state, key, value):
  ws = _cwords(key)
  for w in _cwords(value):
    if not _in(w, ws):
      append(ws, w)
  for w in ws:
    if w in state["cooc"]:
      ctx = state["cooc"][w]
      for u in ws:
        if u != w and u in ctx and ctx[u] > 0:
          ctx[u] = ctx[u] - 1
# Session log (A12, session-only, never persisted): the last 10 things
# that happened, oldest first, as [kind, key] with kind taught/asked/
# forgot. Powers 'what did we talk about'.
def _slog(state, kind, key):
  append(state["session"], [kind, key])
  if len(state["session"]) > 10:
    state["session"] = state["session"][len(state["session"]) - 10:]
def _teach(state, key, value):
  state["topic"] = key
  if _has(state, key):
    for v in state["facts"][key]:
      _cooc_remove(state, key, v)
  state["facts"][key] = [value]
  _drop_rels(state, key)
  bare = _learn_rel(state, key, value)
  _cooc_add(state, key, value)
  _slog(state, "taught", key)
  suffix = ""
  if bare:
    suffix = " (filed as a kind-of)"
  if _has(state, key):
    return "updated " + key + " is " + value + suffix
  append(state["order"], key)
  _index_key(state, key)
  return "remembered " + key + " is " + value + suffix
def _teach_also(state, key, value):
  state["topic"] = key
  bare = _learn_rel(state, key, value)
  suffix = ""
  if bare:
    suffix = " (filed as a kind-of)"
  if not _has(state, key):
    state["facts"][key] = [value]
    append(state["order"], key)
    _index_key(state, key)
    _cooc_add(state, key, value)
    _slog(state, "taught", key)
    return "remembered " + key + " is " + value + suffix
  for v in state["facts"][key]:
    if v == value:
      return "i already know that " + key + " is " + value + suffix
  append(state["facts"][key], value)
  _cooc_add(state, key, value)
  _slog(state, "taught", key)
  return "added: " + key + " is " + value + suffix + _isa_contra_warn(state, key, value)
# A13 additive rule: kind-of-shaped values (a/an/bare/negations/เป็น)
# ADD to an existing thing; shaped values (in/has/คือ/หมายความว่า/อยู่)
# keep replace semantics. 'no, X is Y' always replaces.
def _kind_value(v):
  p = lower_ascii(v)
  if p[:3] == "in ":
    return false
  if p[:4] == "has ":
    return false
  if find(v, "คือ ") == 0 or find(v, "หมายความว่า ") == 0 or find(v, "อยู่ ") == 0:
    return false
  return true
# Contradiction warning for verb teaches: flag (never resolve) when
# the same subject already holds the opposite polarity of this edge.
def _contra_warn(state, key, pred, obj, neg):
  opp = "not-" + pred
  if neg:
    opp = pred
  if key in state["relset"]:
    if opp in state["relset"][key]:
      if obj in state["relset"][key][opp]:
        return " (warning: this contradicts what you taught me earlier - i hold both and will say so when asked)"
  return ""
# Same warning for is-a teaches; edge objects keep their article.
def _isa_contra_warn(state, key, value):
  lv = lower_ascii(value)
  obj = lv
  opp = "not-is-a"
  if lv[:4] == "not ":
    obj = lv[4:]
    opp = "is-a"
  if find(lv, "ไม่เป็น ") == 0:
    obj = lv[len("ไม่เป็น "):]
    opp = "is-a"
  if find(lv, "เป็น ") == 0:
    obj = lv[len("เป็น "):]
    opp = "not-is-a"
  if key in state["relset"]:
    if opp in state["relset"][key]:
      if obj in state["relset"][key][opp]:
        return " (warning: this contradicts what you taught me earlier - i hold both and will say so when asked)"
  return ""
# A13: teach a verb relation - additive by design: a verb teach never
# replaces existing kinds or facts (the spec's doctor is both human
# and professional; a human both is a mammal and can learn). The
# spoken value ('needs energy') joins the fact list so recall, list,
# forget and co-occurrence all see it; the typed edge is separate.
def _teach_verb(state, key, pred, obj, neg):
  state["topic"] = key
  newkey = not _has(state, key)
  if newkey:
    state["facts"][key] = []
    append(state["order"], key)
    _index_key(state, key)
  ph = _posphrase(pred)
  if neg:
    ph = _negphrase(pred)
  val = ph + " " + obj
  dup = false
  for v in state["facts"][key]:
    if v == val:
      dup = true
  edgepred = pred
  if neg:
    edgepred = "not-" + pred
  _add_rel(state, key, edgepred, obj)
  if not dup:
    append(state["facts"][key], val)
    _cooc_add(state, key, val)
    _slog(state, "taught", key)
  if dup:
    return "i already know that " + key + " " + val
  reply = "remembered " + key + " " + val
  if not newkey:
    reply = "added: " + key + " " + val
  return reply + _contra_warn(state, key, pred, obj, neg)
# Candidate keys/paraphrases for a miss: every word of the asked phrase
# Word index (derived, never persisted): "windex" maps every taught key
# word to the keys containing it; "nw" is the same map restricted to
# non-ASCII words. Candidate lookup then touches only words, not every
# key: the A5 benchmark measured the full scan at ~0.5 ms/key (interp)
# per miss, which made misses unusable at 10k taught facts.
def _index_key(state, key):
  state["keyset"][key] = true
  for w in _words(key):
    if not (w in state["windex"]):
      state["windex"][w] = []
    if not (key in state["windex"][w]):
      append(state["windex"][w], key)
    if _nonascii(w):
      if not (w in state["nw"]):
        state["nw"][w] = []
      if not (key in state["nw"][w]):
        append(state["nw"][w], key)
def _unindex_key(state, key):
  kept = {}
  for k in state["keyset"]:
    if k != key:
      kept[k] = true
  state["keyset"] = kept
  for w in _words(key):
    if w in state["windex"]:
      kept = []
      for k in state["windex"][w]:
        if k != key:
          append(kept, k)
      state["windex"][w] = kept
    if w in state["nw"]:
      kept = []
      for k in state["nw"][w]:
        if k != key:
          append(kept, k)
      state["nw"][w] = kept
# How strongly a candidate connects to the asked words in counted usage:
# the sum of co-occurrences between the candidate's content words and
# the asked phrase's content words.
def _usage_score(state, cand, awords):
  score = 0
  for w in _cwords(cand):
    if w in state["cooc"]:
      ctx = state["cooc"][w]
      for a in awords:
        if a != w and a in ctx:
          score = score + ctx[a]
  return score
# Usage-based fallback for a clean miss: the words that showed up
# alongside the asked words in taught facts, honestly framed as usage
# correlation, never as knowledge. Top 3 by count, ties in first-seen
# order.
def _usage_reply(state, asked):
  awords = _cwords(asked)
  merged = {}
  morder = []
  for w in awords:
    if w in state["cooc"]:
      for u in state["cooc"][w]:
        c = state["cooc"][w][u]
        if c > 0 and not _in(u, awords):
          if u in merged:
            merged[u] = merged[u] + c
          else:
            merged[u] = c
            append(morder, u)
  if len(morder) == 0:
    return "i do not know " + asked
  i = 0
  while i < len(morder):
    best = i
    j = i + 1
    while j < len(morder):
      if merged[morder[j]] > merged[morder[best]]:
        best = j
      j = j + 1
    if best != i:
      tmp = morder[i]
      morder[i] = morder[best]
      morder[best] = tmp
    i = i + 1
  top = []
  i = 0
  while i < len(morder) and i < 3:
    append(top, morder[i])
    i = i + 1
  return "i was never taught " + asked + ", but from how you used it, " + asked + " seems related to " + _join(top)
# Keys whose words match the asked word w, exactly mirroring _wmatch:
# - exact word hits come straight from the index;
# - a non-ASCII asked word also matches any taught word found inside it
#   (substring enumeration - the _sub needle guard skips single ASCII
#   letters, and byte-vs-char slicing differences are harmless because a
#   mid-character byte slice is never a taught word);
# - the asked word found inside a taught non-ASCII word comes from the
#   small non-ASCII word list (same guard).
def _whits(state, w):
  res = []
  if _nonascii(w):
    i = 0
    while i < len(w):
      j = i + 1
      while j <= len(w):
        s = w[i:j]
        if (s != s[:1] or _nonascii(s)) and s in state["windex"]:
          for k in state["windex"][s]:
            if not (k in res):
              append(res, k)
        j = j + 1
      i = i + 1
  else:
    if w in state["windex"]:
      for k in state["windex"][w]:
        append(res, k)
  if w != w[:1] or _nonascii(w):
    for t in state["nw"]:
      if w != t and find(t, w) >= 0:
        for k in state["nw"][t]:
          if not (k in res):
            append(res, k)
  return res
# Candidate keys/paraphrases for a miss: every word of the asked phrase
# matches some word of the candidate (exact, or Thai-aware substring).
# Deterministic (insertion order). The key side uses _whits (identical
# match condition, no full scan); paraphrases are few and stay a loop.
def _candidates(state, phrase):
  words = _words(phrase)
  cands = []
  keys = []
  if len(words) > 0:
    base = null
    for w in words:
      hits = _whits(state, w)
      if base == null:
        base = {}
        for k in hits:
          base[k] = true
      else:
        nb = {}
        for k in hits:
          if k in base:
            nb[k] = true
        base = nb
    for k in state["order"]:
      if k in base and phrase != k:
        append(cands, k)
        append(keys, k)
    for a in state["aliases"]:
      target = state["aliases"][a]
      if _has(state, target):
        ok = true
        for w in words:
          hit = false
          for aw in _words(a):
            if _wmatch(w, aw):
              hit = true
          if not hit:
            ok = false
        if ok and phrase != a:
          append(cands, a)
          append(keys, target)
  return [cands, keys]
# A13: values that carry their own verb-relation word join WITHOUT
# the generic 'is' ('i know a fish cannot fly', never 'is cannot').
# Plain values keep the established 'is'-joined shape exactly.
def _relvalue(v):
  for p in ["needs ", "can ", "uses ", "produces ", "causes ", "does not ", "cannot "]:
    if v[:len(p)] == p:
      return true
  return false
def _values_glue(values):
  plain = []
  relv = []
  for v in values:
    if _relvalue(v):
      append(relv, v)
    if not _relvalue(v):
      append(plain, v)
  if len(relv) == 0:
    return " is " + _join(values)
  if len(plain) == 0:
    return " " + _join(relv)
  return " is " + _join(plain) + " and " + _join(relv)
def _recall(state, asked):
  key = _resolve(state, asked)
  if key != null:
    state["topic"] = key
    _slog(state, "asked", key)
    return "i know " + key + _values_glue(state["facts"][key])
  both = _candidates(state, asked)
  cands = both[0]
  keys = both[1]
  # Usage-informed ranking: candidates tied to the asked words in
  # counted usage come first; ties keep insertion order. Still a
  # guess, just a usage-informed one.
  if len(cands) > 1:
    awords = _cwords(asked)
    i = 0
    while i < len(cands):
      best = i
      j = i + 1
      while j < len(cands):
        if _usage_score(state, cands[j], awords) > _usage_score(state, cands[best], awords):
          best = j
        j = j + 1
      if best != i:
        tmp = cands[i]
        cands[i] = cands[best]
        cands[best] = tmp
        tmp = keys[i]
        keys[i] = keys[best]
        keys[best] = tmp
      i = i + 1
  if len(cands) > 0 and len(cands) <= 3:
    state["pending"] = {"cands": cands, "keys": keys}
    joined = cands[0]
    i = 1
    while i < len(cands):
      joined = joined + ", " + cands[i]
      i = i + 1
    return "did you mean " + joined + "?"
  if len(cands) > 3:
    return "i do not know " + asked
  return _usage_reply(state, asked)
def _forget(state, key):
  if not _has(state, key):
    return "i do not know " + key
  for v in state["facts"][key]:
    _cooc_remove(state, key, v)
  facts = {}
  for k in state["facts"]:
    if k != key:
      facts[k] = state["facts"][k]
  order = []
  for k in state["order"]:
    if k != key:
      append(order, k)
  # Paraphrases pointing at the forgotten key die with it.
  aliases = {}
  for a in state["aliases"]:
    if state["aliases"][a] != key:
      aliases[a] = state["aliases"][a]
  state["facts"] = facts
  state["order"] = order
  state["aliases"] = aliases
  _unindex_key(state, key)
  _drop_rels(state, key)
  if state["topic"] == key:
    state["topic"] = null
  # A12: forgetting is remembered - a bounded tombstone list (last 20,
  # persisted) powers 'what did you forget'.
  append(state["forgotten"], key)
  if len(state["forgotten"]) > 20:
    state["forgotten"] = state["forgotten"][len(state["forgotten"]) - 20:]
  _slog(state, "forgot", key)
  return "forgot " + key
def _list_reply(state):
  order = state["order"]
  n = len(order)
  if n == 0:
    return "i know nothing yet"
  joined = order[0]
  i = 1
  while i < n:
    joined = joined + ", " + order[i]
    i = i + 1
  if n == 1:
    return "i know 1 thing: " + joined
  # A12: cap the dump - past 50 keys, say how many more instead of
  # listing them all.
  if n > 50:
    cut = order[0]
    i = 1
    while i < 50:
      cut = cut + ", " + order[i]
      i = i + 1
    return "i know " + str(n) + " things: " + cut + ", and " + str(n - 50) + " more"
  return "i know " + str(n) + " things: " + joined
# A12: bounded self-knowledge. Every answer says its own limits.
def _know_reply(state):
  n = len(state["order"])
  if n == 0:
    return "i know nothing yet"
  if n <= 5:
    return _list_reply(state)
  recent = state["order"][n - 5:]
  return "i know " + str(n) + " things; most recently: " + _join(recent)
def _forgotten_reply(state):
  f = state["forgotten"]
  if len(f) == 0:
    return "i have not forgotten anything since i started keeping track"
  return "i forgot " + _join(f) + " (i only keep the last 20)"
def _session_reply(state):
  s = state["session"]
  if len(s) == 0:
    return "nothing has happened yet this session"
  out = ""
  for e in s:
    if e[0] == "asked":
      out = out + "; asked about " + e[1]
    else:
      out = out + "; " + e[0] + " " + e[1]
  return "this session: " + out[2:]
# Glue words that must not create associations on their own. A11: the
# length guard comes first (every glue word is at most 4 letters) so
# long content words skip the string compares.
def _stop(w):
  if len(w) > 4:
    return false
  return w == "the" or w == "and" or w == "for" or w == "are" or w == "with" or w == "that" or w == "this"
def _value_words(state, key):
  out = []
  for v in state["facts"][key]:
    for w in _words(lower_ascii(v)):
      if not _in(w, out):
        append(out, w)
  return out
# Recall plus association: facts whose values share a content word
# (ASCII-lowercased, length >= 3, not a glue word) with this one's values.
def _about_reply(state, asked):
  key = _resolve(state, asked)
  if key == null:
    return "i do not know " + asked
  state["topic"] = key
  reply = "i know " + key + " is " + _join(state["facts"][key])
  words = _value_words(state, key)
  for k in state["order"]:
    if k != key:
      kwords = _value_words(state, k)
      shared = false
      for w in words:
        if len(w) >= 3 and not _stop(w):
          for kw in kwords:
            if _wmatch(w, kw):
              shared = true
      if shared:
        reply = reply + "; also " + k + " is " + _join(state["facts"][k])
  return reply
def _notes_reply(state):
  notes = state["notes"]
  n = len(notes)
  if n == 0:
    return "no notes yet"
  reply = "note 1: " + notes[0]
  i = 1
  while i < n:
    reply = reply + "; note " + str(i + 1) + ": " + notes[i]
    i = i + 1
  return reply
# A pending clarification is answered by yes (one candidate), by naming
# one of the candidates, or by no. Any other line drops it and is
# processed normally. Returns [handled, reply].
def _pending_reply(state, m):
  p = state["pending"]
  if m == "yes":
    if len(p["cands"]) == 1:
      state["pending"] = null
      return [true, _recall(state, p["cands"][0])]
    return [true, "please say which one"]
  if m == "no":
    state["pending"] = null
    return [true, "ok"]
  i = 0
  while i < len(p["cands"]):
    if p["cands"][i] == m:
      state["pending"] = null
      return [true, _recall(state, p["cands"][i])]
    i = i + 1
  state["pending"] = null
  return [false, ""]
# An open question (how/why/when/about) gets the taught facts read back
# with honest framing - it never pretends to answer the how or why.
# Relations: structured edges [subject, predicate, object] derived from
# the SHAPES of taught values (remember paris is in france -> is-in
# edge) plus has/อยู่/คือ/หมายความว่า forms. Predicates: is-in, is-a,
# has, means. Only is-in and is-a chain transitively; articles on
# is-a objects are kept for display and stripped for node matching.
# Relation edges are indexed two ways (derived, never persisted):
# "relset" nests subject -> predicate -> object for O(1) dedup, and
# "relby" maps predicate -> article-stripped subject -> edge list (in
# insertion order) so chains never scan the whole edge list. Both are
# rebuilt on load and maintained on teach/forget.
def _rel_index(state, s, p, o):
  if not (s in state["relset"]):
    state["relset"][s] = {}
  if not (p in state["relset"][s]):
    state["relset"][s][p] = {}
  state["relset"][s][p][o] = true
  if not (p in state["relby"]):
    state["relby"][p] = {}
  ns = _stripart(s)
  if not (ns in state["relby"][p]):
    state["relby"][p][ns] = []
  append(state["relby"][p][ns], [s, o])
# A15: bounded hypothesis learning. Explore-mode assumptions become
# named, inspectable candidates - the missing knowledge the engine
# leans on - exposed so the user can resolve it. A candidate is NEVER
# a fact: nothing reads this list for inference, guards, recall,
# contradictions or suggestions, and strict mode records nothing.
# Hard stop at 20 with no auto-eviction (age or count cannot prove an
# unresolved assumption safe to destroy); 'forget hypothesis ...' or
# 'clear hypotheses' frees space. Session-only, like notes and mode.
_HYP_CAP = 20
_HYP_PROV_CAP = 10
def _hyp_find(state, subj, domain):
  i = 0
  while i < len(state["hypotheses"]):
    if state["hypotheses"][i][0] == subj and state["hypotheses"][i][1] == domain:
      return i
    i = i + 1
  return -1
# Record one derivation's assumptions: at most one count per
# (subject, domain) per derivation, even when the same assumption is
# used at several steps. Returns true when every candidate was
# recorded; false means the list is full and some were rejected.
def _hyp_record(state, q, assum):
  order = []
  by = {}
  for a in assum:
    mk = a[0] + "|" + a[1]
    if mk in by:
      by[mk][2] = by[mk][2] + ", " + a[3]
      by[mk][3] = by[mk][3] + ", " + str(a[2])
    else:
      by[mk] = [a[0], a[1], a[3], str(a[2])]
      append(order, mk)
  ok = true
  for mk in order:
    c = by[mk]
    ev = [q, c[2], c[3]]
    i = _hyp_find(state, c[0], c[1])
    if i >= 0:
      h = state["hypotheses"][i]
      h[2] = h[2] + 1
      if len(h[4]) < _HYP_PROV_CAP:
        append(h[4], ev)
      else:
        h[5] = h[5] + 1
    else:
      if len(state["hypotheses"]) >= _HYP_CAP:
        ok = false
      else:
        append(state["hypotheses"], [c[0], c[1], 1, ev, [], 0])
  return ok
def _hyp_retire(state, s, domain, reason):
  i = _hyp_find(state, s, domain)
  if i >= 0:
    h = state["hypotheses"][i]
    append(state["hyp_retired"], [h[0], h[1], reason])
    if len(state["hyp_retired"]) > 10:
      state["hyp_retired"] = state["hyp_retired"][len(state["hyp_retired"]) - 10:]
    state["hypotheses"] = state["hypotheses"][:i] + state["hypotheses"][i + 1:]
def _hyp_q(x, pred, y):
  if pred == "can":
    return "can " + x + " " + y
  # 'does X use energy' - the verb base form drops the trailing s.
  return "does " + x + " " + pred[:len(pred) - 1] + " " + y
# A16: the reader - an EVIDENCE-INGESTION subsystem, not inference
# and not automatic learning. "read <text>" extracts typed claims
# from whole-sentence surface patterns into read candidates: each
# carries verbatim provenance (source id, original sentence, matched
# pattern) and positive/negative support tracked separately. A
# candidate is NEVER a fact: nothing reads this store for inference,
# guards, recall, suggestions or A15 hypotheses, and only explicit
# user teaching marks a claim USER_CONFIRMED or USER_DISPUTED -
# corroboration is metadata, never promotion. Cap 100 distinct
# claims, no auto-eviction; updates to existing records are always
# allowed, new ones refused and reported. Session-only.
_READ_CAP = 100
def _read_find(state, s, p, o):
  i = 0
  while i < len(state["readings"]):
    r = state["readings"][i]
    if r[0] == s and r[1] == p and r[2] == o:
      return i
    i = i + 1
  return -1
# A17: primary skip-reason classification, mutually exclusive, one
# count per segment, precedence quoted/attributed > modal/hedged >
# multi-clause. The modal class is MODAL_HEDGED_UNSUPPORTED: hedging
# words are skipped whole, while the supported 'can' forms keep
# extracting. Skips are counted and reported, never guessed around.
def _read_skip(sent):
  if find(sent, "\"") >= 0 or find(sent, "'") >= 0:
    return "quoted"
  ls = " " + lower_ascii(sent) + " "
  if find(ls, " says ") >= 0 or find(ls, " said ") >= 0 or find(ls, " according to ") >= 0:
    return "quoted"
  for w in [" might ", " may ", " could ", " should ", " would ", " must ", " probably ", " maybe ", " perhaps "]:
    if find(ls, w) >= 0:
      return "modal-hedged"
  if find(sent, ",") >= 0 or find(sent, ";") >= 0:
    return "multi-clause"
  return ""
# Personal-pronoun (and 'there') subjects need anaphora resolution,
# which A17 does not do: no extraction, counted as unmatched.
def _read_pron(subj):
  for w in ["i", "you", "he", "she", "it", "we", "they", "there"]:
    if subj == w:
      return true
  return false
# Extract one typed claim from a whole segment, or null. A pattern
# must consume the ENTIRE segment: subject is everything before the
# marker, object everything after; a second clause marker inside the
# object rejects the match. Canonical forms mirror the teach routes
# exactly, so user teaching matches read candidates. 'can produce'
# stays distinct from 'produces'; negation scope is preserved as
# polarity on the record, never dropped.
def _read_extract0(sent):
  ls = lower_ascii(sent)
  k = find(sent, " ไม่เป็น ")
  if k > 0 and k + len(" ไม่เป็น ") < len(sent):
    return [sent[:k], "is-a", sent[k + len(" ไม่เป็น "):], "neg", "thai-not-is-a"]
  k = find(sent, " เป็น ")
  if k > 0 and k + len(" เป็น ") < len(sent):
    return [sent[:k], "is-a", sent[k + len(" เป็น "):], "pos", "thai-is-a"]
  k = find(sent, " อยู่ ")
  if k > 0 and k + len(" อยู่ ") < len(sent):
    return [sent[:k], "is-in", sent[k + len(" อยู่ "):], "pos", "thai-is-in"]
  k = find(sent, " คือ ")
  if k > 0 and k + len(" คือ ") < len(sent):
    return [sent[:k], "means", sent[k + len(" คือ "):], "pos", "thai-means"]
  k = find(ls, " is not a ")
  if k > 0 and k + 11 < len(ls):
    return [ls[:k], "is-a", ls[k + 8:], "neg", "not-is-a"]
  k = find(ls, " is not an ")
  if k > 0 and k + 12 < len(ls):
    return [ls[:k], "is-a", ls[k + 8:], "neg", "not-is-a"]
  # objects keep their leading article, matching taught relations
  k = find(ls, " is in ")
  if k > 0 and k + 7 < len(ls):
    return [ls[:k], "is-in", ls[k + 7:], "pos", "is-in"]
  k = find(ls, " is a ")
  if k > 0 and k + 6 < len(ls):
    return [ls[:k], "is-a", ls[k + 4:], "pos", "is-a"]
  k = find(ls, " is an ")
  if k > 0 and k + 7 < len(ls):
    return [ls[:k], "is-a", ls[k + 4:], "pos", "is-a"]
  k = find(ls, " is ")
  if k > 0 and k + 4 < len(ls):
    return [ls[:k], "is-a", ls[k + 4:], "pos", "is-a-bare"]
  k = find(ls, " has ")
  if k > 0 and k + 6 < len(ls):
    return [ls[:k], "has", ls[k + 5:], "pos", "has"]
  # A17: plural forms, distinct registered pattern ids, same
  # teachable predicates. Negatives before positives.
  k = find(ls, " do not have ")
  if k > 0 and k + 13 < len(ls):
    return [ls[:k], "has", ls[k + 13:], "neg", "not-have"]
  k = find(ls, " does not have ")
  if k > 0 and k + 15 < len(ls):
    return [ls[:k], "has", ls[k + 15:], "neg", "not-have"]
  k = find(ls, " are not ")
  if k > 0 and k + 9 < len(ls):
    return [ls[:k], "is-a", ls[k + 9:], "neg", "not-are"]
  k = find(ls, " are ")
  if k > 0 and k + 5 < len(ls):
    return [ls[:k], "is-a", ls[k + 5:], "pos", "are"]
  k = find(ls, " have ")
  if k > 0 and k + 6 < len(ls):
    return [ls[:k], "has", ls[k + 6:], "pos", "have"]
  for vt in _VERBT:
    k = find(ls, vt[0])
    if k > 0 and k + len(vt[0]) < len(ls):
      pol = "pos"
      if vt[2]:
        pol = "neg"
      return [ls[:k], vt[1], ls[k + len(vt[0]):], pol, vt[1]]
  return null
# Reject an extraction whose object contains another clause's
# relation marker ('a car is a machine and a motorcycle is not').
def _read_extract(sent):
  ex = _read_extract0(sent)
  if ex != null and _read_pron(ex[0]):
    return null
  return ex
def _read_obj_ok(ex):
  if find(ex[2], " is ") >= 0 or find(ex[2], " and ") >= 0:
    return false
  return true
# A18 URL policy (EXPERIMENTAL preview). Validation and conservative
# normalization are pure string work: scheme http only, no embedded
# credentials, host charset [a-z0-9.-], no CR/LF, fragment stripped,
# path/query preserved verbatim, default port 80 stripped, literal
# private/reserved IPv4 rejected outside the test harness. The test
# harness exception is the HS_AGENT_TEST_FETCH=1 environment flag,
# which ordinary commands cannot reach.
# Test-harness detection is a state flag: the IR-subset routes have
# no env/argv/exists builtins, so the core cannot probe the
# environment. agent/repl.holy sets the flag at startup from the
# HS_AGENT_TEST_FETCH=1 environment variable; ordinary commands
# cannot reach it, and the corpus driver never sets it.
def _url_test_mode(state):
  return state["test_fetch"]
def _url_bad_host(host):
  if len(host) == 0 or find(host, "..") >= 0:
    return true
  i = 0
  while i < len(host):
    ch = host[i]
    if not (ch >= "a" and ch <= "z" or ch >= "0" and ch <= "9" or ch == "." or ch == "-"):
      return true
    i = i + 1
  return false
# Literal dotted-quad private/reserved check (agent-side defense in
# depth; DNS-resolved privacy is the runtime guard's job - see
# docs/gap-report-private-network-guard.md).
def _url_priv4(host):
  parts = split(host, ".")
  if len(parts) != 4:
    return false
  nums = []
  for p in parts:
    if len(p) == 0 or len(p) > 3:
      return false
    i = 0
    while i < len(p):
      if not (p[i] >= "0" and p[i] <= "9"):
        return false
      i = i + 1
    append(nums, int(p))
  a = nums[0]
  b = nums[1]
  if a == 10 or a == 127 or a == 0 or a >= 224:
    return true
  if a == 169 and b == 254:
    return true
  if a == 192 and b == 168:
    return true
  if a == 172 and b >= 16 and b <= 31:
    return true
  return false
# Returns [true, normalized] or [false, reason].
def _url_norm(url, test_mode):
  if find(url, "\r") >= 0 or find(url, "\n") >= 0:
    return [false, "bad url (control characters)"]
  if len(url) < 8 or lower_ascii(url[:7]) != "http://":
    return [false, "only http:// urls are supported"]
  rest = url[7:]
  h = find(rest, "#")
  if h >= 0:
    rest = rest[:h]
  p = find(rest, "/")
  authority = rest
  path = "/"
  if p >= 0:
    authority = rest[:p]
    path = rest[p:]
  if find(authority, "@") >= 0:
    return [false, "embedded credentials are not allowed"]
  host = authority
  port = 80
  hasport = false
  c = find(authority, ":")
  if c >= 0:
    host = authority[:c]
    ps = authority[c + 1:]
    if len(ps) == 0 or len(ps) > 5:
      return [false, "bad port"]
    i = 0
    while i < len(ps):
      if not (ps[i] >= "0" and ps[i] <= "9"):
        return [false, "bad port"]
      i = i + 1
    port = int(ps)
    if port < 1 or port > 65535:
      return [false, "bad port"]
    hasport = true
  host = lower_ascii(host)
  if _url_bad_host(host):
    return [false, "bad host"]
  if not test_mode:
    if port != 80:
      return [false, "only port 80 is supported"]
    if _url_priv4(host):
      return [false, "private or reserved addresses are not allowed"]
  norm = "http://" + host
  if hasport and port != 80:
    norm = norm + ":" + str(port)
  return [true, norm + path]
# Source-identity registry: the normalized URL is the identity, so a
# repeated read of the same page reuses its url-N id and can never
# count as independent corroboration. Session-only, cleared with
# 'clear readings', capped at 100 distinct identities.
def _url_src(state, norm):
  i = 0
  for e in state["url_srcs"]:
    if e[0] == norm:
      return "url-" + str(i + 1)
    i = i + 1
  if len(state["url_srcs"]) >= 100:
    return ""
  append(state["url_srcs"], [norm, 0])
  return "url-" + str(len(state["url_srcs"]))
# Query strings can carry tokens: display redacts them while the
# registry keeps the full normalized URL for local provenance.
def _url_disp(norm):
  q = find(norm, "?")
  if q >= 0:
    return norm[:q] + "?(redacted)"
  return norm
def _read_url(state, raw):
  # Validation lives here so every rejection is corpus-deterministic;
  # the actual fetch needs tcp builtins the IR/x64 subset routes
  # cannot compile, so valid URLs are handled by the repl shell via
  # agent/fetch.holy (EXPERIMENTAL preview).
  r = _url_norm(raw, _url_test_mode(state))
  if not r[0]:
    return "read url: " + r[1]
  return "read url: url reading is only available in the repl shell (experimental)"
# Ingest one read payload: split into segments, extract whole-
# segment claims, record with provenance. The payload is DATA: it is
# never re-parsed as commands (an embedded 'clear readings' or
# 'mode explore' is just text), and the input line is the unambiguous
# end of the payload - one line per read. Counts are reported
# honestly: segments in, pattern matches, candidates extracted with
# new/updated/refused/repeat, unmatched segments.
def _read_text(state, rest):
  src = ""
  body = rest
  k = find(rest, ": ")
  if k > 0 and k <= 20:
    nm = rest[:k]
    ok = true
    i = 0
    while i < len(nm):
      ch = nm[i]
      if not (ch >= "a" and ch <= "z" or ch >= "0" and ch <= "9" or ch == "-" or ch == "_"):
        ok = false
      i = i + 1
    if ok:
      src = nm
      body = rest[k + 2:]
  if src == "":
    state["read_n"] = state["read_n"] + 1
    src = "read-" + str(state["read_n"])
  return _read_ingest(state, src, body, false)
# Shared ingestion path for typed reads and (A18) fetched pages. The
# 64KB cap for fetched text is applied by agent/fetch.holy BEFORE
# this point (byte ops cannot live in the core: the self-interpreter
# route rejects byte_len at load); the truncated flag only controls
# the reply note.
def _read_ingest(state, src, body, truncated):
  state["read_src"][src] = body
  segs = []
  cur = ""
  i = 0
  while i < len(body):
    ch = body[i]
    if (ch == "." or ch == "!" or ch == "?") and (i + 1 >= len(body) or body[i + 1] == " "):
      if len(cur) > 0:
        append(segs, cur)
      cur = ""
      if i + 1 < len(body):
        i = i + 1
    else:
      cur = cur + ch
    i = i + 1
  if len(cur) > 0:
    append(segs, cur)
  matched = 0
  newc = 0
  upd = 0
  ref = 0
  dup = 0
  sk_q = 0
  sk_m = 0
  sk_c = 0
  um = 0
  for sent in segs:
    sk = _read_skip(sent)
    if sk == "quoted":
      sk_q = sk_q + 1
    elif sk == "modal-hedged":
      sk_m = sk_m + 1
    else:
      exs = []
      if sk == "":
        ka = find(lower_ascii(sent), " and ")
        if ka > 0:
          # A17 conjunction: split at the FIRST exact ' and ' (never
          # inside quotes: the quoted skip already ran), each side
          # must match a complete registered pattern, strictly
          # atomic, no recursion. Spans are the side texts.
          exl = _read_extract(sent[:ka])
          exr = _read_extract(sent[ka + 5:])
          if exl != null and exr != null and _read_obj_ok(exl) and _read_obj_ok(exr):
            append(exs, [exl, sent[:ka]])
            append(exs, [exr, sent[ka + 5:]])
          else:
            sk = "multi-clause"
        else:
          ex = _read_extract(sent)
          if ex != null and _read_obj_ok(ex):
            append(exs, [ex, sent])
          else:
            um = um + 1
      if sk == "multi-clause":
        sk_c = sk_c + 1
      for pair in exs:
        ex = pair[0]
        span = pair[1]
        matched = matched + 1
        ri2 = _read_find(state, ex[0], ex[1], ex[2])
        if ri2 >= 0:
          r = state["readings"][ri2]
          side = r[3]
          if ex[3] == "neg":
            side = r[4]
          seen = false
          for se in side:
            if se[0] == src:
              seen = true
          if seen:
            dup = dup + 1
          else:
            append(side, [src, span, ex[4]])
            upd = upd + 1
        else:
          if len(state["readings"]) >= _READ_CAP:
            ref = ref + 1
          else:
            entry = [src, span, ex[4]]
            if ex[3] == "neg":
              append(state["readings"], [ex[0], ex[1], ex[2], [], [entry], "", ""])
            else:
              append(state["readings"], [ex[0], ex[1], ex[2], [entry], [], "", ""])
            newc = newc + 1
  out = src + ": " + str(len(segs)) + " segments in, " + str(matched) + " pattern matches, " + str(matched) + " candidates extracted (" + str(newc) + " new, " + str(upd) + " updated, " + str(ref) + " refused, " + str(dup) + " repeat), " + str(sk_q + sk_m + sk_c) + " skipped (" + str(sk_q) + " quoted, " + str(sk_m) + " modal-hedged, " + str(sk_c) + " multi-clause), " + str(um) + " unmatched"
  if truncated:
    out = out + " (text truncated at 64KB)"
  return out
def _read_ids(side):
  out = ""
  for se in side:
    if out == "":
      out = se[0]
    else:
      out = out + ", " + se[0]
  return out
def _readings_reply(state, about, detail):
  rs = state["readings"]
  if about != "":
    kept = []
    for r in rs:
      if r[0] == about:
        append(kept, r)
    rs = kept
  if len(rs) == 0:
    if about == "":
      return "no readings"
    return "no readings about " + about
  out = str(len(rs)) + " read candidate"
  if len(rs) > 1:
    out = out + "s"
  if about != "":
    out = out + " about " + about
  out = out + " (unverified readings, not facts):"
  labels = "abcdefghijklmnopqrstuvwxyz"
  i = 0
  while i < len(rs):
    r = rs[i]
    if i < 26:
      out = out + "\n(" + labels[i] + ") "
    else:
      out = out + "\n(" + str(i + 1) + ") "
    out = out + r[0] + " | " + r[1] + " | " + r[2] + " - "
    parts = ""
    if len(r[3]) > 0:
      parts = "positive support: " + str(len(r[3])) + " source"
      if len(r[3]) > 1:
        parts = parts + "s"
      parts = parts + " (" + _read_ids(r[3]) + ")"
      if r[5] == "confirmed":
        parts = parts + " [USER_CONFIRMED]"
      if r[5] == "disputed":
        parts = parts + " [USER_DISPUTED]"
    if len(r[4]) > 0:
      if parts != "":
        parts = parts + "; "
      parts = parts + "negative support: " + str(len(r[4])) + " source"
      if len(r[4]) > 1:
        parts = parts + "s"
      parts = parts + " (" + _read_ids(r[4]) + ")"
      if r[6] == "confirmed":
        parts = parts + " [USER_CONFIRMED]"
      if r[6] == "disputed":
        parts = parts + " [USER_DISPUTED]"
    out = out + parts
    if len(r[3]) > 0 and len(r[4]) > 0:
      internal = false
      for se in r[3]:
        for se2 in r[4]:
          if se[0] == se2[0]:
            internal = true
      if internal:
        out = out + "; SOURCE-INTERNAL CONFLICT"
      else:
        out = out + "; CONFLICT"
    tier = ""
    if len(r[3]) >= 2:
      tier = "MULTI_SOURCE positive"
    if len(r[4]) >= 2:
      if tier != "":
        tier = tier + ", "
      tier = tier + "MULTI_SOURCE negative"
    if tier != "":
      out = out + "; " + tier
    if r[5] == "" and r[6] == "" and tier == "" and not (len(r[3]) > 0 and len(r[4]) > 0):
      out = out + "; UNVERIFIED"
    ids = []
    for se in r[3]:
      if not (se[0] in ids):
        append(ids, se[0])
    for se in r[4]:
      if not (se[0] in ids):
        append(ids, se[0])
    if len(ids) >= 2:
      out = out + "; independence UNVERIFIED"
    if detail:
      for se in r[3]:
        out = out + "\n  " + se[0] + " (positive): \"" + se[1] + "\" [pattern " + se[2] + "]"
      for se in r[4]:
        out = out + "\n  " + se[0] + " (negative): \"" + se[1] + "\" [pattern " + se[2] + "]"
    i = i + 1
  if detail and len(state["url_srcs"]) > 0:
    i = 0
    while i < len(state["url_srcs"]):
      e = state["url_srcs"][i]
      out = out + "\nurl-" + str(i + 1) + " = " + _url_disp(e[0]) + " (fetched " + str(e[1]) + " times)"
      i = i + 1
  return out
def _add_rel(state, s, p, o):
  if s in state["relset"]:
    if p in state["relset"][s]:
      if o in state["relset"][s][p]:
        return
  append(state["rels"], [s, p, o])
  _rel_index(state, s, p, o)
  # A16: user teaching is the ultimate verifier. Alignment is
  # tracked PER POLARITY (r[5] = positive side, r[6] = negative
  # side), separate from evidence status: the taught side is marked
  # CONFIRMED, recorded support on the other side is marked
  # DISPUTED, and any CONFLICT label stays. Teaching never promotes
  # anything into or out of the readings store.
  rp = p
  rpol = "pos"
  if len(p) > 4 and p[:4] == "not-":
    rp = p[4:]
    rpol = "neg"
  ri = _read_find(state, s, rp, o)
  if ri >= 0:
    r = state["readings"][ri]
    if rpol == "pos":
      if len(r[3]) > 0:
        r[5] = "confirmed"
      if len(r[4]) > 0:
        r[6] = "disputed"
    else:
      if len(r[4]) > 0:
        r[6] = "confirmed"
      if len(r[3]) > 0:
        r[5] = "disputed"
  # A15: a taught domain verdict retires a matching hypothesis
  # (positive AND negative both retire; a taught conflict stays in
  # the edges, never resolved).
  if p == "is-a" or p == "not-is-a":
    d = o
    if d[:2] == "a ":
      d = d[2:]
    else:
      if d[:3] == "an ":
        d = d[3:]
      else:
        if d[:4] == "the ":
          d = d[4:]
    if p == "is-a":
      _hyp_retire(state, s, d, "taught positive")
    else:
      _hyp_retire(state, s, d, "taught negative")
def _drop_rels(state, key):
  kept = []
  for e in state["rels"]:
    if e[0] != key:
      append(kept, e)
  state["rels"] = kept
  if key in state["relset"]:
    state["relset"][key] = {}
  ns = _stripart(key)
  for p in state["relby"]:
    if ns in state["relby"][p]:
      state["relby"][p][ns] = []
def _stripart(s):
  if s[:3] == "an ":
    return s[3:]
  if s[:2] == "a ":
    return s[2:]
  return s
def _learn_rel(state, key, value):
  # A11: only the 4-character prefix is lowered up front; the full
  # per-character lowering pass runs only when an ASCII shape actually
  # matches (rare), instead of for every taught value on every load.
  # (An earlier _nonascii guard here measured SLOWER on the interp:
  # its per-character calls cost more than the Thai find()s they
  # skipped. lower_ascii leaves non-ASCII characters untouched and
  # preserves length in both the char and byte model, so running the
  # Thai find()s on the raw value matches exactly what they matched on
  # the lowered one.)
  p = lower_ascii(value[:4])
  got = false
  if p[:3] == "in " and len(value) > 3:
    _add_rel(state, key, "is-in", lower_ascii(value)[3:])
    got = true
  if p[:2] == "a " and len(value) > 2 or p[:3] == "an " and len(value) > 3:
    _add_rel(state, key, "is-a", lower_ascii(value))
    got = true
  if p == "has " and len(value) > 4:
    _add_rel(state, key, "has", lower_ascii(value)[4:])
    got = true
  # A17: plural value shapes, matching the reader's plural patterns.
  if lower_ascii(value[:8]) == "are not " and len(value) > 8:
    _add_rel(state, key, "not-is-a", lower_ascii(value)[8:])
    return false
  if p == "are " and len(value) > 4:
    _add_rel(state, key, "is-a", lower_ascii(value)[4:])
    got = true
  if lower_ascii(value[:5]) == "have " and len(value) > 5:
    _add_rel(state, key, "has", lower_ascii(value)[5:])
    got = true
  p1 = "อยู่ "
  if find(value, p1) == 0 and len(value) > len(p1):
    _add_rel(state, key, "is-in", value[len(p1):])
    got = true
  p2 = "คือ "
  if find(value, p2) == 0 and len(value) > len(p2):
    _add_rel(state, key, "means", value[len(p2):])
    got = true
  p3 = "หมายความว่า "
  if find(value, p3) == 0 and len(value) > len(p3):
    _add_rel(state, key, "means", value[len(p3):])
    got = true
  p4 = "เป็น "
  if find(value, p4) == 0 and len(value) > len(p4):
    _add_rel(state, key, "is-a", value[len(p4):])
    got = true
  p5 = "not a "
  if lower_ascii(value[:6]) == p5 and len(value) > 6:
    _add_rel(state, key, "not-is-a", lower_ascii(value)[4:])
    return false
  if lower_ascii(value[:7]) == "not an " and len(value) > 7:
    _add_rel(state, key, "not-is-a", lower_ascii(value)[4:])
    return false
  if lower_ascii(value[:4]) == "not " and len(value) > 4:
    _add_rel(state, key, "not-is-a", lower_ascii(value)[4:])
    return false
  p6 = "ไม่เป็น "
  if find(value, p6) == 0 and len(value) > len(p6):
    _add_rel(state, key, "not-is-a", value[len(p6):])
    return false
  # A12: a value matching NO recognized shape still taught something -
  # 'X is Y' reads as a kind-of. Derive the bare is-a edge and let the
  # teach reply say so. This is deliberately shallow: 'sky is blue'
  # files blue as a kind of sky.
  if not got:
    _add_rel(state, key, "is-a", lower_ascii(value))
    return true
  return false
# Built-in self-knowledge: hard-coded definitions of the agent's own
# relation words (documented as hard-coded, never learned). Queried by
# 'what does X mean' alongside taught means-edges; never persisted.
# A13: verb relations (needs/can/uses/produces/causes) on the same
# triple store. Fixed surface-form tables, NOT morphology: every form
# the agent understands is listed here.
_RELNEG = [["needs", "does not need"], ["can", "cannot"], ["uses", "does not use"], ["produces", "does not produce"], ["causes", "does not cause"], ["has", "does not have"], ["is-a", "is not"]]
# Teach markers inside 'remember ...' as [marker, relation, negated].
# Negatives come first: ' can not ' contains ' can '.
_VERBT = [[" does not need ", "needs", true], [" do not need ", "needs", true], [" cannot ", "can", true], [" can not ", "can", true], [" does not use ", "uses", true], [" do not use ", "uses", true], [" does not produce ", "produces", true], [" do not produce ", "produces", true], [" does not cause ", "causes", true], [" do not cause ", "causes", true], [" needs ", "needs", false], [" need ", "needs", false], [" can ", "can", false], [" uses ", "uses", false], [" use ", "uses", false], [" produces ", "produces", false], [" produce ", "produces", false], [" causes ", "causes", false], [" cause ", "causes", false]]
# Question markers inside 'does X ...' / 'do X ...' as [marker, relation].
_VERBQ = [[" need ", "needs"], [" needs ", "needs"], [" use ", "uses"], [" uses ", "uses"], [" produce ", "produces"], [" produces ", "produces"], [" cause ", "causes"], [" causes ", "causes"], [" have ", "has"], [" has ", "has"]]
# Passive question markers 'is O <verbed> by S' as [marker, relation].
_VERBP = [[" needed by ", "needs"], [" used by ", "uses"], [" produced by ", "produces"], [" caused by ", "causes"]]
# A14: compositional inference rules - a fixed, inspectable table,
# NOT hidden logic. Each rule is [first premise relation, second
# premise relation, conclusion relation, display name, domain]:
# rel(X,Y) + rel(Y,Z) => rel(X,Z). Only the rules listed here fire;
# there is no invented inference. The can-stays-can axiom: every rule
# with a 'can' premise concludes 'can' - capability never becomes a
# doing or a having-done fact (no such relation exists). 'has' is
# never a conclusion (non-transitive by design) and 'needs'/'causes'
# appear in no rule at all.
# A14.1: every rule DECLARES its domain - the kind its conclusion's
# subject must belong to for the rule to apply (ownership is not
# participation; a part's capability is not the whole's). The middle
# object is never required to be in the domain; each nested step
# checks its own subject against its own rule's domain. The guard is
# an inference CONDITION, not a truth claim: membership says the rule
# may apply here, not that the composition is sound. All five current
# rules declare the machine domain - the domain they were validated
# in. Membership is checked through the ordinary is-a engine, so
# subclass membership satisfies it. In strict mode (the default) an
# unverified domain blocks the rule; in explore mode the rule fires
# conditionally and the conclusion carries the assumption - an
# assumption is never silently upgraded to fact. Negative or
# CONFLICTING domain evidence blocks in both modes (conflicts are
# reported, never resolved arbitrarily). A failed guard means only
# that this rule cannot apply; it never proves the relation false.
_RULES = [["has", "uses", "uses", "has+uses", "machine"], ["has", "can", "can", "has+can", "machine"], ["uses", "can", "can", "uses+can", "machine"], ["has", "produces", "produces", "has+produces", "machine"], ["uses", "produces", "produces", "uses+produces", "machine"]]
_RULECAP = 6
def _negphrase(pred):
  for r in _RELNEG:
    if r[0] == pred:
      return r[1]
  return "not " + pred
def _posphrase(pred):
  if pred == "is-a":
    return "is"
  return pred
_BUILTIN_RELS = [["mean", "means", "the definitional relation: X mean Y says the definition of X is Y"], ["is-in", "means", "the containment relation: X is in Y says X is inside Y"], ["is-a", "means", "the kind relation: X is a Y says X is a kind of Y"], ["has", "means", "the part relation: X has Y says Y is part of X"]]
# Transitive chain over one predicate: BFS in edge-insertion order,
# visited set against cycles, depth cap 8. Node identity strips a/an.
# Returns the path as [[subject, object], ...] or null.
# A teach reply for a relation sub-pattern reads with the relation word,
# not the generic 'is': 'remembered cat has whiskers', never
# 'remembered cat is has whiskers'.
def _unteach_is(reply, word):
  p = find(reply, " is " + word + " ")
  if p < 0:
    return reply
  return reply[:p] + " " + word + reply[p + 4 + len(word):]
def _chain(state, start, pred, goal):
  g = _stripart(goal)
  visited = {}
  queue = [[_stripart(start), []]]
  qi = 0
  while qi < len(queue):
    item = queue[qi]
    qi = qi + 1
    node = item[0]
    path = item[1]
    if node == g and len(path) > 0:
      return path
    if len(path) < 8 and not (node in visited):
      visited[node] = true
      if pred in state["relby"]:
        if node in state["relby"][pred]:
          for e in state["relby"][pred][node]:
            np = []
            for pe in path:
              append(np, pe)
            append(np, e)
            append(queue, [_stripart(e[1]), np])
  return null
# The is-in chain outward from X, cycle-safe: [[subject, object], ...].
def _where_chain(state, start):
  node = _stripart(start)
  path = []
  visited = {}
  found = true
  while not (node in visited) and len(path) < 8 and found:
    visited[node] = true
    found = false
    if "is-in" in state["relby"]:
      if node in state["relby"]["is-in"]:
        for e in state["relby"]["is-in"][node]:
          if not found:
            found = true
            append(path, e)
            node = _stripart(e[1])
  return path
def _chain_fmt(path, pred):
  out = "yes:"
  for e in path:
    if pred == "is-in":
      out = out + " " + e[0] + " is in " + e[1] + ","
    if pred == "is-a":
      out = out + " " + e[0] + " is " + e[1] + ","
  return out[:len(out) - 1]
def _chain_reply(state, x, pred, y):
  path = _chain(state, x, pred, y)
  if path == null:
    return "not that i know"
  return _chain_fmt(path, pred)
# A13 inheritance engine: walk the is-a chain UP from the subject,
# level by level (a direct edge is distance 0), looking for positive
# or negative evidence for (node, pred, goal). The nearest level wins;
# both polarities at the same level are a contradiction that is
# REPORTED, never silently resolved. Returns [verdict, path, edge,
# altpath, altedge] with verdict true/false/both/"" (unknown); path
# is the is-a parent chain and edge the deciding [subject, object].
def _inherit(state, start, pred, goal):
  g = _stripart(goal)
  npred = "not-" + pred
  frontier = [[_stripart(start), []]]
  visited = {}
  dist = 0
  verdict = ""
  pos = null
  neg = null
  while len(frontier) > 0 and dist <= 8 and verdict == "":
    nxt = []
    for item in frontier:
      node = item[0]
      path = item[1]
      if not (node in visited):
        visited[node] = true
        if pos == null:
          if pred in state["relby"]:
            if node in state["relby"][pred]:
              for e in state["relby"][pred][node]:
                if pos == null:
                  if _stripart(e[1]) == g:
                    pos = [path, e]
        if neg == null:
          if npred in state["relby"]:
            if node in state["relby"][npred]:
              for e in state["relby"][npred][node]:
                if neg == null:
                  if _stripart(e[1]) == g:
                    neg = [path, e]
        if dist < 8:
          if "is-a" in state["relby"]:
            if node in state["relby"]["is-a"]:
              for e in state["relby"]["is-a"][node]:
                ns = _stripart(e[1])
                if not (ns in visited):
                  np2 = []
                  for pe in path:
                    append(np2, pe)
                  append(np2, e)
                  append(nxt, [ns, np2])
    if pos != null and neg != null:
      verdict = "both"
    if verdict == "" and pos != null:
      verdict = "true"
    if verdict == "" and pos == null and neg != null:
      verdict = "false"
    if verdict == "":
      frontier = nxt
      dist = dist + 1
  if verdict == "true":
    return [verdict, pos[0], pos[1], null, null]
  if verdict == "false":
    return [verdict, neg[0], neg[1], null, null]
  if verdict == "both":
    return [verdict, pos[0], pos[1], neg[0], neg[1]]
  return ["", null, null, null, null]
# Path edges are is-a: 'a dog is a mammal, a mammal is an animal, '.
def _pathfmt(path):
  out = ""
  for e in path:
    out = out + e[0] + " is " + e[1] + ", "
  return out
def _edgefmt(edge, pred, neg):
  ph = _posphrase(pred)
  if neg:
    ph = _negphrase(pred)
  return edge[0] + " " + ph + " " + edge[1]
# Render an _inherit verdict: direct edges (empty path) say '(taught)',
# inherited answers show the full reasoning chain, contradictions
# print both claims.
def _inherit_reply(state, x, pred, y):
  r = _inherit(state, x, pred, y)
  v = r[0]
  if v == "":
    return "not that i know"
  if v == "both":
    return "i was taught both: " + _pathfmt(r[1]) + _edgefmt(r[2], pred, false) + " and " + _pathfmt(r[3]) + _edgefmt(r[4], pred, true) + " - i cannot say which is true"
  if v == "true":
    if len(r[1]) == 0:
      return "yes: " + _edgefmt(r[2], pred, false) + " (taught)"
    return "yes: " + _pathfmt(r[1]) + _edgefmt(r[2], pred, false)
  if len(r[1]) == 0:
    return "no: " + _edgefmt(r[2], pred, true) + " (taught)"
  return "no: " + _pathfmt(r[1]) + _edgefmt(r[2], pred, true)
# is-a questions keep their established reply shape exactly (the chain
# itself, no '(taught)' marker); negatives and contradictions are new.
def _isa_reply(state, x, y):
  r = _inherit(state, x, "is-a", y)
  v = r[0]
  if v == "":
    return "not that i know"
  if v == "both":
    return "i was taught both: " + _pathfmt(r[1]) + _edgefmt(r[2], "is-a", false) + " and " + _pathfmt(r[3]) + _edgefmt(r[4], "is-a", true) + " - i cannot say which is true"
  if v == "true":
    full = []
    for pe in r[1]:
      append(full, pe)
    append(full, r[2])
    return _chain_fmt(full, "is-a")
  if len(r[1]) == 0:
    return "no: " + _edgefmt(r[2], "is-a", true) + " (taught)"
  return "no: " + _pathfmt(r[1]) + _edgefmt(r[2], "is-a", true)
# A12: 'is X Y' with no article or 'in' - the split between X and Y is
# ambiguous, so try every word boundary left to right (X grows one word
# at a time); the first chaining split wins, else open-world honest.
def _is_bare_reply(state, rest3):
  ws = _words(rest3)
  if len(ws) < 2:
    return "i do not understand"
  x = ws[0]
  i = 1
  while i < len(ws):
    y = rest3[len(x) + 1:]
    r = _inherit(state, x, "is-a", y)
    if r[0] != "":
      return _isa_reply(state, x, y)
    x = x + " " + ws[i]
    i = i + 1
  return "not that i know"
# Direct means-edge check (means never chains): 'X คือ Y ไหม' or a
# trailing '?' on any means shape asks instead of teaching.
def _means_check(state, x, y, sep):
  if x in state["relset"]:
    if "means" in state["relset"][x]:
      if y in state["relset"][x]["means"]:
        return "yes: " + x + sep + y
  return "not that i know"
# A14 rule engine. A proof is either ['edge', path, edge, rel] -
# taught or is-a-inherited evidence, rendered exactly like the A13
# chains - or ['rule', rule name, premise-1 proof, premise-2 proof,
# [subject, object], rel].
#
# _enum collects every object related to start by rel: taught or
# inherited edges first (each confirmed by _inherit, so nearest-wins
# and taught negatives apply to premises exactly as they do to direct
# questions), then rule-derived objects. memo caches per (start, rel)
# for one query; storing the in-progress list before recursing breaks
# cycles, and the depth cap bounds the search.
# The guard verdict for one rule step, checked against the step's
# OWN subject (never the middle object). Returns "ok" (membership
# proven through the is-a chain), "assume" (unverified - allowed in
# explore mode only), or "" (blocked: unverified in strict mode,
# negative evidence, or conflicting evidence - conflicts are never
# resolved arbitrarily). Blocked guards are recorded in gfail as
# [rule name, subject, domain, kind] so the reply can explain which
# rule could not apply and why; kind is the raw _inherit verdict.
def _guard(state, subj, rule, gfail):
  gr = _inherit(state, subj, "is-a", rule[4])
  if gr[0] == "true":
    return ["ok", gr]
  if gr[0] == "" and state["mode"] == "explore":
    return ["assume", gr]
  append(gfail, [rule[3], subj, rule[4], gr[0]])
  return ["", gr]
def _enum(state, start, rel, depth, memo, gfail):
  mkey = _stripart(start) + "|" + rel
  if mkey in memo:
    return memo[mkey]
  memo[mkey] = []
  cands = []
  seen = {}
  frontier = [[_stripart(start), []]]
  visited = {}
  dist = 0
  while len(frontier) > 0 and dist <= 8:
    nxt = []
    for item in frontier:
      node = item[0]
      path = item[1]
      if not (node in visited):
        visited[node] = true
        if rel in state["relby"]:
          if node in state["relby"][rel]:
            for e in state["relby"][rel][node]:
              o = _stripart(e[1])
              if not (o in seen):
                seen[o] = true
                append(cands, e[1])
        if dist < 8:
          if "is-a" in state["relby"]:
            if node in state["relby"]["is-a"]:
              for e in state["relby"]["is-a"][node]:
                ns = _stripart(e[1])
                if not (ns in visited):
                  np2 = []
                  for pe in path:
                    append(np2, pe)
                  append(np2, e)
                  append(nxt, [ns, np2])
    frontier = nxt
    dist = dist + 1
  out = []
  for c in cands:
    r = _inherit(state, start, rel, c)
    if r[0] == "true":
      append(out, [c, ["edge", r[1], r[2], rel]])
  if depth < _RULECAP:
    for rule in _RULES:
      if rule[2] == rel:
        ys = _enum(state, start, rule[0], depth + 1, memo, gfail)
        if len(ys) > 0:
          g = _guard(state, start, rule, gfail)
          if g[0] != "":
            for yit in ys:
              for zit in _enum(state, yit[0], rule[1], depth + 1, memo, gfail):
                o = _stripart(zit[0])
                if not (o in seen):
                  seen[o] = true
                  append(out, [zit[0], ["rule", rule[3], yit[1], zit[1], [start, zit[0]], rel, [g[0], g[1], rule[4]]]])
  memo[mkey] = out
  return out
# Prove (start, pred, goal) from the rule table alone: for each rule
# concluding pred, enumerate middle objects for its first premise,
# check the domain guard on this step's own subject, and prove the
# second premise recursively. A premise with taught negative or
# contradicted evidence is never built on - rules under-infer
# rather than overclaim. First complete proof wins (rule table order,
# then edge insertion order: deterministic). A rule proof node is
# ['rule', name, premise1, premise2, [subject, object], rel,
# [guard kind, guard verdict, domain]].
def _rule_prove(state, start, pred, goal, depth, memo, pseen, gfail):
  if depth >= _RULECAP:
    return null
  anyrule = false
  for rule in _RULES:
    if rule[2] == pred:
      anyrule = true
  if not anyrule:
    return null
  pkey = _stripart(start) + "|" + pred + "|" + _stripart(goal)
  if pkey in pseen:
    return null
  pseen[pkey] = true
  for rule in _RULES:
    if rule[2] == pred:
      ys = _enum(state, start, rule[0], depth + 1, memo, gfail)
      if len(ys) > 0:
        # The guard is checked only when the rule otherwise has
        # candidate premises, so a blocked-rule explanation always
        # names a rule that could actually have applied.
        g = _guard(state, start, rule, gfail)
        if g[0] != "":
          for yit in ys:
            r2 = _inherit(state, yit[0], rule[1], goal)
            if r2[0] == "true":
              return ["rule", rule[3], yit[1], ["edge", r2[1], r2[2], rule[1]], [start, goal], pred, [g[0], g[1], rule[4]]]
            if r2[0] == "":
              p2 = _rule_prove(state, yit[0], rule[1], goal, depth + 1, memo, pseen, gfail)
              if p2 != null:
                return ["rule", rule[3], yit[1], p2, [start, goal], pred, [g[0], g[1], rule[4]]]
  return null
# A14 query path: taught/inherited evidence first (the A13 engine,
# unchanged); only when that knows nothing or found a taught negative
# do the compositional rules fire. A rule-derived positive conflicting
# with a taught negative is a contradiction - shown with its
# reasoning, never silently resolved. Verdicts: true/false/both (pure
# A13), rule (derived positive, possibly conditional on assumptions),
# rule-both (derived vs taught negative). The fourth slot carries the
# guard failures when nothing could be derived.
def _derive(state, x, pred, y):
  r = _inherit(state, x, pred, y)
  v = r[0]
  if v == "true" or v == "both":
    return [v, r, null, null]
  gfail = []
  p = _rule_prove(state, x, pred, y, 0, {}, {}, gfail)
  if p == null:
    return [v, r, null, gfail]
  if v == "false":
    return ["rule-both", r, p, null]
  return ["rule", null, p, null]
# Inline text of a proof's conclusion.
def _proof_text(proof):
  if proof[0] == "edge":
    return _pathfmt(proof[1]) + _edgefmt(proof[2], proof[3], false)
  return _edgefmt(proof[4], proof[5], false)
# Flatten a rule proof into numbered derivation steps, premises
# first; each step names the rule that fired and the two premises it
# used. A verified domain shows as the step's CONDITION (an inference
# condition, not a truth claim); an unverified domain in explore mode
# is collected into assum as [subject, domain, step number] and the
# reply consolidates it - an assumption is named, never upgraded.
def _proof_steps(proof, steps, done, assum):
  t = _proof_text(proof)
  if proof[0] == "edge":
    return t
  t1 = _proof_steps(proof[2], steps, done, assum)
  t2 = _proof_steps(proof[3], steps, done, assum)
  if not (t in done):
    done[t] = true
    line = t1 + " + " + t2 + " => " + t + " [rule " + proof[1]
    if proof[6][0] == "ok":
      line = line + "; domain: " + _pathfmt(proof[6][1][1]) + _edgefmt(proof[6][1][2], "is-a", false)
    line = line + "]"
    append(steps, "(" + str(len(steps) + 1) + ") " + line)
    if proof[6][0] == "assume":
      append(assum, [proof[4][0], proof[6][2], len(steps), proof[1]])
  return t
def _derive_render(state, x, pred, y, d):
  if d[0] == "rule" or d[0] == "rule-both":
    steps = []
    assum = []
    _proof_steps(d[2], steps, {}, assum)
    out = ""
    if d[0] == "rule":
      if len(assum) > 0:
        out = "yes, on " + str(len(assum)) + " assumption"
        if len(assum) > 1:
          out = out + "s"
        out = out + ": "
      else:
        out = "yes: "
      out = out + x + " " + _posphrase(pred) + " " + y + ". reasoning:"
    else:
      r = d[1]
      out = "i was taught " + _pathfmt(r[1]) + _edgefmt(r[2], pred, true) + ", but the rules derive " + x + " " + _posphrase(pred) + " " + y + " - i cannot say which is true. reasoning:"
    for s in steps:
      out = out + "\n" + s
    if len(assum) > 0:
      # Consolidate: one entry per distinct (subject, domain) with its
      # step references merged, in order of first appearance. Distinct
      # assumptions and their step dependencies survive long chains.
      merged = []
      mseen = {}
      for a in assum:
        mk = a[0] + "|" + a[1]
        if mk in mseen:
          merged[mseen[mk]][2] = merged[mseen[mk]][2] + ", " + str(a[2])
        else:
          mseen[mk] = len(merged)
          append(merged, [a[0], a[1], str(a[2])])
      labels = "abcdefghijklmnopqrstuvwxyz"
      out = out + "\nassumptions:"
      i = 0
      while i < len(merged):
        out = out + "\n(" + labels[i] + ") " + merged[i][0] + " is a " + merged[i][1] + " - assumed at step " + merged[i][2] + ", unverified"
        i = i + 1
      # A15: these assumptions are hypothesis candidates. (assum is
      # non-empty only in explore mode - strict records nothing.)
      if not _hyp_record(state, _hyp_q(x, pred, y), assum):
        out = out + "\n(hypothesis list full - teach or forget hypotheses to free space)"
    return out
  # Nothing derived: explain when a domain guard stopped a rule that
  # otherwise had premises. The three kinds stay distinct, and a
  # failed guard never makes the relation itself false.
  if d[0] == "" and d[3] != null and len(d[3]) > 0:
    f = d[3][0]
    if f[3] == "":
      return "not that i know - rule " + f[0] + " applies only to " + f[2] + "s, and i do not know whether " + f[1] + " is a " + f[2]
    if f[3] == "false":
      return "not that i know - rule " + f[0] + " applies only to " + f[2] + "s, and " + f[1] + " is not a " + f[2]
    return "not that i know - rule " + f[0] + " applies only to " + f[2] + "s, and i was taught both that " + f[1] + " is and is not a " + f[2]
  return _inherit_reply(state, x, pred, y)
# A15 listing: entries are labelled as unresolved candidates, never
# recommendations or beliefs. Detail mode shows the creation event
# and the most recent uses (older ones marked omitted).
def _hyp_reply(state, detail):
  hs = state["hypotheses"]
  out = ""
  if len(hs) == 0:
    out = "no open hypotheses"
  else:
    if len(hs) == 1:
      out = "1 open hypothesis (unresolved candidates, not beliefs):"
    else:
      out = str(len(hs)) + " open hypotheses (unresolved candidates, not beliefs):"
    labels = "abcdefghijklmnopqrst"
    i = 0
    while i < len(hs):
      h = hs[i]
      out = out + "\n(" + labels[i] + ") " + h[0] + " is a " + h[1] + " - assumed "
      if h[2] == 1:
        out = out + "once"
      else:
        out = out + str(h[2]) + " times"
      out = out + ", first for '" + h[3][0] + "'"
      if detail:
        out = out + "\n  created for '" + h[3][0] + "' [explore, rule " + h[3][1] + ", step " + h[3][2] + "]"
        for ev in h[4]:
          out = out + "\n  used for '" + ev[0] + "' [explore, rule " + ev[1] + ", step " + ev[2] + "]"
        if h[5] > 0:
          out = out + "\n  (+" + str(h[5]) + " older uses omitted)"
      i = i + 1
  first = true
  for r in state["hyp_retired"]:
    if first:
      out = out + "\nrecently retired:"
      first = false
    out = out + "\n- " + r[0] + " is a " + r[1] + " (" + r[2] + ")"
  return out
def _derive_reply(state, x, pred, y):
  return _derive_render(state, x, pred, y, _derive(state, x, pred, y))
# A13: parse 'remember <subj> <verb> <obj>' - [split, relation,
# negated, object start]; negatives are checked before positives.
def _verb_teach_parse(mrest):
  for vt in _VERBT:
    k = find(mrest, vt[0])
    if k > 0 and k + len(vt[0]) < len(mrest):
      return [k, vt[1], vt[2], k + len(vt[0])]
  return null
# A13: 'does X need Y' / 'do X use Y' / 'does X have Y' - the fixed
# marker table decides the relation.
def _verb_q(state, rest):
  for vm in _VERBQ:
    k = find(rest, vm[0])
    if k > 0 and k + len(vm[0]) < len(rest):
      return _derive_reply(state, rest[:k], vm[1], rest[k + len(vm[0]):])
  return "i do not understand"
# A13: 'can a doctor learn' - subject/object split is ambiguous, so
# try every word boundary left to right (same rule as the bare is-a
# question); the first decided split wins.
def _can_q(state, rest):
  ws = _words(rest)
  if len(ws) < 2:
    return "i do not understand"
  x = ws[0]
  i = 1
  blocked = null
  bx = ""
  by = ""
  while i < len(ws):
    y = rest[len(x) + 1:]
    d = _derive(state, x, "can", y)
    if d[0] != "":
      return _derive_render(state, x, "can", y, d)
    # An undecided split can still carry a guard-blocked rule; keep the
    # first so the final miss explains it (A14.1).
    if blocked == null and d[3] != null and len(d[3]) > 0:
      blocked = d
      bx = x
      by = y
    x = x + " " + ws[i]
    i = i + 1
  if blocked != null:
    return _derive_render(state, bx, "can", by, blocked)
  return "not that i know"
# A13: passive verb questions - 'is energy needed by a dog'.
def _passive_reply(state, rest3):
  for vp in _VERBP:
    k = find(rest3, vp[0])
    if k > 0 and k + len(vp[0]) < len(rest3):
      return _derive_reply(state, rest3[k + len(vp[0]):], vp[1], rest3[:k])
  return null
def _where_reply(state, x, sep):
  path = _where_chain(state, x)
  if len(path) == 0:
    return _recall(state, x)
  out = ""
  for e in path:
    out = out + e[0] + sep + e[1] + ", "
  return out[:len(out) - 2]
def _mean_reply(state, x, sep):
  defs = []
  for e in _BUILTIN_RELS:
    if e[0] == x:
      append(defs, e[2])
  for e in state["rels"]:
    if e[0] == x and e[1] == "means":
      append(defs, e[2])
  if len(defs) > 0:
    return x + sep + _join(defs)
  return _recall(state, x)
def _open_reply(state, thing):
  resolved = _resolve(state, thing)
  if resolved != null:
    state["topic"] = resolved
    return "all i know about " + resolved + " is " + _join(state["facts"][resolved])
  return _recall(state, thing)
# "what else" continues the session topic: remaining facts, or an
# honest that-is-all.
def _else_reply(state):
  if state["topic"] == null:
    return "i have no topic yet"
  facts = state["facts"][state["topic"]]
  if len(facts) <= 1:
    return "that is all i know about " + state["topic"]
  return "about " + state["topic"] + ": " + _join(facts[1:])
_HELP = "commands: remember <thing> is <fact> | remember <thing> is also <fact> | remember <thing> has <part> | remember <thing> เป็น <kind> | no, <thing> is <fact> | what is <thing> | do you know <thing> | what does <thing> mean | is <thing> in <thing> | is <thing> a <thing> | is <thing> <thing> | where is <thing> | what do you know about <thing> | how is <thing> | how about <thing> | <thing> คืออะไร | <thing> หมายความว่าอะไร | <thing> อยู่ไหน | <thing> เป็น <thing> ไหม | <thing> คือ <thing> หรือไม่ | and <thing> | what else | what about it | <phrase> means <thing> | forget <thing> | forget it | remember <thing> needs/can/uses/produces/causes <thing> | remember <thing> cannot <verb> | does <thing> <verb> <thing> | can <thing> <verb> | is <thing> needed by <thing> | remember <thing> is not a <kind> | what do you know | what did you forget | what did we talk about | note <text> | notes | clear notes | mode | mode strict | mode explore | hypotheses | hypotheses detail | forget hypothesis <thing> is a <kind> | clear hypotheses | read <text> | readings | readings about <thing> | readings detail | forget reading <thing> is a <kind> | clear readings | read url <url> (experimental, repl shell only) | list | say <text> | help"
# One line in, one reply out. Rules are checked in a fixed order and the
# first match wins; anything unrecognized gets the honest fallback.
def respond(state, line):
  text = normalize(line)
  # One trailing ? or . is punctuation, not part of the words. A12:
  # remember whether a ? was asked - it forces question mode on the
  # means shapes, which otherwise teach ('apple means fruit?').
  qmark = false
  if len(text) > 0:
    last = text[len(text) - 1:]
    if last == "?":
      qmark = true
      text = text[:len(text) - 1]
    if last == ".":
      text = text[:len(text) - 1]
  m = lower_ascii(text)
  if state["pending"] != null:
    r = _pending_reply(state, m)
    if r[0]:
      return r[1]
  if m == "help":
    return _HELP
  if m == "list":
    return _list_reply(state)
  if m == "notes":
    return _notes_reply(state)
  if m == "clear notes":
    state["notes"] = []
    return "notes cleared"
  # A14.1: strict mode (the default) blocks compositional rules whose
  # domain is unverified; explore mode lets them fire conditionally.
  # Session-only, like notes.
  if m == "mode":
    if state["mode"] == "explore":
      return "explore mode: compositional rules may fire on unverified domains; conclusions list their assumptions and assumptions never become facts"
    return "strict mode (the default): compositional rules need verified domains; 'mode explore' allows conditional conclusions"
  if m == "mode explore":
    state["mode"] = "explore"
    return "explore mode: compositional rules may fire on unverified domains; conclusions list their assumptions (this session only)"
  if m == "mode strict":
    state["mode"] = "strict"
    return "strict mode: compositional rules need verified domains (this session only)"
  # A15: hypothesis inspection and management. 'forget hypothesis'
  # must precede the generic 'forget <thing>' route.
  if m == "hypotheses":
    return _hyp_reply(state, false)
  if m == "hypotheses detail":
    return _hyp_reply(state, true)
  if m == "clear hypotheses":
    state["hypotheses"] = []
    state["hyp_retired"] = []
    return "hypotheses cleared"
  if m[:18] == "forget hypothesis ":
    rest = m[18:]
    k = find(rest, " is a ")
    if k > 0 and k + 6 < len(rest):
      if _hyp_find(state, rest[:k], rest[k + 6:]) >= 0:
        _hyp_retire(state, rest[:k], rest[k + 6:], "forgotten")
        return "forgotten: hypothesis " + rest[:k] + " is a " + rest[k + 6:]
      return "no such hypothesis - 'hypotheses' lists the open ones"
    k = find(rest, " is an ")
    if k > 0 and k + 7 < len(rest):
      if _hyp_find(state, rest[:k], rest[k + 7:]) >= 0:
        _hyp_retire(state, rest[:k], rest[k + 7:], "forgotten")
        return "forgotten: hypothesis " + rest[:k] + " is an " + rest[k + 7:]
      return "no such hypothesis - 'hypotheses' lists the open ones"
    return "forget hypothesis <thing> is a <kind>"
  # A16 reader: ingest text as data (never executed), inspect and
  # manage read candidates. 'forget reading' precedes generic forget.
  if m == "readings":
    return _readings_reply(state, "", false)
  if m == "readings detail":
    return _readings_reply(state, "", true)
  if m[:15] == "readings about " and len(m) > 15:
    return _readings_reply(state, m[15:], false)
  if m == "clear readings":
    state["readings"] = []
    state["read_src"] = {}
    state["url_srcs"] = []
    return "readings cleared"
  if m[:15] == "forget reading " and len(m) > 15:
    rest = m[15:]
    fr = _read_extract(rest)
    if fr != null:
      ri3 = _read_find(state, fr[0], fr[1], fr[2])
      if ri3 >= 0:
        r = state["readings"][ri3]
        state["readings"] = state["readings"][:ri3] + state["readings"][ri3 + 1:]
        return "forgotten: reading " + r[0] + " | " + r[1] + " | " + r[2]
      return "no such reading - 'readings' lists them"
    return "forget reading <thing> is a <kind>"
  if m[:9] == "read url " and len(text) > 9:
    return _read_url(state, text[9:])
  if m[:5] == "read " and len(text) > 5:
    return _read_text(state, text[5:])
  if m[:5] == "note " and len(text) > 5:
    append(state["notes"], text[5:])
    return "noted"
  if m == "what about it":
    if state["topic"] == null:
      return "i have no topic yet"
    return _recall(state, state["topic"])
  # Pleasantries: fixed strings, visibly mechanical, never a claimed
  # feeling. English and Thai.
  if m == "hello" or m == "hi" or m == "hey":
    return "hello - teach me something with: remember <thing> is <fact>"
  if m == "how are you":
    return "i am a pattern matcher, not a person - but the patterns are working"
  if m == "thanks" or m == "thank you":
    return "noted - i do not feel it, but the fact store appreciates the exercise"
  if m == "bye" or m == "goodbye":
    return "type quit to leave, or keep teaching me"
  if m == "สวัสดี":
    return "สวัสดี - สอนผมได้ด้วย: remember <thing> is <fact>"
  if m == "ขอบคุณ":
    return "ยินดี - ผมไม่ได้รู้สึก แค่จับคู่รูปแบบ"
  if m == "what else" or m == "anything else":
    return _else_reply(state)
  if m[:4] == "and " and len(m) > 4:
    return _recall(state, m[4:])
  # Open questions (how/why/when/about), English and Thai.
  if m[:7] == "how is ":
    return _open_reply(state, m[7:])
  if m[:7] == "why is ":
    return _open_reply(state, m[7:])
  if m[:8] == "when is ":
    return _open_reply(state, m[8:])
  if m[:10] == "how about ":
    return _open_reply(state, m[10:])
  if m[:25] == "tell me everything about ":
    return _open_reply(state, m[25:])
  p = "เกี่ยวกับ "
  if find(m, p) == 0:
    return _open_reply(state, m[len(p):])
  # Thai what-is: "<thing> คืออะไร" (suffix form).
  k = find(m, " คืออะไร")
  if k > 0 and k + len(" คืออะไร") == len(m):
    return _recall(state, m[:k])
  if m == "forget it":
    if state["topic"] == null:
      return "i have no topic yet"
    return _forget(state, state["topic"])
  # A12: bounded self-knowledge - what it knows, what it forgot, what
  # happened this session. Plural aliases included; answers are capped.
  if m == "what do you know" or m == "how many things do you know" or m == "what have you learned":
    return _know_reply(state)
  if m == "what did you forget" or m == "what have you forgotten":
    return _forgotten_reply(state)
  if m == "what did we talk about" or m == "what happened this session":
    return _session_reply(state)
  if m[:23] == "what do you know about ":
    return _about_reply(state, m[23:])
  if m[:9] == "remember ":
    rest = text[9:]
    mrest = m[9:]
    k = find(mrest, " is also ")
    if k > 0 and k + 9 < len(mrest):
      return _teach_also(state, mrest[:k], rest[k + 9:])
    k = find(mrest, " is ")
    if k > 0 and k + 4 < len(mrest):
      if _has(state, mrest[:k]) and _kind_value(mrest[k + 4:]):
        return _teach_also(state, mrest[:k], rest[k + 4:])
      return _teach(state, mrest[:k], rest[k + 4:])
    k = find(mrest, " has ")
    if k > 0 and k + 5 < len(mrest):
      return _unteach_is(_teach_also(state, mrest[:k], rest[k + 1:]), "has")
    # A17: plural teach forms, mirroring the singular routes so every
    # plural reading has a supported teaching shape.
    k = find(mrest, " do not have ")
    if k > 0 and k + 13 < len(mrest):
      return _teach_verb(state, mrest[:k], "has", mrest[k + 13:], true)
    k = find(mrest, " does not have ")
    if k > 0 and k + 15 < len(mrest):
      return _teach_verb(state, mrest[:k], "has", mrest[k + 15:], true)
    k = find(mrest, " are not ")
    if k > 0 and k + 9 < len(mrest):
      return _unteach_is(_teach_also(state, mrest[:k], rest[k + 1:]), "are not")
    k = find(mrest, " have ")
    if k > 0 and k + 6 < len(mrest):
      return _unteach_is(_teach_also(state, mrest[:k], rest[k + 1:]), "have")
    k = find(mrest, " are ")
    if k > 0 and k + 5 < len(mrest):
      return _unteach_is(_teach_also(state, mrest[:k], rest[k + 1:]), "are")
    k = find(mrest, " อยู่ ")
    if k > 0 and k + len(" อยู่ ") < len(mrest):
      return _unteach_is(_teach_also(state, mrest[:k], rest[k + 1:]), "อยู่")
    k = find(mrest, " คือ ")
    if k > 0 and k + len(" คือ ") < len(mrest):
      return _unteach_is(_teach_also(state, mrest[:k], rest[k + 1:]), "คือ")
    k = find(mrest, " เป็น ")
    if k > 0 and k + len(" เป็น ") < len(mrest):
      return _unteach_is(_teach_also(state, mrest[:k], rest[k + 1:]), "เป็น")
    k = find(mrest, " ไม่เป็น ")
    if k > 0 and k + len(" ไม่เป็น ") < len(mrest):
      return _unteach_is(_teach_also(state, mrest[:k], rest[k + 1:]), "ไม่เป็น")
    # A13: verb relation teaches ('remember a living thing needs
    # energy', 'remember a dog cannot fly'). Objects are matched on
    # the lowered line so edges and stored values stay comparable.
    vt = _verb_teach_parse(mrest)
    if vt != null:
      return _teach_verb(state, mrest[:vt[0]], vt[1], mrest[vt[3]:], vt[2])
    return "i do not understand"
  # 'what does X mean' answers from the means relation (taught +
  # built-in self-knowledge), falling back to taught facts, then miss.
  if m[:10] == "what does " and len(m) > 15 and m[len(m) - 5:] == " mean":
    return _mean_reply(state, m[10:len(m) - 5], " means ")
  # 'is X in Y' / 'is X a Y': transitive check; the shown chain is the
  # reasoning, and the negative is open-world honest ('not that i know').
  if m[:3] == "is ":
    rest3 = m[3:]
    # A13: passive verb questions first ('is energy needed by a dog').
    pv = _passive_reply(state, rest3)
    if pv != null:
      return pv
    k = find(rest3, " in ")
    if k > 0:
      return _chain_reply(state, rest3[:k], "is-in", rest3[k + 4:])
    k = find(rest3, " an ")
    if k > 0:
      return _isa_reply(state, rest3[:k], rest3[k + 4:])
    k = find(rest3, " a ")
    if k > 0:
      return _isa_reply(state, rest3[:k], rest3[k + 3:])
    # A12: no article at all - 'is apple food' tries every split.
    return _is_bare_reply(state, rest3)
  k = find(m, " หมายความว่าอะไร")
  if k > 0 and k + len(" หมายความว่าอะไร") == len(m):
    return _mean_reply(state, m[:k], " คือ ")
  k = find(m, " อยู่ไหน")
  if k > 0 and k + len(" อยู่ไหน") == len(m):
    return _where_reply(state, m[:k], " อยู่ ")
  if m[:8] == "what is ":
    return _recall(state, m[8:])
  if m[:12] == "do you know ":
    return _recall(state, m[12:])
  if m[:15] == "tell me about ":
    return _recall(state, m[15:])
  if m[:7] == "who is ":
    return _recall(state, m[7:])
  if m[:9] == "where is ":
    return _where_reply(state, m[9:], " is in ")
  # A13: verb questions - does/do/can over the fixed marker tables.
  if m[:5] == "does " and len(m) > 5:
    return _verb_q(state, m[5:])
  if m[:3] == "do " and len(m) > 3:
    return _verb_q(state, m[3:])
  if m[:4] == "can " and len(m) > 4:
    return _can_q(state, m[4:])
  if m[:7] == "forget ":
    return _forget(state, m[7:])
  if m[:4] == "say " and len(text) > 4:
    return text[4:]
  if m[:4] == "no, ":
    # Teaching by correction: "no, X is Z" replaces X's facts; when X
    # names a taught paraphrase the correction lands on its target.
    rest = text[4:]
    mrest = m[4:]
    k = find(mrest, " is ")
    if k > 0 and k + 4 < len(mrest):
      key = mrest[:k]
      resolved = _resolve(state, key)
      if resolved != null:
        key = resolved
      return _teach(state, key, rest[k + 4:])
    return "i do not understand"
  # A12: Thai yes/no questions. The markers หรือไม่ / ไหม (spaced or
  # not, Thai has no spaces) force question mode: เป็น asks an is-a
  # chain, คือ asks a direct means edge (means never chains). Placed
  # after the recall routes so an English-prefixed question containing
  # Thai keeps its route.
  q = m
  isq = false
  for suf in [" หรือไม่", "หรือไม่", " ไหม", "ไหม"]:
    if len(q) > len(suf):
      if q[len(q) - len(suf):] == suf:
        q = q[:len(q) - len(suf)]
        isq = true
  if not isq and qmark:
    isq = true
  if isq:
    k = find(q, " เป็น ")
    if k < 0:
      k = find(q, "เป็น")
      d = len("เป็น")
    else:
      d = len(" เป็น ")
    if k > 0 and k + d < len(q):
      return _isa_reply(state, q[:k], q[k + d:])
    k = find(q, " คือ ")
    if k < 0:
      k = find(q, "คือ")
      d = len("คือ")
    else:
      d = len(" คือ ")
    if k > 0 and k + d < len(q):
      return _means_check(state, q[:k], q[k + d:], " คือ ")
  # The definitional relation, unified across languages:
  # 'X means Y', 'X หมายความว่า Y', 'X คือ Y' all write the same edge.
  # A taught-key target also records a paraphrase alias (A3 role);
  # a free-text target is a plain definition (A9: no longer an error).
  means_p = ""
  k = find(m, " means ")
  if k > 0:
    means_p = " means "
  else:
    k = find(m, " หมายความว่า ")
    if k > 0:
      means_p = " หมายความว่า "
    else:
      k = find(m, " คือ ")
      if k > 0:
        means_p = " คือ "
  if k > 0 and k + len(means_p) < len(m):
    phrase = m[:k]
    target = m[k + len(means_p):]
    if phrase == target:
      return "i do not understand"
    if qmark:
      return _means_check(state, phrase, target, means_p)
    _add_rel(state, phrase, "means", target)
    if _has(state, target):
      state["aliases"][phrase] = target
    return "ok, " + phrase + means_p + target
  return "i do not understand"
