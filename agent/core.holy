# agent/core.holy — a small local agent core in pure hs.
#
# What it is: an ordered pattern-rule matcher with a teachable key->value
# memory. What it is not: a language model. Everything it "knows" was
# taught with `remember`; anything else gets an honest fallback reply.
#
# The core is pure: respond(state, line) only reads/mutates the state
# Dict and returns the reply Str. State is JSON-serializable
# ({"facts": {...}, "order": [...]}), so agent/store.holy can persist it
# and a future kernel port can carry it as plain data.
#
# Backend parity discipline (same as std.str): all matching is ASCII-only
# and byte-based. Non-ASCII text passes through untouched, so interp and
# every compiled backend agree byte for byte.
_UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
_LOWER = "abcdefghijklmnopqrstuvwxyz"
def _is_ws(c):
  return c == " " or c == "\t" or c == "\n" or c == "\r"
# Collapse every ASCII whitespace run to one space and trim the ends.
def normalize(s):
  out = ""
  ws = false
  i = 0
  while i < len(s):
    c = s[i]
    if _is_ws(c):
      ws = true
    else:
      if ws and len(out) > 0:
        out = out + " "
      out = out + c
      ws = false
    i = i + 1
  return out
# Lowercase ASCII letters only; every other byte is kept as is.
def lower_ascii(s):
  out = ""
  i = 0
  while i < len(s):
    c = s[i]
    j = find(_UPPER, c)
    if j >= 0:
      out = out + _LOWER[j]
    else:
      out = out + c
    i = i + 1
  return out
def new_state():
  return {"facts": {}, "order": []}
def _has(state, key):
  for k in state["order"]:
    if k == key:
      return true
  return false
def _teach(state, key, value):
  if _has(state, key):
    state["facts"][key] = value
    return "updated " + key + " is " + value
  state["facts"][key] = value
  append(state["order"], key)
  return "remembered " + key + " is " + value
def _forget(state, key):
  if not _has(state, key):
    return "i do not know " + key
  facts = {}
  for k in state["facts"]:
    if k != key:
      facts[k] = state["facts"][k]
  order = []
  for k in state["order"]:
    if k != key:
      append(order, k)
  state["facts"] = facts
  state["order"] = order
  return "forgot " + key
def _list_reply(state):
  order = state["order"]
  n = len(order)
  if n == 0:
    return "i know nothing yet"
  joined = order[0]
  i = 1
  while i < n:
    joined = joined + ", " + order[i]
    i = i + 1
  if n == 1:
    return "i know 1 thing: " + joined
  return "i know " + str(n) + " things: " + joined
_HELP = "commands: remember <thing> is <fact> | what is <thing> | forget <thing> | list | say <text> | help"
# One line in, one reply out. Rules are checked in a fixed order and the
# first match wins; anything unrecognized gets the honest fallback.
def respond(state, line):
  text = normalize(line)
  m = lower_ascii(text)
  if m == "help":
    return _HELP
  if m == "list":
    return _list_reply(state)
  if m[:9] == "remember ":
    rest = text[9:]
    mrest = m[9:]
    k = find(mrest, " is ")
    if k > 0 and k + 4 < len(mrest):
      return _teach(state, mrest[:k], rest[k + 4:])
    return "i do not understand"
  if m[:8] == "what is ":
    key = m[8:]
    if _has(state, key):
      return "i know " + key + " is " + state["facts"][key]
    return "i do not know " + key
  if m[:7] == "forget ":
    return _forget(state, m[7:])
  if m[:4] == "say " and len(text) > 4:
    return text[4:]
  return "i do not understand"
