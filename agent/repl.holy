# agent/repl.holy — chat with the local agent in a terminal.
#
# Run from the repo root:  hs run agent/repl.holy
# (or: python3 interp.py agent/repl.holy)
#
# Memory persists to agent-memory.json in the current directory when the
# chat ends (type `quit`, or ctrl-d). Type `help` inside for commands.
# This is a thin IO shell: every reply comes from agent.core.respond.
import agent.core
import agent.store
import agent.fetch
import agent.patgen
import agent.proposals
import agent.shadow
import agent.review
import agent.learned
import agent.integrity
import agent.registry
import agent.tripwire
import agent.reviewers
path = "agent-memory.json"
state = agent.store.load(path)
# A18 EXPERIMENTAL: the fetch test harness is reachable only by
# starting the repl with HS_AGENT_TEST_FETCH=1 in the environment.
# The core never probes the environment itself (IR-subset routes
# have no env builtin), so no ordinary command can set this flag.
tfv = env("HS_AGENT_TEST_FETCH")
state["test_fetch"] = tfv != null and tfv == "1"
print "holyshit agent v0.15 - type 'help' for commands, 'quit' to leave"
ppath = "agent-patterns.json"
apath = "agent-attestations.json"
dpath = "agent-delegation.json"
lpath = "agent-learned-log.json"
mpath = "agent-manifest.json"
rpath = "agent-registry.json"
tpath = "agent-tripwire.json"
rvpath = "agent-reviewers.json"
mfiles = [ppath, apath, dpath, lpath, rpath, tpath, rvpath]
integ = {"bad": false, "noted": false}
def a22_status(st, cid):
  out = "A22 read-only status (display only, not a gate):"
  if not has(st["candidates"], cid):
    return ""
  pred = st["candidates"][cid]["descriptor"]["predicate"]
  rg = agent.registry.load(rpath)
  if has(rg["predicates"], pred):
    sg = rg["predicates"][pred]
    out = out + "\n  predicate " + pred + " signature (" + sg["subj"] + ", " + sg["obj"] + ") [declared by owner]"
  else:
    out = out + "\n  predicate " + pred + ": no signature declared (types unknown)"
  tc = split(agent.registry.typecheck(rg, state["rels"]), "\n")
  out = out + "\n  " + tc[0]
  tw = agent.tripwire.load(tpath)
  if has(tw["patterns"], cid):
    p = tw["patterns"][cid]
    out = out + "\n  tripwire " + p["state"] + ": FP lifetime " + str(p["fp_lifetime"]) + ", polarity errors " + str(p["polarity_lifetime"]) + ", " + str(p["matches_lifetime"]) + " distinct matches (provisional thresholds)"
  else:
    out = out + "\n  tripwire CLEAR: no recorded matches"
  return out
def patterns_cmd(line):
  parts = split(agent.core.normalize(line), " ")
  sub = "list"
  if len(parts) > 1:
    sub = agent.core.lower_ascii(parts[1])
  st = agent.proposals.load(ppath)
  if sub == "list":
    return agent.proposals.listing(st)
  if sub == "derive" and len(parts) == 3:
    src = null
    ok = false
    try:
      src = json_load(parts[2])
      ok = true
    except:
      ok = false
    if not ok:
      return "patterns derive: cannot read annotated set " + parts[2]
    corpus = []
    negs = []
    try:
      corpus = src["corpus"]
    except:
      corpus = []
    try:
      negs = src["negatives"]
    except:
      negs = []
    res = agent.patgen.derive(src["examples"], st["rejected"], corpus, negs)
    notes = agent.proposals.merge(st, res)
    err = agent.proposals.save(ppath, st)
    out = agent.patgen.report(res)
    for n in notes:
      out = out + "\nnote: " + n
    if err != "":
      out = out + "\n" + err
    return out
  if (sub == "shadow" or sub == "unshadow" or sub == "review") and len(parts) == 3:
    msg = ""
    if sub == "shadow":
      msg = agent.proposals.shadow(st, parts[2])
    elif sub == "unshadow":
      msg = agent.proposals.unshadow(st, parts[2])
    else:
      msg = agent.proposals.review(st, parts[2])
      msg = msg + "\n" + a22_status(st, parts[2])
    agent.proposals.save(ppath, st)
    return msg
  if (sub == "sensitive" or sub == "unsensitive") and len(parts) == 3:
    msg = agent.proposals.sensitive(st, parts[2], sub == "sensitive")
    agent.proposals.save(ppath, st)
    return msg
  if sub == "samples" and len(parts) == 3 and (parts[2] == "on" or parts[2] == "off"):
    msg = agent.proposals.samples(st, parts[2] == "on")
    agent.proposals.save(ppath, st)
    return msg
  if sub == "origin" and (len(parts) == 5 or len(parts) == 6):
    rel = "none"
    if len(parts) == 6:
      rel = parts[5]
    msg = agent.proposals.origin(st, parts[2], parts[3], parts[4], rel)
    agent.proposals.save(ppath, st)
    return msg
  if sub == "disposition" and len(parts) >= 6:
    why = ""
    if len(parts) > 6:
      why = join(" ", parts[6:])
    msg = agent.proposals.disposition(st, parts[2], parts[3], parts[4], parts[5], why)
    agent.proposals.save(ppath, st)
    return msg
  if sub == "lineage" and len(parts) == 7:
    msg = agent.proposals.lineage(st, parts[2], parts[3], parts[4], parts[5], parts[6])
    agent.proposals.save(ppath, st)
    return msg
  if sub == "reviewers" and len(parts) == 2:
    return agent.reviewers.listing(agent.reviewers.load(rvpath))
  if sub == "budget" or sub == "reinstate" or sub == "canary":
    rvs = agent.reviewers.load(rvpath)
    wasp = rvs["present"]
    msg = ""
    if sub == "budget" and len(parts) == 6 and parts[5] == "owner":
      msg = agent.reviewers.set_budget(rvs, parts[2], parts[3], parts[4])
    elif sub == "budget":
      return "budget refused: usage `patterns budget FAMILY MAXCANDS MAXWORK owner`"
    elif sub == "reinstate" and len(parts) >= 5 and parts[3] == "owner":
      msg = agent.reviewers.reinstate(rvs, parts[2], join(" ", parts[4:]))
    elif sub == "reinstate":
      return "reinstate refused: usage `patterns reinstate FAMILY owner NOTE...`; only the owner reinstates"
    elif len(parts) == 6 and parts[5] == "owner":
      cs = null
      an = null
      try:
        cs = json_load(parts[3])
        an = json_load(parts[4])
      except:
        return "canary refused: cannot read " + parts[3] + " or " + parts[4]
      msg = agent.reviewers.run_canary(rvs, parts[2], cs["cases"], an["answers"])
    else:
      return "canary refused: usage `patterns canary FAMILY CASES.json ANSWERS.json owner`"
    err = agent.reviewers.save(rvpath, rvs)
    if not integ["bad"]:
      agent.integrity.seal(mpath, mfiles)
    for n in agent.learned.refresh(state, ppath, apath, dpath, mpath, mfiles, integ, tpath, rvpath):
      msg = msg + "\n" + n
    return msg + ("\n" + err if err != "" else "")
  if sub == "tripwire" and len(parts) == 2:
    return agent.tripwire.listing(agent.tripwire.load(tpath))
  if sub == "fp" or sub == "polarity-error" or sub == "quarantine" or sub == "lift":
    tw = agent.tripwire.load(tpath)
    msg = ""
    if sub == "fp" and len(parts) == 7 and parts[6] == "owner":
      msg = agent.tripwire.fp(tw, parts[2], agent.tripwire.key_of(join(" ", split(parts[3], "_")), parts[4], join(" ", split(parts[5], "_"))))
    elif sub == "fp":
      return "fp refused: usage `patterns fp ID SUBJECT PREDICATE OBJECT owner`; only the owner confirms a false positive (reviewers can only quarantine)"
    elif sub == "polarity-error" and len(parts) == 4 and parts[3] == "owner":
      msg = agent.tripwire.polarity(tw, parts[2])
    elif sub == "polarity-error":
      return "polarity-error refused: usage `patterns polarity-error ID owner`"
    elif sub == "quarantine" and len(parts) == 4:
      msg = agent.tripwire.quarantine(tw, parts[2], parts[3])
    elif sub == "quarantine":
      return "quarantine refused: usage `patterns quarantine ID owner|REVIEWER`"
    elif len(parts) >= 5 and parts[3] == "owner":
      msg = agent.tripwire.lift(tw, parts[2], join(" ", parts[4:]))
    else:
      return "lift refused: usage `patterns lift ID owner NOTE...`; only the owner lifts, and a note is required"
    err = agent.tripwire.save(tpath, tw)
    if not integ["bad"]:
      agent.integrity.seal(mpath, mfiles)
    for n in agent.learned.refresh(state, ppath, apath, dpath, mpath, mfiles, integ, tpath, rvpath):
      msg = msg + "\n" + n
    return msg + ("\n" + err if err != "" else "")
  if sub == "predicate" and len(parts) == 5:
    rg = agent.registry.load(rpath)
    msg = agent.registry.declare(rg, parts[2], parts[3], parts[4])
    err = agent.registry.save(rpath, rg)
    return msg + ("\n" + err if err != "" else "")
  if sub == "type" and len(parts) == 5:
    rg = agent.registry.load(rpath)
    msg = agent.registry.evidence(rg, parts[2], parts[3], parts[4])
    err = agent.registry.save(rpath, rg)
    return msg + ("\n" + err if err != "" else "")
  if sub == "registry" and len(parts) == 2:
    return agent.registry.listing(agent.registry.load(rpath))
  if sub == "typecheck" and len(parts) == 2:
    return agent.registry.typecheck(agent.registry.load(rpath), state["rels"])
  if sub == "delegate" and len(parts) == 3:
    return agent.review.set_delegation(dpath, parts[2])
  if sub == "attest" and (len(parts) == 4 or len(parts) == 5):
    att = agent.review.load_att(apath)
    rec = null
    try:
      rec = json_load(parts[3])
    except:
      return "attestation refused: cannot read " + parts[3]
    rvs = agent.reviewers.load(rvpath)
    msg = agent.review.attest(att, st, parts[2], rec, len(parts) == 5 and parts[4] == "owner", rvs)
    agent.review.save_att(apath, att)
    if rvs["present"]:
      agent.reviewers.save(rvpath, rvs)
    agent.proposals.save(ppath, st)
    return msg
  if sub == "approve" and len(parts) == 3:
    msg = agent.review.approve(agent.review.load_att(apath), agent.review.load_del(dpath), st, parts[2], agent.reviewers.load(rvpath))
    agent.proposals.save(ppath, st)
    return msg
  if sub == "owner" and len(parts) == 4 and (parts[3] == "approve" or parts[3] == "reject"):
    msg = agent.review.owner(agent.review.load_att(apath), agent.review.load_del(dpath), st, parts[2], parts[3], agent.reviewers.load(rvpath))
    agent.proposals.save(ppath, st)
    return msg
  if sub == "activate" and len(parts) == 3:
    msg = agent.learned.activate(st, agent.review.load_att(apath), agent.review.load_del(dpath), parts[2], agent.tripwire.load(tpath), agent.reviewers.load(rvpath))
    agent.proposals.save(ppath, st)
    return msg
  if sub == "learned" and len(parts) == 2:
    return agent.learned.view(state, st, lpath)
  if sub == "revoke" and len(parts) == 3:
    msg = agent.review.revoke(st, parts[2])
    agent.proposals.save(ppath, st)
    return msg
  if (sub == "reject" or sub == "reopen") and len(parts) == 3:
    msg = ""
    if sub == "reject":
      msg = agent.proposals.reject(st, parts[2])
    else:
      msg = agent.proposals.reopen(st, parts[2])
    agent.proposals.save(ppath, st)
    return msg
  if sub == "retract" and len(parts) > 2:
    msg = agent.proposals.retract(st, join(" ", parts[2:]))
    agent.proposals.save(ppath, st)
    return msg
  return "patterns: list | derive FILE | shadow ID | unshadow ID | review ID | sensitive SRC | unsensitive SRC | samples on|off | lineage A B REL STATE BY | delegate FILE | attest ID FILE [owner] | approve ID | owner ID approve|reject | manifest accept | predicate P SUBJTYPE OBJTYPE | type ENTITY TYPE declared|inferred|verified | registry | typecheck | reviewers | budget FAMILY MAXC MAXW owner | reinstate FAMILY owner NOTE | canary FAMILY CASES ANSWERS owner | tripwire | fp ID S P O owner | polarity-error ID owner | quarantine ID owner|REVIEWER | lift ID owner NOTE | activate ID | learned | revoke ID | origin SRC ORIGIN CLASS [RELATION] | disposition ID EVENT DISP REVIEWER [WHY] | reject ID | reopen ID | retract TEXT"
# A21.0 shadow hook: after every non-patterns command, newly ingested
# read sources are shadow-tested against SHADOWED candidates. It only
# reads the stored bodies and writes the proposals file; the reply
# already printed is never affected.
seen = {}
logged = 0
def shadow_pass(state, seen):
  todo = []
  for src in keys(state["read_src"]):
    body = state["read_src"][src]
    if not has(seen, src) or seen[src] != body:
      append(todo, src)
  if len(todo) == 0:
    return 0
  st = agent.proposals.load(ppath)
  n = 0
  for src in todo:
    seen[src] = state["read_src"][src]
    n = n + agent.shadow.process(state, st, src, state["read_src"][src])
  if n > 0 or len(st["sensitive"]) > 0:
    agent.proposals.save(ppath, st)
  return n
done = false
while not done:
  line = ""
  try:
    line = input()
  except:
    done = true
  if not done:
    m = agent.core.lower_ascii(agent.core.normalize(line))
    if m == "quit" or m == "exit":
      done = true
    elif m[:9] == "read url " and len(line) > 9:
      # EXPERIMENTAL: network code lives in agent.fetch (full routes
      # only); the core's own read-url route handles validation for
      # the corpus and never touches tcp builtins.
      print agent.fetch.read_url(state, line[9:])
    elif m == "patterns manifest accept":
      n = agent.integrity.seal(mpath, mfiles)
      integ["bad"] = false
      integ["noted"] = false
      print "manifest accepted: " + str(n) + " file(s) sealed (change detection only, not tamper-proof)"
    elif m[:9] == "patterns " or m == "patterns":
      # A20 EXPERIMENTAL: offline pattern candidates. Repl-only, the
      # core never sees them; proposals live in their own file.
      if not integ["bad"]:
        integ["bad"] = len(agent.integrity.verify(mpath, mfiles)) > 0
      print patterns_cmd(line)
    else:
      for note in agent.learned.refresh(state, ppath, apath, dpath, mpath, mfiles, integ, tpath, rvpath):
        print note
      print agent.core.respond(state, line)
    if not done and not (m[:9] == "patterns " or m == "patterns"):
      shadow_pass(state, seen)
      if "learned_readings" in state and len(state["learned_readings"]) > logged:
        was = logged
        logged = agent.learned.log_new(state, agent.proposals.load(ppath), lpath, logged)
        tw = agent.tripwire.load(tpath)
        for e in state["learned_readings"][was:]:
          if not e[7]:
            agent.tripwire.observe(tw, e[4], agent.tripwire.key_of(e[0], e[1], e[2]))
        agent.tripwire.save(tpath, tw)
    if not done and not (m[:9] == "patterns " or m == "patterns") and "learned" in state and len(state["learned"]) > 0:
      tw = agent.tripwire.load(tpath)
      lr = []
      if "learned_readings" in state:
        lr = state["learned_readings"]
      agent.tripwire.event(tw, line, lr)
      agent.tripwire.save(tpath, tw)
    if not done and not integ["bad"] and (m[:9] == "patterns " or "learned" in state and len(state["learned"]) > 0):
      agent.integrity.seal(mpath, mfiles)
if not integ["bad"]:
  agent.integrity.seal(mpath, mfiles)
agent.store.save(state, path)
print "bye"
