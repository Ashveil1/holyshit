# agent/repl.holy — chat with the local agent in a terminal.
#
# Run from the repo root:  hs run agent/repl.holy
# (or: python3 interp.py agent/repl.holy)
#
# Memory persists to agent-memory.json in the current directory when the
# chat ends (type `quit`, or ctrl-d). Type `help` inside for commands.
# This is a thin IO shell: every reply comes from agent.core.respond.
import agent.core
import agent.store
path = "agent-memory.json"
state = agent.store.load(path)
# A18 EXPERIMENTAL: the fetch test harness is reachable only by
# starting the repl with HS_AGENT_TEST_FETCH=1 in the environment.
# The core never probes the environment itself (IR-subset routes
# have no env builtin), so no ordinary command can set this flag.
tfv = env("HS_AGENT_TEST_FETCH")
state["test_fetch"] = tfv != null and tfv == "1"
print "holyshit agent v0.12 - type 'help' for commands, 'quit' to leave"
done = false
while not done:
  line = ""
  try:
    line = input()
  except:
    done = true
  if not done:
    m = agent.core.lower_ascii(agent.core.normalize(line))
    if m == "quit" or m == "exit":
      done = true
    else:
      print agent.core.respond(state, line)
agent.store.save(state, path)
print "bye"
