// Weightless text classifier (RAM-table per class over hashed unigrams+bigrams).
// SNIPS 7-intent benchmark. Pure holyshit, no floats in the model, U8 tables.

def newbuf(n):
  unsafe:
    Ptr p = alloc(n)
    return as_int(p)

def st16(buf, i, v):
  unsafe:
    Ptr p = as_ptr(buf) + (i * 2)
    store8(p, v & 255)
    store8(p + 1, (v >> 8) & 255)

def fnv(tok):
  // FNV-1a over raw bytes, folded to 16 bits
  h = 2166136261
  n = len(tok)
  unsafe:
    Ptr p = as_ptr(tok) + 16
    I64 hh = h
    I64 i = 0
    while i < n:
      hh = (hh ^ load8(p + i)) * 16777619
      hh = hh & 17592186044415
      i = i + 1
    return as_int(hh & 65535)

def main():
  args = argv()
  train_path = "snips_train.txt"
  test_path = "snips_test.txt"
  if len(args) > 0:
    train_path = args[0]
  if len(args) > 1:
    test_path = args[1]

  NC = 7
  tables = newbuf(NC * 65536)
  fbuf = newbuf(256 * 2)
  sbuf = newbuf(8 * 8)   // up to 128 features (uni+bi) per doc, U16
  tots = []
  c = 0
  while c < NC:
    append(tots, 0)
    c = c + 1

  raw = read_text(train_path)
  lines = split(raw, "\n")
  n = int(split(lines[0], " ")[0])
  print "train", n
  i = 0
  while i < n:
    ln = lines[i + 1]
    if len(ln) > 2:
      bar = find(ln, "|")
      cls = int(ln[0:bar])
      toks = split(ln[bar + 1:], " ")
      nf = 0
      prev = 0 - 1
      k = 0
      while k < len(toks):
        h = fnv(toks[k])
        st16(fbuf, nf, h)
        nf = nf + 1
        if prev >= 0:
          st16(fbuf, nf, (prev * 32749 + h) & 65535)
          nf = nf + 1
        prev = h
        k = k + 1
      tots[cls] = tots[cls] + nf
      unsafe:
        Ptr fb = as_ptr(fbuf)
        Ptr tb = as_ptr(tables)
        Ptr cb = tb + (cls * 65536)
        I64 q0 = 0
        while q0 < nf:
          I64 fid = load8(fb) + (load8(fb + 1) * 256)
          fb = fb + 2
          I64 cnt = load8(cb + fid)
          if cnt < 255:
            store8(cb + fid, cnt + 1)
          q0 = q0 + 1
    i = i + 1

  raw2 = read_text(test_path)
  lines2 = split(raw2, "\n")
  m = int(split(lines2[0], " ")[0])
  print "test", m
  correct = 0
  i = 0
  while i < m:
    ln = lines2[i + 1]
    if len(ln) > 2:
      bar = find(ln, "|")
      cls = int(ln[0:bar])
      toks = split(ln[bar + 1:], " ")
      nf = 0
      prev = 0 - 1
      k = 0
      while k < len(toks):
        h = fnv(toks[k])
        st16(fbuf, nf, h)
        nf = nf + 1
        if prev >= 0:
          st16(fbuf, nf, (prev * 32749 + h) & 65535)
          nf = nf + 1
        prev = h
        k = k + 1
      // score all classes in one unsafe block: capped-count sums into sbuf
      unsafe:
        Ptr sb2 = as_ptr(sbuf)
        Ptr fb2 = as_ptr(fbuf)
        Ptr tb3 = as_ptr(tables)
        I64 c5 = 0
        while c5 < NC:
          Ptr cb2 = tb3 + (c5 * 65536)
          I64 scc = 0
          I64 qq = 0
          while qq < nf:
            I64 fid2 = load8(fb2 + (qq * 2)) + (load8(fb2 + (qq * 2) + 1) * 256)
            I64 cv = load8(cb2 + fid2)
            if cv > 4:
              cv = 4
            scc = scc + cv
            qq = qq + 1
          store64(sb2 + (c5 * 8), scc)
          c5 = c5 + 1
      best = 0
      bests = 0 - 1
      c = 0
      while c < NC:
        sc = 0
        unsafe:
          Ptr sb3 = as_ptr(sbuf) + (c * 8)
          sc = as_int(load64(sb3))
        sc = (sc * 1000000) / tots[c]
        if sc > bests:
          bests = sc
          best = c
        c = c + 1
      if best == cls:
        correct = correct + 1
    i = i + 1
  print "acc", correct, "/", m

main()
