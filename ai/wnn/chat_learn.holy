// P3: learning chatbot - weightless intent classifier PLUS one-shot episodic
// memory: "learn: <question> -> <answer>" stores a new fact in a single shot
// (HDC bag-of-words hypervector key + stored answer text); later questions
// that match the key closely enough get the learned answer, forever, with no
// retraining and no effect on existing behavior. Honest scope stands.
// Base: tiny retrieval-style chatbot in pure holyshit (see chat.holy).

def newbuf(n):
  unsafe:
    Ptr p = alloc(n)
    return as_int(p)

def st16(buf, i, v):
  unsafe:
    Ptr p = as_ptr(buf) + (i * 2)
    store8(p, v & 255)
    store8(p + 1, (v >> 8) & 255)

def fnv(tok):
  h = 2166136261
  n = len(tok)
  unsafe:
    Ptr p = as_ptr(tok) + 16
    I64 hh = h
    I64 i = 0
    while i < n:
      hh = (hh ^ load8(p + i)) * 16777619
      hh = hh & 17592186044415
      i = i + 1
    return as_int(hh & 65535)

def xr_next(state):
  state = state ^ ((state << 13) & 17592186044415)
  state = state ^ (state >> 7)
  state = state ^ ((state << 17) & 17592186044415)
  return state

def normalize(line, nbuf):
  // lowercase, map non-alnum to space, write bytes into nbuf; returns length
  n = len(line)
  unsafe:
    Ptr ip = as_ptr(line) + 16
    Ptr op = as_ptr(nbuf)
    I64 i = 0
    while i < n:
      I64 c = load8(ip + i)
      if c >= 65:
        if c <= 90:
          c = c + 32
      I64 ok = 0
      if c >= 97:
        if c <= 122:
          ok = 1
      if c >= 48:
        if c <= 57:
          ok = 1
      if c == 32:
        ok = 1
      if ok == 0:
        c = 32
      store8(op + i, c)
      i = i + 1
    return as_int(n)

def hash44(s):
  n = len(s)
  unsafe:
    Ptr p = as_ptr(s) + 16
    I64 h = 1469598103
    I64 i = 0
    while i < n:
      h = (h * 1099511) ^ load8(p + i)
      h = h & 17592186044415
      i = i + 1
    return as_int(h)

def hv_accum_word(accbuf, seed, DIM):
  // accum[d] += +1/-1 from the word's hypervector bits (I16 accum)
  unsafe:
    Ptr ap = as_ptr(accbuf)
    I64 s = seed
    I64 d = 0
    while d < DIM:
      s = s ^ ((s << 13) & 17592186044415)
      s = s ^ (s >> 7)
      s = s ^ ((s << 17) & 17592186044415)
      Ptr q = ap + (d * 2)
      I64 cur = load8(q) + (load8(q + 1) * 256)
      I64 bit = s % 2
      if bit == 1:
        cur = cur + 1
      else:
        cur = cur - 1
      if cur < 0:
        cur = cur + 65536
      store8(q, cur & 255)
      store8(q + 1, (cur >> 8) & 255)
      d = d + 1

def hv_sign_to(accbuf, outbuf, DIM):
  unsafe:
    Ptr ap2 = as_ptr(accbuf)
    Ptr op2 = as_ptr(outbuf)
    I64 d2 = 0
    while d2 < DIM:
      I64 v2 = load8(ap2 + (d2 * 2)) + (load8(ap2 + (d2 * 2) + 1) * 256)
      if v2 >= 32768:
        v2 = v2 - 65536
      store8(op2 + d2, v2 >= 0)
      d2 = d2 + 1

def hv_zero(accbuf, DIM):
  unsafe:
    Ptr ap3 = as_ptr(accbuf)
    I64 d3 = 0
    while d3 < DIM:
      store8(ap3 + (d3 * 2), 0)
      store8(ap3 + (d3 * 2) + 1, 0)
      d3 = d3 + 1

def hv_hamming(ekbuf, slot, qbuf, DIM):
  unsafe:
    Ptr ep = as_ptr(ekbuf) + (slot * DIM)
    Ptr qp = as_ptr(qbuf)
    I64 dist = 0
    I64 d4 = 0
    while d4 < DIM:
      if load8(ep + d4) != load8(qp + d4):
        dist = dist + 1
      d4 = d4 + 1
    return dist

def strip(s):
  a = 0
  b = len(s)
  while a < b and s[a:a+1] == " ":
    a = a + 1
  while b > a and s[b-1:b] == " ":
    b = b - 1
  return s[a:b]

def main():
  NC = 10
  tables = newbuf(NC * 65536)
  fbuf = newbuf(512 * 2)
  sbuf = newbuf(16 * 8)
  nbuf = newbuf(4096)
  tots = []
  c = 0
  while c < NC:
    append(tots, 0)
    c = c + 1

  raw = read_text("chat_train.txt")
  lines = split(raw, "\n")
  n = int(split(lines[0], " ")[0])
  i = 0
  while i < n:
    ln = lines[i + 1]
    if len(ln) > 2:
      bar = find(ln, "|")
      cls = int(ln[0:bar])
      toks = split(ln[bar + 1:], " ")
      nf = 0
      prev = 0 - 1
      k = 0
      while k < len(toks):
        h = fnv(toks[k])
        st16(fbuf, nf, h)
        nf = nf + 1
        if prev >= 0:
          st16(fbuf, nf, (prev * 32749 + h) & 65535)
          nf = nf + 1
        prev = h
        k = k + 1
      tots[cls] = tots[cls] + nf
      unsafe:
        Ptr fb = as_ptr(fbuf)
        Ptr tb = as_ptr(tables)
        Ptr cb = tb + (cls * 65536)
        I64 q0 = 0
        while q0 < nf:
          I64 fid = load8(fb) + (load8(fb + 1) * 256)
          fb = fb + 2
          I64 cnt = load8(cb + fid)
          if cnt < 255:
            store8(cb + fid, cnt + 1)
          q0 = q0 + 1
    i = i + 1

  // responses: resp[label] = [r1, r2, ...]
  resp = []
  rraw = read_text("chat_resp.txt")
  rlines = split(rraw, "\n")
  nr = int(rlines[0])
  i = 0
  while i < nr:
    ln = rlines[i + 1]
    bar = find(ln, "|")
    rest = ln[bar + 1:]
    bar2 = find(rest, "|")
    body = rest[bar2 + 1:]
    append(resp, split(body, "||"))
    i = i + 1

  // episodic one-shot memory: hv keys + answer strings
  DIM = 4096
  MAXE = 200
  ekbuf = newbuf(MAXE * DIM)
  accbuf = newbuf(DIM * 2)
  qbuf = newbuf(DIM)
  answers = []
  ecount = 0

  print "weightless chat (hs) - type 'quit' to exit"
  print "teach me: 'learn: some question -> the answer'"
  rng = 123456789
  running = 1
  while running == 1:
    print "> "
    line = input()
    if line == "quit":
      running = 0
    if line != "quit":
      if len(line) > 5 and line[0:6] == "learn:":
        rest = strip(line[6:])
        arrow = find(rest, "->")
        if arrow > 0:
          key = strip(rest[0:arrow])
          val = strip(rest[arrow + 2:])
          nn2 = normalize(key, nbuf)
          nline2 = read_mem(nbuf, nn2)
          toks2 = split(nline2, " ")
          hv_zero(accbuf, DIM)
          k2 = 0
          while k2 < len(toks2):
            if len(toks2[k2]) > 0:
              hv_accum_word(accbuf, hash44(toks2[k2]) + 555, DIM)
            k2 = k2 + 1
          hv_sign_to(accbuf, qbuf, DIM)
          unsafe:
            Ptr ekw = as_ptr(ekbuf) + (ecount * DIM)
            Ptr qpw = as_ptr(qbuf)
            I64 dw = 0
            while dw < DIM:
              store8(ekw + dw, load8(qpw + dw))
              dw = dw + 1
          append(answers, val)
          ecount = ecount + 1
          print "learned fact", ecount, ":", key, "->", val
        if arrow <= 0:
          print "usage: learn: question -> answer"
      is_learn = 0
      if len(line) > 5:
        if line[0:6] == "learn:":
          is_learn = 1
      if len(line) > 0 and is_learn == 0:
        nn = normalize(line, nbuf)
        nline = read_mem(nbuf, nn)
        toks = split(nline, " ")
        nf = 0
        prev = 0 - 1
        k = 0
        while k < len(toks):
          if len(toks[k]) > 0:
            h = fnv(toks[k])
            st16(fbuf, nf, h)
            nf = nf + 1
            if prev >= 0:
              st16(fbuf, nf, (prev * 32749 + h) & 65535)
              nf = nf + 1
            prev = h
          k = k + 1
        // episodic recall first: does this match a learned fact?
        ebest = 0 - 1
        edist = DIM + 1
        if ecount > 0:
          hv_zero(accbuf, DIM)
          k3 = 0
          while k3 < len(toks):
            if len(toks[k3]) > 0:
              hv_accum_word(accbuf, hash44(toks[k3]) + 555, DIM)
            k3 = k3 + 1
          hv_sign_to(accbuf, qbuf, DIM)
          ei = 0
          while ei < ecount:
            dd = hv_hamming(ekbuf, ei, qbuf, DIM)
            if dd < edist:
              edist = dd
              ebest = ei
            ei = ei + 1
        answered = 0
        if ebest >= 0:
          if edist < 1400:
            print answers[ebest]
            answered = 1
        if answered == 0:
          unsafe:
            Ptr sb2 = as_ptr(sbuf)
            Ptr fb2 = as_ptr(fbuf)
            Ptr tb3 = as_ptr(tables)
            I64 c5 = 0
            while c5 < NC:
              Ptr cb2 = tb3 + (c5 * 65536)
              I64 scc = 0
              I64 qq = 0
              while qq < nf:
                I64 fid2 = load8(fb2 + (qq * 2)) + (load8(fb2 + (qq * 2) + 1) * 256)
                I64 cv = load8(cb2 + fid2)
                if cv > 4:
                  cv = 4
                scc = scc + cv
                qq = qq + 1
              store64(sb2 + (c5 * 8), scc)
              c5 = c5 + 1
          best = 0
          bests = 0 - 1
          c = 0
          while c < NC:
            sc = 0
            unsafe:
              Ptr sb3 = as_ptr(sbuf) + (c * 8)
              sc = as_int(load64(sb3))
            sc = (sc * 1000) / nf
            if sc > bests:
              bests = sc
              best = c
            c = c + 1
          if bests < 250:
            print "I don't know that yet - teach me with: learn: your question -> the answer"
          if bests >= 250:
            rng = xr_next(rng)
            rl = resp[best]
            print rl[rng % len(rl)]

main()
