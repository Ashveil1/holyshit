// Tiny retrieval-style chatbot in pure holyshit: weightless intent classifier
// (hashed unigram+bigram RAM tables) + per-intent response templates.
// Honest scope: recognizes trained intents, falls back otherwise. Not an LLM.

def newbuf(n):
  unsafe:
    Ptr p = alloc(n)
    return as_int(p)

def st16(buf, i, v):
  unsafe:
    Ptr p = as_ptr(buf) + (i * 2)
    store8(p, v & 255)
    store8(p + 1, (v >> 8) & 255)

def fnv(tok):
  h = 2166136261
  n = len(tok)
  unsafe:
    Ptr p = as_ptr(tok) + 16
    I64 hh = h
    I64 i = 0
    while i < n:
      hh = (hh ^ load8(p + i)) * 16777619
      hh = hh & 17592186044415
      i = i + 1
    return as_int(hh & 65535)

def xr_next(state):
  state = state ^ ((state << 13) & 17592186044415)
  state = state ^ (state >> 7)
  state = state ^ ((state << 17) & 17592186044415)
  return state

def normalize(line, nbuf):
  // lowercase, map non-alnum to space, write bytes into nbuf; returns length
  n = len(line)
  unsafe:
    Ptr ip = as_ptr(line) + 16
    Ptr op = as_ptr(nbuf)
    I64 i = 0
    while i < n:
      I64 c = load8(ip + i)
      if c >= 65:
        if c <= 90:
          c = c + 32
      I64 ok = 0
      if c >= 97:
        if c <= 122:
          ok = 1
      if c >= 48:
        if c <= 57:
          ok = 1
      if c == 32:
        ok = 1
      if ok == 0:
        c = 32
      store8(op + i, c)
      i = i + 1
    return as_int(n)

def main():
  NC = 10
  tables = newbuf(NC * 65536)
  fbuf = newbuf(512 * 2)
  sbuf = newbuf(16 * 8)
  nbuf = newbuf(4096)
  tots = []
  c = 0
  while c < NC:
    append(tots, 0)
    c = c + 1

  raw = read_text("chat_train.txt")
  lines = split(raw, "\n")
  n = int(split(lines[0], " ")[0])
  i = 0
  while i < n:
    ln = lines[i + 1]
    if len(ln) > 2:
      bar = find(ln, "|")
      cls = int(ln[0:bar])
      toks = split(ln[bar + 1:], " ")
      nf = 0
      prev = 0 - 1
      k = 0
      while k < len(toks):
        h = fnv(toks[k])
        st16(fbuf, nf, h)
        nf = nf + 1
        if prev >= 0:
          st16(fbuf, nf, (prev * 32749 + h) & 65535)
          nf = nf + 1
        prev = h
        k = k + 1
      tots[cls] = tots[cls] + nf
      unsafe:
        Ptr fb = as_ptr(fbuf)
        Ptr tb = as_ptr(tables)
        Ptr cb = tb + (cls * 65536)
        I64 q0 = 0
        while q0 < nf:
          I64 fid = load8(fb) + (load8(fb + 1) * 256)
          fb = fb + 2
          I64 cnt = load8(cb + fid)
          if cnt < 255:
            store8(cb + fid, cnt + 1)
          q0 = q0 + 1
    i = i + 1

  // responses: resp[label] = [r1, r2, ...]
  resp = []
  rraw = read_text("chat_resp.txt")
  rlines = split(rraw, "\n")
  nr = int(rlines[0])
  i = 0
  while i < nr:
    ln = rlines[i + 1]
    bar = find(ln, "|")
    rest = ln[bar + 1:]
    bar2 = find(rest, "|")
    body = rest[bar2 + 1:]
    append(resp, split(body, "||"))
    i = i + 1

  print "weightless chat (hs) - type 'quit' to exit"
  rng = 123456789
  running = 1
  while running == 1:
    print "> "
    line = input()
    if line == "quit":
      running = 0
    if line != "quit":
      if len(line) > 0:
        nn = normalize(line, nbuf)
        nline = read_mem(nbuf, nn)
        toks = split(nline, " ")
        nf = 0
        prev = 0 - 1
        k = 0
        while k < len(toks):
          if len(toks[k]) > 0:
            h = fnv(toks[k])
            st16(fbuf, nf, h)
            nf = nf + 1
            if prev >= 0:
              st16(fbuf, nf, (prev * 32749 + h) & 65535)
              nf = nf + 1
            prev = h
          k = k + 1
        unsafe:
          Ptr sb2 = as_ptr(sbuf)
          Ptr fb2 = as_ptr(fbuf)
          Ptr tb3 = as_ptr(tables)
          I64 c5 = 0
          while c5 < NC:
            Ptr cb2 = tb3 + (c5 * 65536)
            I64 scc = 0
            I64 qq = 0
            while qq < nf:
              I64 fid2 = load8(fb2 + (qq * 2)) + (load8(fb2 + (qq * 2) + 1) * 256)
              I64 cv = load8(cb2 + fid2)
              if cv > 4:
                cv = 4
              scc = scc + cv
              qq = qq + 1
            store64(sb2 + (c5 * 8), scc)
            c5 = c5 + 1
        best = 0
        bests = 0 - 1
        c = 0
        while c < NC:
          sc = 0
          unsafe:
            Ptr sb3 = as_ptr(sbuf) + (c * 8)
            sc = as_int(load64(sb3))
          sc = (sc * 1000) / nf
          if sc > bests:
            bests = sc
            best = c
          c = c + 1
        if bests < 250:
          print "I don't know how to answer that yet - I only recognize what I was trained on. Ask 'help' to see what that is."
        if bests >= 250:
          rng = xr_next(rng)
          rl = resp[best]
          print rl[rng % len(rl)]

main()
