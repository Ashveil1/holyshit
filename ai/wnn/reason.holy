// P6: a working-memory procedure machine that LEARNS arithmetic procedures
// from demonstration traces (ACT-R style: learned production policy + learned
// declarative facts). Port of the core of reason.py (add + sub).
// GIVEN: primitive actions READ/FACT/WRITE/ADV/HALT, the digit tapes, the
// carry abstraction (zero/nonzero) in the policy observation, the teacher
// that emits traces, the counting demos 0..9, and the "add/sub = count
// forward/back" derivation. LEARNED: the policy (obs -> action, majority
// vote) and the (op,x,y,carry) -> (digit,carry') fact table.
// Output on 1-3 digit operands matches reason.py exactly (same RNG, split).

def xr_next(state):
  state = state ^ ((state << 13) & 17592186044415)
  state = state ^ (state >> 7)
  state = state ^ ((state << 17) & 17592186044415)
  return state

// rng state kept in a 1-element list
def rnext(r, n):
  r[0] = xr_next(r[0] + 1)
  return r[0] % n

def pow10(n):
  p = 1
  i = 0
  while i < n:
    p = p * 10
    i = i + 1
  return p


def digits_of(n):
  d = []
  m = n
  while true:
    d.append(m % 10)
    m = div10(m)
    if m == 0:
      break
  return d

def undigits(d):
  v = 0
  i = len(d) - 1
  while i >= 0:
    v = v * 10 + d[i]
    i = i - 1
  return v

def true_fact(op, x, y, c):
  // returns out*10 + c2 ; op 0 add, 1 sub
  if op == 0:
    t = x + y + c
    return (t % 10) * 10 + div10(t)
  t = x - y - c
  if t < 0:
    return (t + 10) * 10 + 1
  return t * 10

def div10(v):
  return int((v - (v % 10)) / 10)

def b(v):
  if v:
    return 1
  return 0

def pair_is_test(a, bb):
  return (a * 31 + bb * 17) % 4 == 0

def num(r, nd):
  if nd == 1:
    return rnext(r, 10)
  return pow10(nd - 1) + rnext(r, 9 * pow10(nd - 1))

// returns [a, b]
def sample_pair(r, na, nb, want_test):
  while true:
    a = num(r, na)
    b = num(r, nb)
    if na > 3 or nb > 3:
      return [a, b]
    if pair_is_test(a, b) == want_test:
      return [a, b]

def obs_idx(op, last, abl, bbl, cnz, ho):
  return ((((op * 6 + last) * 2 + abl) * 2 + bbl) * 2 + cnz) * 2 + ho

// actions: 0 READ 1 FACT 2 WRITE 3 ADV 4 HALT ; last: 5 = START
def vote(pol, o, a):
  pol[o * 5 + a] = pol[o * 5 + a] + 1

def watch(pol, fo, fc, op, A, B):
  c = 0
  i = 0
  last = 5
  ho = 0
  abl = 0
  bbl = 0
  while true:
    vote(pol, obs_idx(op, last, abl, bbl, b(c != 0), ho), 0)
    last = 0
    abl = b(i >= len(A))
    bbl = b(i >= len(B))
    x = 0
    if not abl:
      x = A[i]
    y = 0
    if not bbl:
      y = B[i]
    if abl and bbl and c == 0:
      vote(pol, obs_idx(op, last, abl, bbl, b(c != 0), ho), 4)
      return 0
    vote(pol, obs_idx(op, last, abl, bbl, b(c != 0), ho), 1)
    last = 1
    t = true_fact(op, x, y, c)
    k = ((op * 10 + x) * 10 + y) * 10 + c
    fo[k] = div10(t) + 1
    fc[k] = t % 10
    c = t % 10
    ho = 1
    vote(pol, obs_idx(op, last, abl, bbl, b(c != 0), ho), 2)
    last = 2
    vote(pol, obs_idx(op, last, abl, bbl, b(c != 0), ho), 3)
    last = 3
    i = i + 1
    ho = 0

// majority action, -1 if unseen (ties -> lower action id, like reason.py)
def policy(pol, o):
  best = -1
  bc = 0
  a = 0
  while a < 5:
    n = pol[o * 5 + a]
    if n > bc:
      bc = n
      best = a
    a = a + 1
  return best

// derive x+y+c / x-y-c by counting with learned successor (succ = (x+1)%10)
// returns out*10+c2, or -1
def fact(fo, fc, op, x, y, c, derive):
  k = ((op * 10 + x) * 10 + y) * 10 + c
  if fo[k] > 0:
    return (fo[k] - 1) * 10 + fc[k]
  if not derive:
    return -1
  n = y + c
  v = x
  w = 0
  i = 0
  while i < n:
    if op == 0:
      if v == 9:
        w = 1
      v = (v + 1) % 10
    else:
      if v == 0:
        w = 1
      v = (v + 9) % 10
    i = i + 1
  return v * 10 + w

// returns digits list (LSB first); fails -> empty list with marker -1 appended
def run(pol, fo, fc, op, A, B, derive):
  out = []
  c = 0
  i = 0
  last = 5
  ho = 0
  abl = 0
  bbl = 0
  x = 0
  y = 0
  pend = 0
  steps = 0
  while steps < 100000:
    steps = steps + 1
    act = policy(pol, obs_idx(op, last, abl, bbl, b(c != 0), ho))
    if act < 0:
      return [-1]
    if act == 4:
      return out
    if act == 0:
      abl = b(i >= len(A))
      bbl = b(i >= len(B))
      x = 0
      if not abl:
        x = A[i]
      y = 0
      if not bbl:
        y = B[i]
    if act == 1:
      t = fact(fo, fc, op, x, y, c, derive)
      if t < 0:
        return [-1]
      pend = div10(t)
      c = t % 10
      ho = 1
    if act == 2:
      out.append(pend)
    if act == 3:
      i = i + 1
      ho = 0
    last = act
  return [-1]

def train(n_demo, seed, pol, fo, fc):
  r = [seed]
  j = 0
  while j < n_demo:
    rnext(r, 1)
    na = 1 + rnext(r, 3)
    nb = 1 + rnext(r, 3)
    p = sample_pair(r, na, nb, false)
    watch(pol, fo, fc, 0, digits_of(p[0]), digits_of(p[1]))
    j = j + 1

def rand_digits(r, n):
  d = []
  i = 0
  while i < n:
    d.append(rnext(r, 10))
    i = i + 1
  if d[n - 1] == 0:
    d[n - 1] = 1 + rnext(r, 9)
  return d

// independent schoolbook check for long operands (separate code path)
def check_add(A, B, out):
  c = 0
  i = 0
  n = len(A)
  while i < n:
    s = A[i] + B[i] + c
    if i >= len(out):
      return false
    if out[i] != s % 10:
      return false
    c = div10(s)
    i = i + 1
  if c == 1:
    if len(out) != n + 1:
      return false
    return out[n] == 1
  return len(out) == n

def eval_len(pol, fo, fc, nd, n, seed, test_split):
  r = [seed]
  ok = 0
  j = 0
  while j < n:
    if nd <= 3:
      p = sample_pair(r, nd, nd, test_split)
      o = run(pol, fo, fc, 0, digits_of(p[0]), digits_of(p[1]), true)
      if len(o) > 0 and o[0] >= 0:
        if undigits(o) == p[0] + p[1]:
          ok = ok + 1
    else:
      A = rand_digits(r, nd)
      B = rand_digits(r, nd)
      o = run(pol, fo, fc, 0, A, B, true)
      if len(o) > 0 and o[0] >= 0:
        if check_add(A, B, o):
          ok = ok + 1
    j = j + 1
  return ok

def main():
  pol = []
  i = 0
  while i < 384 * 5:
    pol.append(0)
    i = i + 1
  fo = []
  fc = []
  i = 0
  while i < 4000:
    fo.append(0)
    fc.append(0)
    i = i + 1
  train(200, 5, pol, fo, fc)
  npol = 0
  i = 0
  while i < 384:
    s = 0
    a = 0
    while a < 5:
      s = s + pol[i * 5 + a]
      a = a + 1
    if s > 0:
      npol = npol + 1
    i = i + 1
  nf = 0
  x = 0
  while x < 10:
    y = 0
    while y < 10:
      c = 0
      while c < 2:
        if fo[(x * 10 + y) * 10 + c] > 0:
          nf = nf + 1
        c = c + 1
      y = y + 1
    x = x + 1
  print "learned policy entries", npol, " facts stored (add)", nf, "/ 200"
  print "T2 addition, 200 demo traces; accuracy /300 unseen operands"
  nd = 1
  while nd <= 3:
    print "  digits", nd, "held-out pairs:", eval_len(pol, fo, fc, nd, 300, 100 + nd, true), "/ 300"
    nd = nd + 1
  lens = [4, 6, 10, 20, 50]
  for L in lens:
    print "  digits", L, "length-generalization:", eval_len(pol, fo, fc, L, 300, 200 + L, false), "/ 300"
  // lookup-only (no successor derivation) for contrast
  r = [900]
  ok = 0
  j = 0
  while j < 100:
    A = rand_digits(r, 6)
    B = rand_digits(r, 6)
    o = run(pol, fo, fc, 0, A, B, false)
    if len(o) > 0 and o[0] >= 0:
      if check_add(A, B, o):
        ok = ok + 1
    j = j + 1
  print "  6 digits, stored facts only (no counting):", ok, "/ 100"
  // subtraction: its own demos on the same policy table
  pol2 = []
  i = 0
  while i < 384 * 5:
    pol2.append(0)
    i = i + 1
  fo2 = []
  fc2 = []
  i = 0
  while i < 4000:
    fo2.append(0)
    fc2.append(0)
    i = i + 1
  r = [77]
  j = 0
  while j < 200:
    rnext(r, 1)
    na = 1 + rnext(r, 3)
    nb = 1 + rnext(r, 3)
    p = sample_pair(r, na, nb, false)
    a = p[0]
    b = p[1]
    if a < b:
      t = a
      a = b
      b = t
    watch(pol2, fo2, fc2, 1, digits_of(a), digits_of(b))
    j = j + 1
  r = [555]
  ok = 0
  tot = 0
  j = 0
  while j < 300:
    p = sample_pair(r, 3, 3, true)
    a = p[0]
    b = p[1]
    if a < b:
      t = a
      a = b
      b = t
    o = run(pol2, fo2, fc2, 1, digits_of(a), digits_of(b), true)
    if len(o) > 0 and o[0] >= 0:
      if undigits(o) == a - b:
        ok = ok + 1
    tot = tot + 1
    j = j + 1
  print "T3 subtraction (3 digits, held-out pairs, borrow):", ok, "/", tot
main()
