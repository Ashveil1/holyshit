// P4b: LIF spiking neurons on the real C. elegans connectome.
// Graded linear model could not produce tap habituation (worm_plastic.holy);
// spiking + short-term synaptic depression is the published mechanism.
// LIF: v += input - leak*v; spike at v>=1, reset. Chemical synapse: pre spike
// injects w*dep into post; gap junction: resistive coupling. STD: pre spike
// -> dep *= 0.8, slow recovery. Hebbian: pre+post spike same step -> wpl up.
// Tests: T1 tap habituation/recovery/dishabituation (AVD spike count),
//        T2 Hebbian association ALM+PLM -> ALM alone evokes PVC.

def clamp(x, lo, hi):
  if x < lo:
    return lo
  if x > hi:
    return hi
  return x

// returns [v, spk, avd_spikes, pvc_spikes]
def sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, do_plastic):
  // synaptic input from last step's spikes
  inp = []
  i = 0
  while i < N:
    append(inp, ext[i])
    i = i + 1
  // gap junction coupling on membrane potentials (continuous)
  p = 0
  while p < N:
    k = instart[p]
    kend = instart[p + 1]
    while k < kend:
      if ingap[k] == 1:
        inp[p] = inp[p] + inw[k] * wpl[k] * (v[inpre[k]] - v[p])
      k = k + 1
    p = p + 1
  // chemical: spikes inject current
  p = 0
  while p < N:
    k = instart[p]
    kend = instart[p + 1]
    while k < kend:
      if ingap[k] == 0:
        if spk[inpre[k]] == 1:
          inp[p] = inp[p] + inw[k] * wpl[k] * dep[k]
      k = k + 1
    p = p + 1
  // LIF update + spikes
  nspk = []
  p = 0
  while p < N:
    nv = v[p] + inp[p] - 0.15 * v[p]
    if nv >= 1.0:
      append(nspk, 1)
      nv = 0.0
    else:
      append(nspk, 0)
      if nv < 0.0:
        nv = 0.0
    v[p] = nv
    p = p + 1
  // plasticity
  if do_plastic == 1:
    p = 0
    while p < N:
      k = instart[p]
      kend = instart[p + 1]
      while k < kend:
        if ingap[k] == 0:
          pre = inpre[k]
          if spk[pre] == 1:
            dep[k] = dep[k] * 0.8
            if nspk[p] == 1:
              wpl[k] = clamp(wpl[k] + 0.05, 0.2, 3.0)
          else:
            dep[k] = dep[k] + (1.0 - dep[k]) * 0.002
        k = k + 1
      p = p + 1
  return nspk

def count_sp(spk, nidx, a, b):
  return spk[nidx[a]] + spk[nidx[b]]

def main():
  args = argv()
  connpath = "connectome.txt"
  if len(args) > 0:
    connpath = args[0]
  txt = read_text(connpath)
  lines = split(txt, "\n")
  hdr = split(lines[0], " ")
  N = int(hdr[0])
  E = int(hdr[1])
  names = split(lines[1], " ")
  nidx = {}
  i = 0
  while i < N:
    nidx[names[i]] = i
    i = i + 1
  incount = []
  i = 0
  while i < N:
    append(incount, 0)
    i = i + 1
  er = []
  e = 0
  while e < E:
    parts = split(lines[2 + e], " ")
    pre = int(parts[0])
    post = int(parts[1])
    w = int(parts[2])
    t = parts[3]
    append(er, [pre, post, w, t])
    incount[post] = incount[post] + 1
    if t == "g":
      incount[pre] = incount[pre] + 1
    e = e + 1
  M = 0
  i = 0
  while i < N:
    M = M + incount[i]
    i = i + 1
  instart = [0]
  i = 0
  while i < N:
    append(instart, instart[i] + incount[i])
    i = i + 1
  inpre = []
  inw = []
  ingap = []
  chem_sum = []
  gap_sum = []
  i = 0
  while i < M:
    append(inpre, 0)
    append(inw, 0.0)
    append(ingap, 0)
    i = i + 1
  i = 0
  while i < N:
    append(chem_sum, 0.0)
    append(gap_sum, 0.0)
    i = i + 1
  fill = []
  i = 0
  while i < N:
    append(fill, instart[i])
    i = i + 1
  e = 0
  while e < E:
    ed = er[e]
    pre = ed[0]
    post = ed[1]
    w = ed[2]
    t = ed[3]
    slot = fill[post]
    inpre[slot] = pre
    inw[slot] = w * 1.0
    if t == "g":
      ingap[slot] = 1
      gap_sum[post] = gap_sum[post] + w
      slot2 = fill[pre]
      inpre[slot2] = post
      inw[slot2] = w * 1.0
      ingap[slot2] = 1
      gap_sum[pre] = gap_sum[pre] + w
      fill[pre] = slot2 + 1
    else:
      chem_sum[post] = chem_sum[post] + w
    fill[post] = fill[post] + 1
    e = e + 1
  p = 0
  while p < N:
    cs = chem_sum[p]
    gs = gap_sum[p]
    k = instart[p]
    kend = instart[p + 1]
    while k < kend:
      if ingap[k] == 1:
        if gs > 0.0:
          inw[k] = inw[k] / gs * 0.05
      else:
        if cs > 0.0:
          inw[k] = inw[k] / cs * 4.0
      k = k + 1
    p = p + 1
  dep = []
  wpl = []
  k = 0
  while k < M:
    append(dep, 1.0)
    append(wpl, 1.0)
    k = k + 1
  v = []
  spk = []
  ext = []
  i = 0
  while i < N:
    append(v, 0.0)
    append(spk, 0)
    append(ext, 0.0)
    i = i + 1
  print "LIF spiking connectome:", N, "cells,", M, "edges"

  def clear_ext():
    i2 = 0
    while i2 < N:
      ext[i2] = 0.0
      i2 = i2 + 1

  // tap: 3 stim steps, measure AVD spikes over stim + 7 following steps
  print "T1: tap habituation (30 taps)"
  tap = 0
  while tap < 30:
    clear_ext()
    ext[nidx["ALML"]] = 1.2
    ext[nidx["ALMR"]] = 1.2
    ext[nidx["AVM"]] = 1.2
    avdsp = 0
    s = 0
    while s < 3:
      spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
      avdsp = avdsp + count_sp(spk, nidx, "AVDL", "AVDR")
      s = s + 1
    clear_ext()
    s = 0
    while s < 7:
      spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
      avdsp = avdsp + count_sp(spk, nidx, "AVDL", "AVDR")
      s = s + 1
    print "tap", tap + 1, "AVD spikes", avdsp
    s = 0
    while s < 20:
      spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
      s = s + 1
    tap = tap + 1
  print "rest 400 steps"
  s = 0
  while s < 400:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
    s = s + 1
  clear_ext()
  ext[nidx["ALML"]] = 1.2
  ext[nidx["ALMR"]] = 1.2
  ext[nidx["AVM"]] = 1.2
  avdsp = 0
  s = 0
  while s < 10:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
    avdsp = avdsp + count_sp(spk, nidx, "AVDL", "AVDR")
    if s == 2:
      clear_ext()
    s = s + 1
  print "after rest, AVD spikes", avdsp
  print "SHOCK"
  i = 0
  while i < 60:
    ext[(i * 7) % N] = 2.0
    i = i + 1
  s = 0
  while s < 8:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
    s = s + 1
  k = 0
  while k < M:
    dep[k] = dep[k] + (1.0 - dep[k]) * 0.6
    k = k + 1
  clear_ext()
  s = 0
  while s < 20:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
    s = s + 1
  ext[nidx["ALML"]] = 1.2
  ext[nidx["ALMR"]] = 1.2
  ext[nidx["AVM"]] = 1.2
  avdsp = 0
  s = 0
  while s < 10:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
    avdsp = avdsp + count_sp(spk, nidx, "AVDL", "AVDR")
    if s == 2:
      clear_ext()
    s = s + 1
  print "after shock, AVD spikes", avdsp

  // T2 association
  print ""
  print "T2: Hebbian association (pair ALM+PLM 20x)"
  clear_ext()
  s = 0
  while s < 100:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 0)
    s = s + 1
  ext[nidx["ALML"]] = 1.2
  ext[nidx["ALMR"]] = 1.2
  pvcsp = 0
  s = 0
  while s < 10:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 0)
    pvcsp = pvcsp + count_sp(spk, nidx, "PVCL", "PVCR")
    if s == 2:
      clear_ext()
    s = s + 1
  print "before pairing, ALM -> PVC spikes:", pvcsp
  pair = 0
  while pair < 20:
    clear_ext()
    ext[nidx["ALML"]] = 1.2
    ext[nidx["ALMR"]] = 1.2
    ext[nidx["PLML"]] = 1.2
    ext[nidx["PLMR"]] = 1.2
    s = 0
    while s < 4:
      spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
      s = s + 1
    clear_ext()
    s = 0
    while s < 26:
      spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
      s = s + 1
    pair = pair + 1
  clear_ext()
  s = 0
  while s < 50:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 1)
    s = s + 1
  ext[nidx["ALML"]] = 1.2
  ext[nidx["ALMR"]] = 1.2
  pvcsp = 0
  s = 0
  while s < 10:
    spk = sstep(v, spk, ext, dep, wpl, instart, inpre, inw, ingap, N, 0)
    pvcsp = pvcsp + count_sp(spk, nidx, "PVCL", "PVCR")
    if s == 2:
      clear_ext()
    s = s + 1
  print "after pairing, ALM -> PVC spikes:", pvcsp

main()
