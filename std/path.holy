# Lexical POSIX paths only. Inputs are Str; no filesystem access or symlinks.
def isabs(path):
  return path[:1] == "/"

def join(base, path):
  if isabs(path) or base == "":
    return path
  if base[len(base) - 1:] == "/":
    return base + path
  return base + "/" + path

def basename(path):
  i = len(path)
  while i > 0:
    if path[i - 1:i] == "/":
      break
    i = i - 1
  return path[i:]

def dirname(path):
  i = len(path)
  while i > 0:
    if path[i - 1:i] == "/":
      break
    i = i - 1
  head = path[:i]
  j = len(head)
  while j > 0:
    if head[j - 1:j] != "/":
      break
    j = j - 1
  return head[:j] if j > 0 else head

def splitext(path):
  # Only the last component counts. Leading dots alone are not extensions.
  slash = -1
  dot = -1
  for i in range(len(path)):
    if path[i:i + 1] == "/":
      slash = i
    elif path[i:i + 1] == ".":
      dot = i
  if dot > slash:
    for i in range(slash + 1, dot):
      if path[i:i + 1] != ".":
        return [path[:dot], path[dot:]]
  return [path, ""]

def normpath(path):
  if path == "":
    return "."
  prefix = ""
  if isabs(path):
    prefix = "/"
    if path[:2] == "//" and path[2:3] != "/":
      prefix = "//"
  parts = []
  for part in split(path, "/"):
    if part != "" and part != ".":
      if part == ".." and len(parts) > 0:
        if parts[len(parts) - 1] != "..":
          parts = parts[:len(parts) - 1]
        elif prefix == "":
          append(parts, part)
      elif part != ".." or prefix == "":
        append(parts, part)
  result = prefix + join_parts(parts)
  return result if result != "" else "."

def join_parts(parts):
  # Keep the builtin join separate from the two-path public helper's name.
  result = ""
  for part in parts:
    if result == "":
      result = part
    else:
      result = result + "/" + part
  return result
