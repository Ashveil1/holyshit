# tour 05: error + try/except/finally/raise
# run: python3 interp.py examples/05_errors.holy
#
# every error is a Str with a line number: "message at line N"
# raise accepts only Str, and a function boundary drops a bare raise

# catching a runtime type error
try:
  print 1 + "a"
except as e:
  print "caught:", e

try:
  xs = [1]
  print xs[9]
except as e:
  print "caught:", e

try:
  d = {}
  print d["nope"]
except as e:
  print "caught:", e

# finally runs on every way out - error, return and normal
def checked(x):
  try:
    if x < 0:
      raise "negative input"
    return "ok " + str(x)
  except as e:
    return "error: " + e
  finally:
    print "checked", x

print checked(3)
print checked(-1)

# nesting: the inner finally first, then out to the outer
try:
  try:
    raise "inner"
  except as e:
    print "level 1 sees", e
    raise "outer"
  finally:
    print "inner finally"
except as e:
  print "level 2 sees", e

# catching without a variable
try:
  print len(5)
except:
  print "caught silently"

print "done"
