# tour 07: calling C / other-language libraries through the C ABI
# run: python3 interp.py examples/07_extern.holy   (or hs.py build)
#
# extern can call anything that speaks the C ABI: libc, another language's .so, or a .c file
# compiled in with it. No implicit conversion - convert explicitly every time

# libc - no `from` needed (default)
extern:
  U64 strlen(Str s)
  I64 abs(I64 x)
  I64 atoi(Str s)

print strlen("holyshit")
print abs(0 - 17)
print atoi("42")

# system library: from "m" -> -lm
extern from "m":
  F64 sin(F64 x)
  F64 cos(F64 x)

print sin(0.0)
print cos(0.0)

# a .c file next to the program -> compiled+linked automatically
# (see the helper example in tests/ffic.c)
# extern from "helper.c":
#   I64 triple(I64 x)

def repeat(s, k):
  out = ""
  for i in range(k):
    out = out + s
  return out

print repeat("ab", 3)
