# tour 08: unsafe - static types, structs, raw pointers
# run: python3 interp.py examples/08_unsafe.holy
#
# inside unsafe: static types (I64/U64/Ptr + struct pointers), every field 8 bytes
# no padding, no def/for/try/Str/List, and / truncates like C

unsafe:
  struct Point:
    I64 x
    I64 y

  struct Desc:
    I64 kind
    Point* origin
    I64 entries[4]

  # always declare with a type: I64/U64/Ptr or a struct name followed by *
  Point* p = alloc(sizeof(Point) * 2)
  p.x = 3
  p.y = 4
  print p.x + p.y

  # pointers can be stepped (in units of the pointee's sizeof = 16) and subtracted
  Point* q = p + 1
  q.x = 10
  q.y = 20
  print q.x, q.y, q - p

  # array field in a struct
  Desc* d = alloc(sizeof(Desc))
  d.kind = 2
  d.entries[0] = 11
  d.entries[3] = 22
  print d.kind, d.entries[0] + d.entries[3]
  print sizeof(Desc), sizeof(Point)

  # struct pointers can nest
  d.origin = p
  print d.origin.x

  # language operators work inside unsafe
  print 7 / 2
  print 7 % 2
  print 1 and 2
  print 0 or 5
  print not 0

  # raw bytes
  Ptr buf = alloc(8)
  store32(buf, 65530)
  print load32(buf)
  print load8(buf)

  # dynamic values cross into unsafe with as_int (and back with as_ptr)
  print as_int(as_ptr(p))
