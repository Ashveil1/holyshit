# tour 04: functions - closures, no default values, global
# run: python3 interp.py examples/04_functions.holy

def fib(n):
  if n < 2:
    return n
  return fib(n - 1) + fib(n - 2)

print fib(20)

# closure: captures values at def time (both interp and native)
def counter(start):
  def step():
    return start + 1
  return step

add_one = counter(10)
print add_one()

def mul(a):
  def by(x):
    return a * x
  return by

print mul(3)(4)
print mul(10)(4)

# functions are values, pass them as arguments
def apply_twice(f, x):
  return f(f(x))

def inc(x):
  return x + 1

print apply_twice(inc, 5)

# global: write a module-level name from inside a function
hits = 0

def bump():
  global hits
  hits = hits + 1

bump()
bump()
print hits

# bare return yields Null
def nothing():
  return

print nothing()
