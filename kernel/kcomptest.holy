# kcomp: window registry, z-order, hit-testing, focus, title-bar drag,
# pointer-event handling, cursor clamp, and compose+flush pixels on a
# mock heap framebuffer (deterministic on any machine, same pattern as
# ksurfacetest). Events are synthetic packed kinput words, so no IRQ or
# hardware timing is involved.
import kmb
import kpmm
import kheap
import ksurface
import kcomp

fails = 0

def expect(label, got, want):
  global fails
  if got == want:
    print "ok", label
    return
  print "FAIL", label, got, want
  fails = fails + 1

def peek8(addr):
  unsafe:
    return load8(as_ptr(addr))

expect("boot info found", kmb.usable(), true)
expect("pmm ready", kpmm.init() > 0, true)
expect("heap init", kheap.init(64), true)
expect("heap ready", kheap.ready(), true)

mock = kheap.malloc(64 * 48 * 4)
expect("mock allocated", mock != 0, true)
i = 0
while i < 64 * 48 * 4:
  unsafe:
    store8(as_ptr(mock + i), 0)
  i = i + 1
frame = [mock, 256, 64, 48, 4, 2, 1, 0]

c = kcomp.create(ksurface.create(64, 48))
expect("first id is 1", c[0], 1)
expect("empty hit test", kcomp.hit_test(c, 10, 10), -1)
expect("add first window", kcomp.win_add(c, 0, 0, 20, 20, 0x112233), 1)
expect("add second window", kcomp.win_add(c, 10, 10, 20, 20, 0x445566), 2)
expect("window count", len(c[1]), 2)
rejected = false
try:
  kcomp.win_add(c, 5, 5, 0, 5, 0)
except as e:
  rejected = true
expect("zero width rejected", rejected, true)
expect("hit first only", kcomp.hit_test(c, 5, 5), 1)
expect("hit overlap takes top", kcomp.hit_test(c, 15, 15), 2)
expect("hit outside", kcomp.hit_test(c, 63, 47), -1)
expect("right edge excluded", kcomp.hit_test(c, 20, 5), -1)
expect("bottom edge excluded", kcomp.hit_test(c, 5, 20), -1)
expect("raise first", kcomp.win_raise(c, 1), true)
expect("raised window on top", c[1][1][0], 1)
expect("overlap hit after raise", kcomp.hit_test(c, 15, 15), 1)
expect("raise missing", kcomp.win_raise(c, 9), false)
expect("move second", kcomp.win_move(c, 2, 30, 30), true)
expect("hit moved window", kcomp.hit_test(c, 35, 35), 2)
expect("hit vacated spot", kcomp.hit_test(c, 25, 25), -1)
expect("remove second", kcomp.win_remove(c, 2), true)
expect("count after remove", len(c[1]), 1)
expect("remove missing", kcomp.win_remove(c, 2), false)
expect("move missing", kcomp.win_move(c, 9, 0, 0), false)
expect("cursor clamp moved", kcomp.cursor_move(c, -5, 999), true)
expect("cursor clamped x", c[2], 0)
expect("cursor clamped y", c[3], 47)
expect("cursor still", kcomp.cursor_move(c, 0, 47), false)

# Fresh scene for pixel checks: w1 0x112233 at (0,0,20,20) under w2
# 0x445566 at (10,10,20,20), cursor at (50,30) clear of both.
kcomp.win_add(c, 10, 10, 20, 20, 0x445566)
kcomp.cursor_move(c, 50, 30)
kcomp.compose(c)
# Windows union into the bounding box (0,0,30,30) = 900; the cursor's
# drawn span (50,30,56,37) = 42 more, disjoint. flush writes bounding boxes.
expect("scene flush pixels", ksurface.flush(c[4], frame), 942)
expect("clean after flush", c[4][3], 0)
expect("second flush empty", ksurface.flush(c[4], frame), 0)
base = mock + 5 * 256 + 5 * 4
expect("first-only title red", peek8(base + 2), 0x55)
base = mock + 15 * 256 + 15 * 4
expect("overlap title red", peek8(base + 2), 0x55)
expect("overlap title blue", peek8(base + 0), 0x66)
base = mock + 25 * 256 + 25 * 4
expect("second-only red", peek8(base + 2), 0x44)
base = mock + 47 * 256 + 40 * 4
expect("untouched pixel", peek8(base + 2), 0)
base = mock + 31 * 256 + 51 * 4
expect("cursor fill red", peek8(base + 2), 0xff)
expect("cursor fill green", peek8(base + 1), 0xff)
base = mock + 30 * 256 + 50 * 4
expect("cursor outline red", peek8(base + 2), 0)

# Raising changes occlusion on the next compose.
kcomp.win_raise(c, 1)
kcomp.compose(c)
ksurface.flush(c[4], frame)
base = mock + 15 * 256 + 15 * 4
expect("overlap red after raise", peek8(base + 2), 0x11)

# B3: focus, raise-on-press, title-bar drag with clamping, and focus
# colors, driven by synthetic packed pointer events on a fresh scene.
def ev(btn, edx, edy):
  return btn + (edx + 512) << 3 + (edy + 512) << 13

c2 = kcomp.create(ksurface.create(64, 48))
kcomp.win_add(c2, 10, 10, 20, 20, 0x112233)
kcomp.win_add(c2, 40, 20, 20, 20, 0x445566)
expect("move only keeps focus", kcomp.handle_event(c2, ev(0, 5, 5)), -1)
expect("desktop press clears focus", kcomp.handle_event(c2, ev(1, 0, 0)), -1)
kcomp.handle_event(c2, ev(0, 0, 0))
expect("no drag from desktop", c2[6], -1)
kcomp.handle_event(c2, ev(1, 7, 7))
expect("title press focuses", c2[5], 1)
expect("title press raises", c2[1][1][0], 1)
expect("title press starts drag", c2[6], 1)
kcomp.handle_event(c2, ev(1, 8, 6))
expect("drag moves window x", c2[1][1][1], 18)
expect("drag moves window y", c2[1][1][2], 16)
kcomp.handle_event(c2, ev(1, -30, -30))
expect("drag clamps left", c2[1][1][1], 0)
expect("drag clamps top", c2[1][1][2], 0)
kcomp.handle_event(c2, ev(0, 0, 0))
expect("release ends drag", c2[6], -1)
kcomp.handle_event(c2, ev(0, 30, 25))
expect("no drag after release", c2[1][1][1], 0)
kcomp.handle_event(c2, ev(1, 15, 5))
expect("body press focuses", c2[5], 2)
expect("body press raises", c2[1][1][0], 2)
expect("body press starts no drag", c2[6], -1)
kcomp.handle_event(c2, ev(0, 0, 0))

mock2 = kheap.malloc(64 * 48 * 4)
expect("mock2 allocated", mock2 != 0, true)
i = 0
while i < 64 * 48 * 4:
  unsafe:
    store8(as_ptr(mock2 + i), 0)
  i = i + 1
frame2 = [mock2, 256, 64, 48, 4, 2, 1, 0]
kcomp.compose(c2)
ksurface.flush(c2[4], frame2)
base = mock2 + 2 * 256 + 5 * 4
expect("unfocused title red", peek8(base + 2), 0x55)
base = mock2 + 22 * 256 + 45 * 4
expect("focused title red", peek8(base + 2), 0x2a)
expect("focused title green", peek8(base + 1), 0x6f)
base = mock2 + 38 * 256 + 55 * 4
expect("focused body red", peek8(base + 2), 0x44)
base = mock2 + 10 * 256 + 10 * 4
expect("unfocused body red", peek8(base + 2), 0x11)

expect("remove focused clears focus", kcomp.win_remove(c2, 2), true)
expect("focus cleared", c2[5], -1)
expect("short window all title", kcomp.title_h([9, 50, 0, 8, 4, 0]), 4)
expect("short window title hit", kcomp.in_title([9, 50, 0, 8, 4, 0], 54, 3), true)

print "KCOMP TEST DONE", fails
