# Window event routing: feeds packed kinput pointer events through the
# compositor (focus/raise/drag chrome) and mirrors the non-chrome ones to
# per-window queues as window-relative packed words for ring 3 readers.
#
# Chrome events are never routed: a press on a title bar or on bare
# desktop, and every event while a title drag is active. Everything else
# (motion, body presses, releases) lands in the queue of the window under
# the cursor, translated to window-relative coordinates.
#
# Routed word: buttons + ((rx+1) << 3) + ((ry+1) << 14). rx/ry are the
# cursor offset inside the window, biased by 1 so a zero-motion event at
# the window origin is never 0; drain returns 0 for an empty queue.
import kcomp
import kinput

QUEUE_MAX = 64

# State: [compositor, wids, queues, created, key_wids, key_queues];
# queues[i] holds pointer events for
# wids[i], oldest first; created tracks sys_create windows so sys_exit
# can close them. sys_router is the instance the syscall layer drains.
sys_router = null

def create(c):
  return [c, [], [], [], [], []]

def bind(r):
  global sys_router
  sys_router = r
  return true

def qfind(r, wid):
  i = 0
  while i < len(r[1]):
    if r[1][i] == wid:
      return i
    i = i + 1
  return -1

def enqueue(r, wid, pev):
  i = qfind(r, wid)
  if i < 0:
    append(r[1], wid)
    append(r[2], [pev])
    return true
  if len(r[2][i]) >= QUEUE_MAX:
    return false
  append(r[2][i], pev)
  return true

def drain(r, wid):
  i = qfind(r, wid)
  if i < 0 or len(r[2][i]) == 0:
    return 0
  pev = r[2][i][0]
  out = []
  j = 1
  while j < len(r[2][i]):
    append(out, r[2][i][j])
    j = j + 1
  r[2][i] = out
  return pev

def handle(r, ev):
  # One packed kinput event: compositor chrome first, then route the
  # remainder to the window under the post-move cursor.
  c = r[0]
  b = kinput.buttons(ev)
  was_down = c[9] & 1 == 1
  down = b & 1 == 1
  was_drag = c[6] >= 0
  s = c[4]
  px = c[2] + kinput.dx(ev)
  py = c[3] + kinput.dy(ev)
  if px < 0:
    px = 0
  if py < 0:
    py = 0
  if px >= s[0]:
    px = s[0] - 1
  if py >= s[1]:
    py = s[1] - 1
  chrome = false
  if down and not was_down:
    h = kcomp.hit_test(c, px, py)
    if h < 0:
      chrome = true
    else:
      i = kcomp.win_find(c, h)
      if kcomp.in_title(c[1][i], px, py):
        chrome = true
  out = kcomp.handle_event(c, ev)
  if not chrome and not was_drag:
    h = kcomp.hit_test(c, c[2], c[3])
    if h >= 0:
      i = kcomp.win_find(c, h)
      w = c[1][i]
      enqueue(r, h, b + (c[2] - w[1] + 1) << 3 + (c[3] - w[2] + 1) << 14)
  return out

def wbuttons(pev):
  return pev & 7
def wrx(pev):
  return pev >> 3 & 2047 - 1
def wry(pev):
  return pev >> 14 & 2047 - 1

def qdrop(r, wid):
  i = qfind(r, wid)
  if i < 0:
    return false
  ws = []
  qs = []
  j = 0
  while j < len(r[1]):
    if j != i:
      append(ws, r[1][j])
      append(qs, r[2][j])
    j = j + 1
  r[1] = ws
  r[2] = qs
  return true

def sys_create(x, y, w, h, color):
  # SYS_WIN_CREATE: a compositor window owned by the calling program,
  # with an implicit event queue. Returns the window id, -1 with no
  # router bound, -22 on bad geometry.
  if sys_router == null:
    return -1
  if w < 1 or h < 1:
    return -22
  wid = kcomp.win_add(sys_router[0], x, y, w, h, color)
  append(sys_router[3], wid)
  return wid

def sys_close(wid):
  # SYS_WIN_CLOSE: remove the window and drop its queue; 0 ok, -22 bad id.
  if sys_router == null:
    return -22
  if not kcomp.win_remove(sys_router[0], wid):
    return -22
  qdrop(sys_router, wid)
  key_drop(sys_router, wid)
  cs = []
  j = 0
  while j < len(sys_router[3]):
    if sys_router[3][j] != wid:
      append(cs, sys_router[3][j])
    j = j + 1
  sys_router[3] = cs
  return 0

def sys_close_all():
  # sys_exit hook: close every window the dying program created.
  if sys_router == null:
    return true
  while len(sys_router[3]) > 0:
    sys_close(sys_router[3][0])
  return true

def key_find(r, wid):
  i = 0
  while i < len(r[4]):
    if r[4][i] == wid:
      return i
    i = i + 1
  return -1

def handle_key(r, code):
  # ASCII make codes plus Up=128/Down=129, as readkey_event spells them.
  # Focus is click-driven; no focus (or stale focus) drops input.
  if code < 1 or code > 129:
    return false
  wid = r[0][5]
  if kcomp.win_find(r[0], wid) < 0:
    return false
  i = key_find(r, wid)
  if i < 0:
    append(r[4], wid)
    append(r[5], [code])
    return true
  if len(r[5][i]) >= QUEUE_MAX:
    return false
  append(r[5][i], code)
  return true

def key_drain(r, wid):
  i = key_find(r, wid)
  if i < 0 or len(r[5][i]) == 0:
    return 0
  code = r[5][i][0]
  out = []
  j = 1
  while j < len(r[5][i]):
    append(out, r[5][i][j])
    j = j + 1
  r[5][i] = out
  return code

def key_drop(r, wid):
  ws = []
  qs = []
  i = 0
  while i < len(r[4]):
    if r[4][i] != wid:
      append(ws, r[4][i])
      append(qs, r[5][i])
    i = i + 1
  r[4] = ws
  r[5] = qs

def pump(r):
  # Both wait paths service both FIFOs. Pointer batches run first so a
  # pending click updates focus before pending keyboard input is routed.
  # The two hardware FIFOs do not carry a shared cross-device timestamp.
  n = 0
  while n < 64:
    pev = kinput.read()
    if pev == 0:
      break
    handle(r, pev)
    n = n + 1
  n = 0
  while n < 64:
    code = readkey_event()
    if code == null:
      break
    handle_key(r, code)
    n = n + 1

def sys_read(wid):
  # SYS_WIN_EVENT_READ: bounded ring-0 wait, 0 on empty/no router.
  if sys_router == null:
    return 0
  irq_on()
  t0 = ticks()
  while true:
    pump(sys_router)
    out = drain(sys_router, wid)
    if out != 0:
      return out
    if ticks() >= t0 + 400:
      return 0

def sys_key_read(wid):
  # SYS_WIN_KEY_READ: oldest focused-window key, 0 on empty/bad window.
  # The same bounded wait as pointer reads keeps IRQ1 and IRQ12 alive.
  if sys_router == null:
    return 0
  if kcomp.win_find(sys_router[0], wid) < 0:
    return 0
  irq_on()
  t0 = ticks()
  while true:
    pump(sys_router)
    out = key_drain(sys_router, wid)
    if out != 0:
      return out
    if ticks() >= t0 + 400:
      return 0
