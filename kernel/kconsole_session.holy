# Experimental bounded transcript, keeps accepting input. Never executes it.
import kframebuffer
import std.font
import std.console
def present(frame, surface, x, y):
  for row in range(surface[1]):
    for col in range(surface[0]):
      kframebuffer.pixel(frame, x + col, y + row, surface[2][row * surface[0] + col])
frame = kframebuffer.descriptor()
kframebuffer.map(frame)
kframebuffer.rect(frame, 0, 0, frame[2], frame[3], 0x16324f)
header = std.gfx.surface(576, 64, 0x386fa4)
std.font.draw(header, 16, 16, "HS SYSTEM CONSOLE", 0xffffff, 3)
present(frame, header, 24, 24)
# Redraw only text rows, not the entire transcript panel per key.
kframebuffer.rect(frame, 24, 104, 576, 224, 0xe8edf2)
entry = std.gfx.surface(512, 16, 0xe8edf2)
session = std.console.create(42, 4)
def textrow(text, y):
  std.gfx.rect(entry, 0, 0, 512, 16, 0xe8edf2)
  std.font.draw(entry, 0, 0, text, 0x16324f, 2)
  present(frame, entry, 32, y)
def history():
  for index in range(4):
    text = session[1][index] if index < len(session[1]) else ""
    textrow(text, 136 + index * 24)
textrow("RECENT INPUT - NOT EXECUTED", 112)
textrow("INPUT:", 248)
textrow("", 280)
print "SESSION READY"
while true:
  key = readkey()
  if key != null:
    submitted = std.console.feed(session, key)
    if submitted:
      history()
    textrow(session[0][0], 280)
    if submitted:
      print "SESSION SUBMITTED", session[3], json_str(session[1])
    else:
      print "SESSION EDIT", len(session[0][0])
