# Experimental bounded transcript, keeps accepting input. Never executes it.
import kframebuffer
import kfont
import std.console
frame = kframebuffer.descriptor()
kframebuffer.map(frame)
kfont.fill(frame, 0, 0, frame[2], frame[3], 0x16324f)
kfont.fill(frame, 24, 24, 576, 64, 0x386fa4)
kfont.draw(frame, 40, 40, "HS SYSTEM CONSOLE", 0xffffff, 3)
kfont.fill(frame, 24, 104, 576, 224, 0xe8edf2)
session = std.console.create(42, 4)
def textrow(text, y):
  kfont.fill(frame, 32, y, 512, 16, 0xe8edf2)
  kfont.draw(frame, 32, y, text, 0x16324f, 2)
def history():
  for index in range(4):
    text = session[1][index] if index < len(session[1]) else ""
    textrow(text, 136 + index * 24)
textrow("RECENT INPUT - NOT EXECUTED", 112)
textrow("INPUT:", 248)
textrow("", 280)
print "SESSION READY"
while true:
  key = readkey()
  if key != null:
    submitted = std.console.feed(session, key)
    if submitted:
      history()
    textrow(session[0][0], 280)
    if submitted:
      print "SESSION SUBMITTED", session[3], json_str(session[1])
    else:
      print "SESSION EDIT", len(session[0][0])
