# ring 3 window-event probe: drains the routed queue of window 1 through
# SYS_WIN_EVENT_READ only and prints the decoded triple per event. Exits
# after 5 events or when the spin bound trips, so a broken path shows as
# a short count, not a hang.
SYS_EXIT = 60
SYS_WIN_EVENT_READ = 92
def sc(nr, a1, a2, a3, a4, a5, a6):
  return scall(nr, a1, a2, a3, a4, a5, a6)
got = 0
spins = 0
while got < 5:
  if spins >= 1000000:
    break
  ev = sc(SYS_WIN_EVENT_READ, 1, 0, 0, 0, 0, 0)
  if ev != 0:
    print "wev", ev & 7, ev >> 3 & 2047 - 1, ev >> 14 & 2047 - 1
    got = got + 1
  spins = spins + 1
print "uuwin events", got
sc(SYS_EXIT, 0, 0, 0, 0, 0, 0)
