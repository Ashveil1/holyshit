# Shared QEMU-only AHCI gate body. Host verifies disk bytes and PCI topology.
import kpci
import kahci
fails = 0
def expect(label, got, want):
  global fails
  if got == want:
    print "ok", label
  else:
    print "FAIL", label, got, want
    fails = fails + 1
def pattern(lba, offset):
  if offset < 6:
    return lba >> (offset * 8) & 255
  return (lba * 17 + offset * 7 + int(offset / 251) * 31) & 255
def verify(lba, count):
  if not kahci.read(lba, count):
    return false
  for i in range(count * 512):
    if kahci.byte_at(i) != pattern(lba + int(i / 512), i % 512):
      print "MISMATCH", lba, i, kahci.byte_at(i)
      return false
  return true
def guard_set():
  for i in range(1536, 4096):
    kahci.wr8(kahci.arena + i, 0xA5)
  for i in range(8192, 12288):
    kahci.wr8(kahci.arena + i, 0x5A)
def guards():
  for i in range(1536, 4096):
    if kahci.rd8(kahci.arena + i) != 0xA5:
      return false
  for i in range(8192, 12288):
    if kahci.rd8(kahci.arena + i) != 0x5A:
      return false
  return true
def opcode_refusals():
  for opcode in range(256):
    if opcode != 0xEC and opcode != 0x25:
      if kahci.issue(opcode, 0, 1):
        return false
  return true
def other_stopped():
  implemented = kahci.rd32(kahci.abar + 12)
  for n in range(32):
    base = kahci.abar + 256 + n * 128
    if implemented & (1 << n) != 0 and base != kahci.port:
      if kahci.rd32(base + 24) & 0xC011 != 0:
        return false
  return true
def discover():
  kpci.init()
  idx = kpci.find_class(1, 6)
  print "AHCI PCI", idx
  if idx >= 0:
    print "AHCI BDF", kpci.bus(idx), kpci.dev(idx), kpci.fn(idx), kpci.vendor(idx), kpci.device(idx)
  return idx
def run(number, expected):
  print "AHCI START"
  idx = discover()
  ok = kahci.init(idx, number)
  print "AHCI INIT", ok, kahci.error()
  if not ok:
    expect("initialization", ok, true)
    print "AHCI DONE", fails
    return
  expect("capacity", kahci.sectors(), expected)
  expect("DMA alignment", kahci.arena & 4095, 0)
  expect("DMA low physical", kahci.arena >= 0x2000000 and kahci.arena + 12288 <= 0x3000000, true)
  expect("global IRQ disabled", kahci.rd32(kahci.abar + 4) & 2, 0)
  expect("port IRQ disabled", kahci.rd32(kahci.port + 20), 0)
  expect("other engines stopped", other_stopped(), true)
  guard_set()
  expect("read first", verify(0, 1), true)
  expect("read eight", verify(4, 8), true)
  expect("read middle", verify(32767, 3), true)
  expect("read last", verify(expected - 1, 1), true)
  expect("read last eight", verify(expected - 8, 8), true)
  if expected == 65536:
    for count in range(4, 8):
      expect("read span4..7", verify(100 + count * 8, count), true)
  if expected > 4294967296:
    expect("cross LBA28", verify(268435455, 3), true)
    expect("cross LBA32", verify(4294967295, 3), true)
  before = kahci.commands()
  expect("reject negative lba", kahci.read(-1, 1), false)
  expect("reject zero count", kahci.read(0, 0), false)
  expect("reject ninth sector", kahci.read(0, 9), false)
  expect("reject end lba", kahci.read(expected, 1), false)
  expect("reject crossing end", kahci.read(expected - 1, 2), false)
  expect("reject huge lba", kahci.read(281474976710656, 1), false)
  expect("reject every other opcode", opcode_refusals(), true)
  expect("reject raw past end", kahci.issue(0x25, expected, 1), false)
  expect("no invalid commands", kahci.commands(), before)
  expect("invalid result hidden", kahci.byte_at(0), -1)
  expect("read after refusal", verify(13, 2), true)
  expect("negative byte", kahci.byte_at(-1), -1)
  expect("past byte", kahci.byte_at(1024), -1)
  expect("DMA guards", guards(), true)
  expect("single init", kahci.init(idx, number), false)
  expect("still ready", kahci.ready(), true)
  print "AHCI DONE", fails
