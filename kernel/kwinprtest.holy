# Explicit ring-3 present into a kernel-bound framebuffer target.
import kmb
import kpmm
import kheap
import ksyscall
import kvfs
import kramdisk
import kuser
import kinput
import ksurface
import kcomp
import kwinroute
import kframebuffer
fails = 0
def expect(label, got, want):
  global fails
  if got == want:
    print "ok", label
    return
  print "FAIL", label, got, want
  fails = fails + 1

expect("boot info found", kmb.usable(), true)
expect("pmm ready", kpmm.init() > 0, true)
expect("heap init", kheap.init(64), true)
expect("heap ready", kheap.ready(), true)
expect("vfs ready", kvfs.vfs_init(), true)
expect("ramdisk loads", kramdisk.load() > 0, true)
expect("uupresent present", kvfs.is_file("/bin/uupresent"), true)

def peek8(addr):
  unsafe:
    return load8(as_ptr(addr))

def fill_bytes(addr, count, value):
  i = 0
  while i < count:
    unsafe:
      store8(as_ptr(addr + i), value)
    i = i + 1

expect("unbound router present ENODEV", kwinroute.sys_present(), -19)
c0 = kcomp.create(ksurface.create(16, 12))
r0 = kwinroute.create(c0)
kwinroute.bind(r0)
expect("unbound frame present ENODEV", kwinroute.sys_present(), -19)
# Padded RGB24 target, with guards around the full allocation.
mock0 = kheap.malloc(12 * 53 + 16)
fill_bytes(mock0, 12 * 53 + 16, 0xa5)
f0 = [mock0 + 8, 53, 16, 12, 3, 0, 1, 2]
expect("bad descriptor shape", kwinroute.bind_frame(r0, [], 0), false)
expect("bad dimensions", kwinroute.bind_frame(r0, [mock0, 53, 15, 12, 3, 0, 1, 2], 0), false)
expect("bad pitch", kwinroute.bind_frame(r0, [mock0, 47, 16, 12, 3, 0, 1, 2], 0), false)
expect("bad pixel size", kwinroute.bind_frame(r0, [mock0, 53, 16, 12, 2, 0, 1, 2], 0), false)
expect("bad channels", kwinroute.bind_frame(r0, [mock0, 53, 16, 12, 3, 0, 0, 2], 0), false)
expect("out of range channel", kwinroute.bind_frame(r0, [mock0, 53, 16, 12, 3, 0, 1, 3], 0), false)
expect("bad base", kwinroute.bind_frame(r0, [0, 53, 16, 12, 3, 0, 1, 2], 0), false)
expect("bad background", kwinroute.bind_frame(r0, f0, -1), false)
expect("RGB24 bind succeeds", kwinroute.bind_frame(r0, f0, 0x123456), true)
expect("invalid rebind rejected", kwinroute.bind_frame(r0, f0, 16777216), false)
expect("invalid rebind preserves background", r0[7], 0x123456)
expect("invalid rebind preserves target", r0[6][0], mock0 + 8)
kcomp.cursor_move(c0, 12, 10)
w = kwinroute.sys_create(0, 0, 4, 8, 0x334455)
expect("body filled", kwinroute.sys_fill(w, 0, 0, 4, 2, 0xaabbcc), 0)
expect("first present full count", kwinroute.sys_present(), 192)
expect("RGB24 painted red", peek8(mock0 + 8 + 6 * 53), 0xaa)
expect("RGB24 painted green", peek8(mock0 + 9 + 6 * 53), 0xbb)
expect("RGB24 painted blue", peek8(mock0 + 10 + 6 * 53), 0xcc)
kcomp.win_move(c0, w, 6, 0)
expect("second present full count", kwinroute.sys_present(), 192)
expect("old location cleared red", peek8(mock0 + 8 + 6 * 53), 0x12)
expect("moved content red", peek8(mock0 + 8 + 6 * 53 + 18), 0xaa)
expect("surface clean after present", c0[4][3], 0)
expect("close succeeds", kwinroute.sys_close(w), 0)
expect("close immediately clears old body", peek8(mock0 + 8 + 6 * 53 + 18), 0x12)
# Moving cursor then presenting clears its previous white pixel too.
kcomp.cursor_move(c0, 0, 0)
kwinroute.sys_present()
expect("old cursor cleared", peek8(mock0 + 8 + 11 * 53 + 13 * 3), 0x12)
guards = true
i = 0
while i < 8:
  if peek8(mock0 + i) != 0xa5 or peek8(mock0 + 8 + 12 * 53 + i) != 0xa5:
    guards = false
  i = i + 1
y = 0
while y < 12:
  x = 48
  while x < 53:
    if peek8(mock0 + 8 + y * 53 + x) != 0xa5:
      guards = false
    x = x + 1
  y = y + 1
expect("RGB24 row padding and guards untouched", guards, true)

# Live RGB32 scene. App present/close and kernel exit cleanup must each
# change the bound target without any observer-side compose or flush.
c = kcomp.create(ksurface.create(64, 48))
r = kwinroute.create(c)
kwinroute.bind(r)
kcomp.cursor_move(c, 55, 40)
mock = kheap.malloc(64 * 48 * 4)
fill_bytes(mock, 64 * 48 * 4, 0xa5)
frame = [mock, 256, 64, 48, 4, 2, 1, 0]
expect("live frame bound", kwinroute.bind_frame(r, frame, 0x16324f), true)
snapshots = 0
def snapshot(label):
  global snapshots
  snapshots = snapshots + 1
  print "present-pixels-begin", label
  y = 0
  while y < 48:
    x = 0
    while x < 64:
      base = mock + (y * 64 + x) * 4
      unsafe:
        print load8(as_ptr(base + 2)) << 16 + load8(as_ptr(base + 1)) << 8 + load8(as_ptr(base))
      x = x + 1
    y = y + 1
  print "present-pixels-end"
def observe(nr, a1, a2, a3, a4, a5, a6):
  result = ksyscall.dispatch(nr, a1, a2, a3, a4, a5, a6)
  if nr == 97:
    snapshot(1)
  if nr == 94:
    snapshot(2)
  return result
data = kvfs.read("/bin/uupresent")
expect("app readable", data != null, true)
expect("app loads", kuser.load_image(kuser.payload_addr(data), len(data)), 1)
expect("observer registered", ksyscall.register(observe), true)
expect("exec enabled", kuser.enable_exec(), true)
before = kheap.free_bytes()
kuser.run()
snapshot(3)
expect("three target snapshots", snapshots, 3)
expect("user stopped", ksyscall.user_stopped(), true)
expect("exit code", ksyscall.user_exit_code(), 0)
expect("windows closed", len(c[1]), 0)
expect("body heap reclaimed", kheap.free_bytes(), before)
expect("surface clean after exit", c[4][3], 0)
alpha = true
i = 0
while i < 64 * 48:
  if peek8(mock + i * 4 + 3) != 0xa5:
    alpha = false
  i = i + 1
expect("RGB32 fourth bytes untouched", alpha, true)
print "fails", fails
print "winpresent-done"
