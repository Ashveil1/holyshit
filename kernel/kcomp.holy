# Compositor core: a window registry with z-order, hit-testing, focus and
# title-bar drag driven by packed kinput pointer events, and full-scene
# composition onto a ksurface double buffer, plus a software cursor drawn
# last. All drawing goes through ksurface, so the dirty-rect flush to the
# framebuffer stays exact. kwinroute owns the ring-3 event and drawing
# syscall binding; this module owns persistent bodies and composition.
import ksurface
import kinput
import kfont

# 7x7 NW-pointing cursor: per-row bitmasks, column 0 is bit 6.
CURSOR_OUT = [96, 80, 72, 68, 66, 92, 96]
CURSOR_FILL = [0, 32, 48, 56, 60, 32, 0]

# Title bar: top TITLE_H rows of a window (fewer when the window is
# shorter). Focused windows get the bright bar, the rest the dim one.
TITLE_H = 6
TITLE_FOCUS = 0x2a6fdb
TITLE_DIM = 0x555a66

# State: [next_id, windows bottom..top, cursor_x, cursor_y, surface,
# focus_wid, drag_wid, grab_dx, grab_dy, prev_buttons].
# Window: [id, x, y, width, height, color, optional body surface].
def create(surface):
  return [1, [], 0, 0, surface, -1, -1, 0, 0, 0]

def win_find(c, wid):
  i = 0
  while i < len(c[1]):
    if c[1][i][0] == wid:
      return i
    i = i + 1
  return -1

def win_add(c, x, y, width, height, color):
  if width < 1 or height < 1:
    raise "window needs positive size"
  wid = c[0]
  c[0] = wid + 1
  append(c[1], [wid, x, y, width, height, color, null])
  return wid

def win_remove(c, wid):
  i = win_find(c, wid)
  if i < 0:
    return false
  if c[1][i][6] != null:
    ksurface.destroy(c[1][i][6])
  out = []
  j = 0
  while j < len(c[1]):
    if j != i:
      append(out, c[1][j])
    j = j + 1
  c[1] = out
  if c[5] == wid:
    c[5] = -1
  if c[6] == wid:
    c[6] = -1
  return true

def win_raise(c, wid):
  i = win_find(c, wid)
  if i < 0:
    return false
  w = c[1][i]
  # Reorder without removing: removal frees the content buffer and
  # clears focus/drag, which raising must preserve.
  out = []
  j = 0
  while j < len(c[1]):
    if j != i:
      append(out, c[1][j])
    j = j + 1
  c[1] = out
  append(c[1], w)
  return true

def win_move(c, wid, nx, ny):
  i = win_find(c, wid)
  if i < 0:
    return false
  c[1][i][1] = nx
  c[1][i][2] = ny
  return true

def hit_test(c, x, y):
  # Topmost (last in z-order) window containing the point; edges are
  # exclusive, matching ksurface clipping. The cursor is not a window.
  i = len(c[1]) - 1
  while i >= 0:
    w = c[1][i]
    if x >= w[1] and x < w[1] + w[3] and y >= w[2] and y < w[2] + w[4]:
      return w[0]
    i = i - 1
  return -1

def title_h(w):
  th = TITLE_H
  if w[4] < th:
    th = w[4]
  return th

def in_title(w, x, y):
  return x >= w[1] and x < w[1] + w[3] and y >= w[2] and y < w[2] + title_h(w)

def handle_event(c, ev):
  # One packed kinput event: move the cursor by the deltas, then apply
  # left-button edges. Press on a window raises and focuses it; press on
  # its title bar also starts a drag; press on bare desktop clears focus.
  # A held button drags the grabbed window, clamped to the surface.
  b = kinput.buttons(ev)
  dx = kinput.dx(ev)
  dy = kinput.dy(ev)
  was_down = c[9] & 1 == 1
  down = b & 1 == 1
  cursor_move(c, c[2] + dx, c[3] + dy)
  if down and not was_down:
    hit = hit_test(c, c[2], c[3])
    if hit < 0:
      c[5] = -1
    else:
      win_raise(c, hit)
      c[5] = hit
      i = win_find(c, hit)
      w = c[1][i]
      if in_title(w, c[2], c[3]):
        c[6] = hit
        c[7] = c[2] - w[1]
        c[8] = c[3] - w[2]
  if down and c[6] >= 0:
    i = win_find(c, c[6])
    if i >= 0:
      w = c[1][i]
      s = c[4]
      nx = c[2] - c[7]
      ny = c[3] - c[8]
      if nx < 0:
        nx = 0
      if ny < 0:
        ny = 0
      mx = s[0] - w[3]
      my = s[1] - w[4]
      if mx < 0:
        mx = 0
      if my < 0:
        my = 0
      if nx > mx:
        nx = mx
      if ny > my:
        ny = my
      w[1] = nx
      w[2] = ny
  if not down and was_down:
    c[6] = -1
  c[9] = b
  return c[5]

def cursor_move(c, nx, ny):
  s = c[4]
  if nx < 0:
    nx = 0
  if ny < 0:
    ny = 0
  if nx >= s[0]:
    nx = s[0] - 1
  if ny >= s[1]:
    ny = s[1] - 1
  moved = nx != c[2] or ny != c[3]
  c[2] = nx
  c[3] = ny
  return moved

def win_fill(c, wid, x, y, width, height, color):
  # Body-local origin (0,0) is just below the title bar. Validate before
  # gfx helpers so bad syscall arguments return errors rather than raise.
  i = win_find(c, wid)
  if i < 0:
    return -22
  if x < -1048576 or x > 1048576 or y < -1048576 or y > 1048576:
    return -22
  if width < -1048576 or width > 1048576 or height < -1048576 or height > 1048576:
    return -22
  if color < 0 or color > 16777215:
    return -22
  w = c[1][i]
  bh = w[4] - title_h(w)
  if width <= 0 or height <= 0 or bh <= 0:
    return 0
  if x >= w[3] or y >= bh or x + width <= 0 or y + height <= 0:
    return 0
  if w[6] == null:
    if w[3] > 4096 or bh > 4096 or w[3] * bh > 4194304:
      return -12
    try:
      w[6] = ksurface.create(w[3], bh)
    except as e:
      return -12
    ksurface.rect(w[6], 0, 0, w[3], bh, w[5])
  ksurface.rect(w[6], x, y, width, height, color)
  return 0

def text_address(text):
  unsafe:
    return as_int(as_ptr(text)) + 16

def text_row(buf, width, height, x, y, mask, color, scale):
  # Caller validated the live body, scale and bounded coordinates. Only
  # clipped pixels reach its back buffer; no per-pixel list allocations.
  unsafe:
    I64 col = 0
    while col < 5:
      if mask & (1 << (4 - col)):
        I64 dx = 0
        while dx < scale:
          I64 px = x + col * scale + dx
          if px >= 0 and px < width:
            I64 dy = 0
            while dy < scale:
              I64 py = y + dy
              if py >= 0 and py < height:
                store32(as_ptr(buf + (py * width + px) * 4), color)
              dy = dy + 1
          dx = dx + 1
      col = col + 1

def win_text_scaled(c, wid, x, y, text, color, scale):
  # Byte-oriented 5x7 text, integer scale 1..4, transparent background.
  # The syscall layer copies and validates the full user span first.
  i = win_find(c, wid)
  if i < 0:
    return -22
  if x < -1048576 or x > 1048576 or y < -1048576 or y > 1048576:
    return -22
  if color < 0 or color > 16777215 or byte_len(text) > 256 or scale < 1 or scale > 4:
    return -22
  w = c[1][i]
  bh = w[4] - title_h(w)
  if byte_len(text) == 0 or bh <= 0:
    return 0
  if w[6] == null:
    result = win_fill(c, wid, 0, 0, 1, 1, w[5])
    if result != 0:
      return result
  address = text_address(text)
  left = x
  index = 0
  while index < byte_len(text):
    code = kfont.byte_at(address, index)
    if code == 10:
      x = left
      y = y + 8 * scale
    else:
      bits = kfont.rows_byte(code)
      row = 0
      while row < 7:
        text_row(w[6][2], w[3], bh, x, y + row * scale, bits[row], color, scale)
        row = row + 1
      x = x + 6 * scale
    index = index + 1
  ksurface.mark(w[6], 0, 0, w[3], bh)
  return 0

def win_text(c, wid, x, y, text, color):
  return win_text_scaled(c, wid, x, y, text, color, 1)

def compose(c):
  # Redraw the whole scene bottom-to-top, cursor last. Each window is a
  # title bar (bright when focused) over its body. ksurface records the
  # damage; flush() after compose writes exactly the dirty union.
  s = c[4]
  i = 0
  while i < len(c[1]):
    w = c[1][i]
    th = title_h(w)
    tcol = TITLE_DIM
    if w[0] == c[5]:
      tcol = TITLE_FOCUS
    ksurface.rect(s, w[1], w[2], w[3], th, tcol)
    if w[4] > th:
      if w[6] == null:
        ksurface.rect(s, w[1], w[2] + th, w[3], w[4] - th, w[5])
      else:
        ksurface.blit(s, w[6], w[1], w[2] + th)
    i = i + 1
  dy = 0
  while dy < 7:
    bits = CURSOR_OUT[dy]
    dx = 0
    while dx < 7:
      if bits >> (6 - dx) & 1 == 1:
        ksurface.pixel(s, c[2] + dx, c[3] + dy, 0)
      dx = dx + 1
    dy = dy + 1
  dy = 0
  while dy < 7:
    bits = CURSOR_FILL[dy]
    dx = 0
    while dx < 7:
      if bits >> (6 - dx) & 1 == 1:
        ksurface.pixel(s, c[2] + dx, c[3] + dy, 0xffffff)
      dx = dx + 1
    dy = dy + 1
