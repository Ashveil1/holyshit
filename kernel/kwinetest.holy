# Window event routing end to end: deterministic ring-0 routing pins on a
# mock-surface compositor, then real QEMU-injected PS/2 traffic pumped
# through kwinroute while still in ring 0, then /bin/uuwin runs in ring 3
# and drains its window queue through SYS_WIN_EVENT_READ. The harness
# injects over QMP after winroute-ready.
import kmb
import kpmm
import kheap
import ksyscall
import kvfs
import kramdisk
import kuser
import kinput
import ksurface
import kcomp
import kwinroute
fails = 0
def expect(label, got, want):
  global fails
  if got == want:
    print "ok", label
    return
  print "FAIL", label, got, want
  fails = fails + 1

def ev(btn, edx, edy):
  return btn + (edx + 512) << 3 + (edy + 512) << 13

expect("boot info found", kmb.usable(), true)
expect("pmm ready", kpmm.init() > 0, true)
expect("heap init", kheap.init(64), true)
expect("heap ready", kheap.ready(), true)
expect("vfs ready", kvfs.vfs_init(), true)
expect("ramdisk loads", kramdisk.load() > 0, true)
expect("uuwin present", kvfs.is_file("/bin/uuwin"), true)

# Ring-0 routing pins on a private scene: window 1 at (0,0,20,20).
c0 = kcomp.create(ksurface.create(64, 48))
kcomp.win_add(c0, 0, 0, 20, 20, 0x112233)
r0 = kwinroute.create(c0)
expect("empty queue drains 0", kwinroute.drain(r0, 1), 0)
kwinroute.handle(r0, ev(0, 5, 7))
pev = kwinroute.drain(r0, 1)
expect("motion routed buttons", kwinroute.wbuttons(pev), 0)
expect("motion routed rx", kwinroute.wrx(pev), 5)
expect("motion routed ry", kwinroute.wry(pev), 7)
expect("queue empty after drain", kwinroute.drain(r0, 1), 0)
kwinroute.handle(r0, ev(1, -4, -6))
expect("title press starts drag", c0[6], 1)
expect("title press focuses", c0[5], 1)
expect("title press not routed", kwinroute.drain(r0, 1), 0)
kwinroute.handle(r0, ev(1, 3, 2))
expect("drag not routed", kwinroute.drain(r0, 1), 0)
expect("drag moved window", c0[1][0][1], 3)
kwinroute.handle(r0, ev(0, 0, 0))
expect("release after drag not routed", kwinroute.drain(r0, 1), 0)
kwinroute.handle(r0, ev(1, 2, 5))
pev = kwinroute.drain(r0, 1)
expect("body press routed buttons", kwinroute.wbuttons(pev), 1)
expect("body press routed rx", kwinroute.wrx(pev), 3)
expect("body press routed ry", kwinroute.wry(pev), 6)

# Live scene: window 1 at (20,10,40,30), fed by real PS/2 traffic.
c = kcomp.create(ksurface.create(64, 48))
kcomp.win_add(c, 20, 10, 40, 30, 0x445566)
r = kwinroute.create(c)
expect("router binds", kwinroute.bind(r), true)
data = kvfs.read("/bin/uuwin")
expect("uuwin readable", data != null, true)
expect("uuwin loads", kuser.load_image(kuser.payload_addr(data), len(data)), 1)
expect("handler registered", ksyscall.start(), true)
expect("exec enabled", kuser.enable_exec(), true)
print "winroute-ready"
# ring 3 runs with IF clear by design (enter_user), so IRQ12 can only fill
# the FIFO while the kernel is in ring 0: give the harness a window to
# inject, pump the FIFO through the router, then enter ring 3 to drain.
t0 = ticks()
while ticks() < t0 + 250:
  z = 0
n = 0
while n < 64:
  pev = kinput.read()
  if pev == 0:
    break
  kwinroute.handle(r, pev)
  n = n + 1
expect("injected events pumped", n, 8)
expect("drag moved live window", c[1][0][1], 24)
expect("drag moved live window y", c[1][0][2], 12)
expect("live window focused", c[5], 1)
# --- ring 3 (uuwin drains its routed queue through the syscall path) ---
kuser.run()
expect("user stopped", ksyscall.user_stopped(), true)
expect("exit code", ksyscall.user_exit_code(), 0)
expect("win-event syscalls served", ksyscall.calls() >= 6, true)
expect("kernel alive", cr3() != 0, true)
print "fails", fails
print "winroute-done"
