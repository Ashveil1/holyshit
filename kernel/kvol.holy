# ATA-backed persistent volume: a KRFS image on the primary IDE disk.
#
# Layout: sector 0 is the commit header - "KVOL" | u32 image bytes |
# u32 generation; sectors 1.. hold the KRFS image, zero-padded to a
# sector multiple. sync() writes the image sectors FIRST and the header
# LAST, so a torn sync leaves the previous generation intact: the header
# is the only commit point. Persistence is explicit - nothing reaches the
# disk until sync() runs, matching the reality that the kernel has no
# clean shutdown path (QEMU is simply killed).
#
# mount() -> entries loaded, 0 when the disk holds no/invalid volume
# (the caller then starts from an empty or initrd-filled tree), -1 when
# no ATA device exists. Helpers come before their users: the x64 backend
# resolves module-level names statically.

import kata
import kkrfs
import kvfs

# 256 sectors = one ATA command, so reads and writes never need chunking.
# hs handles do not support pointer arithmetic outside unsafe blocks, and
# as_int-normalized buffer addresses alias each other on the x64 backend,
# so offset arithmetic on buffer addresses is not available here at all.
MAX_BYTES = 131072

gen_ = 0

def ceil512(n):
  # sector count for n bytes with integer division (safe `/` is Float)
  unsafe:
    I64 x = n
    return (x + 511) / 512

def zero(base, n):
  i = 0
  while i < n:
    kkrfs.put8(base, i, 0)
    i = i + 1



def probe():
  # present() issues IDENTIFY, which stages a 512-byte data block (DRQ);
  # kata leaves draining it to the caller. Undrained, the next commands'
  # data phases run against that stale block and silently do nothing, so
  # every probe drains it even though the volume layer never inspects it.
  if not kata.present():
    return false
  kata.read_identify(kata.identify_buf())
  return true

def mount():
  global gen_
  if not probe():
    return -1
  hdr = alloc(512)
  kata.read(0, 1, hdr)
  if read_mem(as_int(hdr), 4) != "KVOL":
    return 0
  n = kkrfs.rd32(hdr, 4)
  g = kkrfs.rd32(hdr, 8)
  if n <= 0 or n > MAX_BYTES:
    return 0
  nsec = ceil512(n)
  buf = alloc(nsec * 512)
  kata.read(1, nsec, buf)
  loaded = kkrfs.parse(buf, n)
  if loaded < 0:
    # a present-but-corrupt image must fail loudly, never be clobbered
    return -2
  gen_ = g
  return loaded

def sync():
  global gen_
  if not probe():
    return false
  img = kkrfs.serialize()
  n = img[1]
  nsec = ceil512(n)
  # the serializer's buffer is exactly n bytes; the disk wants whole
  # sectors, so stage a sector-padded copy (also zero-padded: alloc does
  # not promise zeroed bytes and padding must not leak heap garbage)
  base = alloc(nsec * 512)
  i = 0
  while i < n:
    kkrfs.put8(base, i, kata.rd8(img[0], i))
    i = i + 1
  while i < nsec * 512:
    kkrfs.put8(base, i, 0)
    i = i + 1
  kata.write(1, nsec, base)
  # the header commits the new image; write it last
  hdr = alloc(512)
  zero(hdr, 512)
  kkrfs.put8(hdr, 0, 75)
  kkrfs.put8(hdr, 1, 86)
  kkrfs.put8(hdr, 2, 79)
  kkrfs.put8(hdr, 3, 76)
  kkrfs.put32(hdr, 4, n)
  kkrfs.put32(hdr, 8, gen_ + 1)
  kata.write(0, 1, hdr)
  gen_ = gen_ + 1
  return true

def generation():
  return gen_
