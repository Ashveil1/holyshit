# ramdisk loader — unpacks the KRFS image in a multiboot module (usually
# from QEMU -initrd) into kvfs. The format lives in kkrfs.holy; this file
# is only the module-table glue. KRFS v1, all little-endian, every u32
# padded to a 4-aligned offset so only load32 is needed (alignment-safe on
# every backend). Returns entries loaded, or -1.

import kmb
import kkrfs

def load_module(idx):
  if kmb.mods_count() <= idx:
    return -1
  base = kmb.mod_start(idx)
  if base == 0 or kmb.mod_len(idx) < 8:
    return -1
  return kkrfs.parse(base, kmb.mod_len(idx))

def load():
  return load_module(0)
