# Trusted fixed-console view. Create once, redraw from opaque buffer state.
# Scale2 cells are12px wide; text/cursor rows occupy16px. No snapshots.
import kfont
import kconsole_buffer
def create(frame, session, x, history_y, row_step, input_y, width):
  return [frame, session, x, history_y, row_step, input_y, width]
def textrow(view, address, length, y):
  kfont.fill(view[0], view[2], y, view[6], 16, 0xe8edf2)
  kfont.draw_bytes(view[0], view[2], y, address, length, 0x16324f, 2)
def active(view):
  session = view[1]
  textrow(view, session[0], session[3], view[5])
  # Clear the complete cursor strip, including the full-capacity position.
  kfont.fill(view[0], view[2], view[5] + 14, view[6] + 4, 2, 0xe8edf2)
  color = 0x16324f
  if session[3] == session[1]:
    color = 0xb42318
  kfont.fill(view[0], view[2] + session[3] * 12, view[5] + 14, 8, 2, color)
def history(view):
  session = view[1]
  index = 0
  while index < session[2]:
    address = session[0]
    length = 0
    if index < session[6]:
      address = kconsole_buffer.history_address(session, index)
      length = kconsole_buffer.history_length(session, index)
    textrow(view, address, length, view[3] + index * view[4])
    index = index + 1
