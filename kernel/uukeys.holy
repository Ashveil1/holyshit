# Ring-3 focused-key probe: the harness clicks each app-created window
# before sending keys; only the matching window queue may receive them.
SYS_EXIT = 60
SYS_WIN_CREATE = 93
SYS_WIN_KEY_READ = 95
def sc(nr, a1, a2, a3, a4, a5, a6):
  return scall(nr, a1, a2, a3, a4, a5, a6)
def receive(wid, count):
  got = 0
  tries = 0
  while got < count and tries < 10:
    key = sc(SYS_WIN_KEY_READ, wid, 0, 0, 0, 0, 0)
    if key != 0:
      print "wkey", wid, key
      got = got + 1
    tries = tries + 1
  return got
w1 = sc(SYS_WIN_CREATE, 2, 2, 25, 30, 0x224488, 0)
w2 = sc(SYS_WIN_CREATE, 34, 2, 25, 30, 0x882244, 0)
print "key-stage1"
n1 = receive(w1, 3)
print "key-stage2"
n2 = receive(w2, 2)
print "uukeys counts", n1, n2
sc(SYS_EXIT, 0, 0, 0, 0, 0, 0)
