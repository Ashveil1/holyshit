# Two independent scratch buffers plus a persistent keyboard launcher.
# One process owns all three windows. No disk writes or command execution.
SYS_EXIT = 60
SYS_WIN_CREATE = 93
SYS_WIN_CLOSE = 94
SYS_WIN_FILL = 96
SYS_WIN_PRESENT = 97
SYS_WIN_TEXT = 100
SYS_WIN_KEY_ANY = 99
def sc(nr, a1, a2, a3, a4, a5, a6):
  return scall(nr, a1, a2, a3, a4, a5, a6)
def address(text):
  unsafe:
    return as_int(as_ptr(text)) + 16
def buffer():
  unsafe:
    return as_int(alloc(64))
def label(wid, x, y, text, color):
  return sc(SYS_WIN_TEXT, wid, x, y, address(text), byte_len(text), color + 16777216)
def present():
  return sc(SYS_WIN_PRESENT, 0, 0, 0, 0, 0, 0)
def input_draw(note):
  wid = note[0]
  sc(SYS_WIN_FILL, wid, 12, 54, 416, 32, 0xffffff)
  label(wid, 16, 62, read_mem(note[1], note[2]), 0x16324f)
  sc(SYS_WIN_FILL, wid, 16 + note[2] * 12, 62, 10, 14, 0x386fa4)
def open_note(note, number):
  if note[0] != 0:
    return false
  x = 24 if number == 1 else 176
  y = 132 if number == 1 else 308
  wid = sc(SYS_WIN_CREATE, x, y, 440, 150, 0xe8edf2, 0)
  if wid < 0:
    return false
  note[0] = wid
  label(wid, 12, 12, "NOTE " + str(number) + " - RAM ONLY", 0x16324f)
  label(wid, 12, 30, "ENTER CLEAR. DOWN CLOSE.", 0x16324f)
  label(wid, 12, 116, "32 BYTES. DRAG TITLE. NOT SAVED.", 0x16324f)
  input_draw(note)
  return true
notes = [[0, buffer(), 0], [0, buffer(), 0]]
launcher = sc(SYS_WIN_CREATE, 16, 16, 608, 100, 0x224466, 0)
if launcher < 0:
  sc(SYS_EXIT, 1, 0, 0, 0, 0, 0)
label(launcher, 12, 10, "HS DESKTOP - TWO NOTES", 0xffffff)
label(launcher, 12, 34, "CLICK HERE: 1/2 OPEN NOTE. DOWN EXITS.", 0xffffff)
label(launcher, 12, 62, "CLOSE KEEPS RAM TEXT. NOT SAVED TO DISK.", 0xffffff)
open_note(notes[0], 1)
open_note(notes[1], 2)
present()
print "DESKTOP READY"
while true:
  ev = sc(SYS_WIN_KEY_ANY, 0, 0, 0, 0, 0, 0)
  if ev != 0:
    wid = ev >> 8
    key = ev & 255
    if wid == launcher:
      if key == 129:
        break
      if key == 49 or key == 50:
        number = key - 48
        if open_note(notes[number - 1], number):
          present()
          print "DESKTOP OPEN", number
    else:
      for i in range(2):
        note = notes[i]
        if note[0] == wid:
          if key == 129:
            sc(SYS_WIN_CLOSE, wid, 0, 0, 0, 0, 0)
            note[0] = 0
            print "DESKTOP CLOSE", i + 1
          else:
            changed = false
            if key == 10:
              note[2] = 0
              changed = true
            elif key == 8 and note[2] > 0:
              note[2] = note[2] - 1
              changed = true
            elif key >= 32 and key <= 126 and note[2] < 32:
              p = note[1] + note[2]
              unsafe:
                store8(as_ptr(p), key)
              note[2] = note[2] + 1
              changed = true
            if changed:
              input_draw(note)
              present()
              print "DESKTOP EDIT", i + 1, note[2]
sc(SYS_EXIT, 0, 0, 0, 0, 0, 0)
