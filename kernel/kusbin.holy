# USB HID input bridge: translates kxhci boot-protocol reports into the
# PS/2-spelling events the desktop router already speaks, so kwinroute
# needs no USB knowledge. Keyboard: 8-byte boot reports are edge-detected
# against the previous report; each newly pressed usage emits exactly one
# key code, spelled as readkey_event spells it (lowercase ASCII subset,
# Enter=10, Backspace=8, navigation 128..135, Escape=135). Mouse: buttons
# and deltas accumulate into packed kinput words; USB +dy is screen-down,
# PS/2 +dy is up, so dy is negated.
#
# start() brings up kxhci (keyboard first, mouse second, on their QEMU
# root ports), registers read hooks into kwinroute and, with exclusive,
# switches the router to usb_only so the PS/2 FIFOs are drop-drained:
# every routed event then provably arrived over xHCI.
import kpci
import kxhci
import kwinroute
QUEUE_MAX = 64
keys = []
words = []
prev = [0, 0, 0, 0, 0, 0]
cur_b = 0
acc_dx = 0
acc_dy = 0
dropped = 0
started = false
def kbd_map(u):
  # USB HID usage -> readkey_event spelling, same subset as the PS/2
  # kbdmap_ table: no shift, letters/digits/space lowercase, - , . / only.
  if u >= 4 and u <= 29:
    return u + 93
  if u >= 30 and u <= 38:
    return u + 19
  if u == 39:
    return 48
  if u == 40:
    return 10
  if u == 41:
    return 135
  if u == 42:
    return 8
  if u == 44:
    return 32
  if u == 45:
    return 45
  if u == 54:
    return 44
  if u == 55:
    return 46
  if u == 56:
    return 47
  if u == 74:
    return 132
  if u == 76:
    return 134
  if u == 77:
    return 133
  if u == 79:
    return 131
  if u == 80:
    return 130
  if u == 81:
    return 129
  if u == 82:
    return 128
  return 0
def kbd_edge():
  # Emit one code per usage that is down in this report but was not down
  # in the previous one; the boot report repeats held keys, which must
  # not repeat here. Rollover phantoms (usage 1) map to 0 and are ignored.
  global prev, dropped
  if kxhci.report_bytes() < 8:
    return 0
  i = 0
  while i < 6:
    u = kxhci.report_byte(i + 2)
    if u != 0:
      held = false
      j = 0
      while j < 6:
        if prev[j] == u:
          held = true
        j = j + 1
      if not held:
        code = kbd_map(u)
        if code != 0:
          if len(keys) >= QUEUE_MAX:
            dropped = dropped + 1
          else:
            append(keys, code)
    i = i + 1
  i = 0
  while i < 6:
    prev[i] = kxhci.report_byte(i + 2)
    i = i + 1
  return 0
def push_word(b, x, y):
  # One packed kinput word in report order; drop-newest on overflow.
  global dropped
  if len(words) >= QUEUE_MAX:
    dropped = dropped + 1
    return 0
  append(words, b + (x + 512) << 3 + (y + 512) << 13)
  return 0
def flush_motion():
  # Emit the accumulated run as packed chunks spelled with its own button
  # state, so a drag's motion reads as dragged and a plain move as plain.
  global acc_dx, acc_dy
  while acc_dx != 0 or acc_dy != 0:
    x = acc_dx
    if x < -256:
      x = -256
    if x > 255:
      x = 255
    y = acc_dy
    if y < -256:
      y = -256
    if y > 255:
      y = 255
    acc_dx = acc_dx - x
    acc_dy = acc_dy - y
    push_word(cur_b, x, y)
  return 0
def mouse_accum():
  # Boot mouse report: buttons plus int8 deltas (USB +dy is screen-down,
  # PS/2 +dy is up). A button change ends the current motion run: the run
  # flushes spelled with the previous buttons, then the edge itself is
  # queued as a word with dx=dy=0. Click edges therefore always land at
  # the final cursor position and survive pump stalls in order.
  global cur_b, acc_dx, acc_dy
  if kxhci.report1_bytes() < 3:
    return 0
  b = kxhci.report1_byte(0) & 7
  x = kxhci.report1_byte(1)
  if x > 127:
    x = x - 256
  y = kxhci.report1_byte(2)
  if y > 127:
    y = y - 256
  if b != cur_b:
    flush_motion()
    push_word(b, 0, 0)
    cur_b = b
  acc_dx = acc_dx + x
  acc_dy = acc_dy - y
  if acc_dx < -4096:
    acc_dx = -4096
  if acc_dx > 4095:
    acc_dx = 4095
  if acc_dy < -4096:
    acc_dy = -4096
  if acc_dy > 4095:
    acc_dy = 4095
  return 0
def service():
  # Pull pending interrupt-IN reports into the queues. One poll call
  # completes one transfer, so drain a bounded batch per service.
  n = 0
  while n < 8:
    if kxhci.poll() != 0:
      kbd_edge()
    n = n + 1
  n = 0
  while n < 8:
    if kxhci.poll1() != 0:
      mouse_accum()
    n = n + 1
  return 0
def read():
  # kwinroute pointer hook: oldest packed kinput word, 0 when no motion
  # and no button change is pending.
  service()
  if len(words) == 0:
    flush_motion()
  if len(words) == 0:
    return 0
  w = words[0]
  out = []
  j = 1
  while j < len(words):
    append(out, words[j])
    j = j + 1
  global words
  words = out
  return w
def readkey_event():
  # kwinroute key hook: oldest decoded key code, 0 when empty.
  global keys
  service()
  if len(keys) == 0:
    return 0
  code = keys[0]
  out = []
  j = 1
  while j < len(keys):
    append(out, keys[j])
    j = j + 1
  keys = out
  return code
def start(kbd_port, mouse_port, exclusive):
  # One-shot: keyboard on kbd_port, mouse on mouse_port (QEMU qemu-xhci
  # orders USB3 root ports first: usb-kbd is 5, usb-mouse is 6).
  global started
  if started:
    return false
  kpci.init()
  idx = kpci.find_class_pi(12, 3, 48)
  if idx < 0:
    return false
  if not kxhci.init(idx, kbd_port, 1):
    return false
  if not kxhci.init(idx, mouse_port, 2):
    return false
  kwinroute.usb_pointer_fn = read
  kwinroute.usb_key_fn = readkey_event
  kwinroute.usb_only = exclusive
  started = true
  return true
