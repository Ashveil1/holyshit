import unotebuf
fails = 0
def expect(label, got, want):
  global fails
  if got == want:
    print "ok", label
  else:
    print "FAIL", label, got, want
    fails = fails + 1
def text(note):
  return read_mem(note[1], note[2])
def type(note, value):
  for byte in value:
    unotebuf.edit(note, byte)
a = unotebuf.create()
b = unotebuf.create()
expect("empty backspace unchanged", unotebuf.edit(a, 8), false)
expect("empty delete unchanged", unotebuf.edit(a, 134), false)
expect("empty left unchanged", unotebuf.edit(a, 130), false)
expect("empty right unchanged", unotebuf.edit(a, 131), false)
expect("empty up unchanged", unotebuf.edit(a, 128), false)
expect("empty down unchanged", unotebuf.edit(a, 129), false)
type(a, [104, 105, 10, 97, 98])
expect("initial text", text(a), "hi\nab")
expect("initial cursor", unotebuf.position(a), [1, 2])
unotebuf.edit(a, 130)
unotebuf.edit(a, 88)
expect("insert in middle", text(a), "hi\naXb")
expect("caret after inserted byte", a[3], 5)
unotebuf.edit(a, 134)
expect("forward delete", text(a), "hi\naX")
unotebuf.edit(a, 132)
expect("home starts visual row", a[3], 3)
unotebuf.edit(a, 8)
expect("erase newline joins text", text(a), "hiaX")
expect("joined caret location", unotebuf.position(a), [0, 2])
unotebuf.edit(a, 10)
expect("insert newline splits text", text(a), "hi\naX")
unotebuf.edit(a, 128)
expect("vertical up keeps closest column", a[3], 0)
unotebuf.edit(a, 133)
expect("end finds visual row end", a[3], 2)
unotebuf.edit(a, 129)
expect("vertical down keeps column", a[3], 5)
expect("down past final row unchanged", unotebuf.edit(a, 129), false)
expect("independent note untouched", text(b), "")
expect("clear resets buffer", unotebuf.clear(a), true)
expect("clear resets caret", a[3], 0)
expect("clear empty unchanged", unotebuf.clear(a), false)
def guarded():
  unsafe:
    return as_int(alloc(160))
guard = guarded()
for i in range(160):
  unotebuf.put(guard + i, 90)
a[1] = guard + 16
for i in range(96):
  unotebuf.edit(a, 97)
expect("three full implicit rows", unotebuf.position(a), [2, 32])
expect("raw text omits soft newlines", a[2], 96)
expect("rendered length includes soft wraps", byte_len(unotebuf.rendered(a)), 98)
expect("overflow character refused", unotebuf.edit(a, 99), false)
expect("overflow enter refused", unotebuf.edit(a, 10), false)
unotebuf.edit(a, 132)
expect("home starts third soft row", a[3], 64)
expect("full buffer middle insert refused", unotebuf.edit(a, 98), false)
unotebuf.edit(a, 8)
expect("erase before soft boundary", a[2], 95)
expect("insert uses newly freed capacity", unotebuf.edit(a, 98), true)
expect("reflowed text still bounded", unotebuf.at(a, a[2]), [2, 32])
canaries = true
for i in range(16):
  if unotebuf.byte_at(guard + i) != 90 or unotebuf.byte_at(guard + 144 + i) != 90:
    canaries = false
for i in range(96, 128):
  if unotebuf.byte_at(a[1] + i) != 90:
    canaries = false
expect("storage and spare canaries preserved", canaries, true)
unotebuf.clear(a)
unotebuf.edit(a, 10)
unotebuf.edit(a, 10)
expect("two empty lines allowed", text(a), "\n\n")
expect("fourth empty row refused", unotebuf.edit(a, 10), false)
expect("escape ignored by buffer", unotebuf.edit(a, 135), false)
expect("NUL ignored", unotebuf.edit(a, 0), false)
expect("DEL byte ignored", unotebuf.edit(a, 127), false)
expect("high byte ignored", unotebuf.edit(a, 255), false)
unotebuf.edit(a, 130)
unotebuf.edit(a, 134)
expect("delete newline joins rows", text(a), "\n")
expect("delete retains caret", a[3], 1)
# Preserve source/caret/rendered output through an in-memory close/reopen.
a[0] = 0
expect("closed buffer position retained", unotebuf.position(a), [1, 0])
a[0] = 4
expect("reopened buffer text retained", unotebuf.rendered(a), "\n")
valid = true
for cycle in range(30):
  unotebuf.clear(a)
  for i in range(120):
    unotebuf.edit(a, 97)
  unotebuf.edit(a, 132)
  unotebuf.edit(a, 8)
  unotebuf.edit(a, 98)
  if a[2] != 96 or unotebuf.at(a, a[2]) != [2, 32]:
    valid = false
expect("repeated insert/reflow cycles", valid, true)
print "fails", fails
print "notebuf-done"
