# Self-hosted formatter CLI: `fmt.holy FILE [--comments]` prints the formatted
# source. The implementation lives in selfhost/fmtlib.holy so long-running
# processes (the language server) can reuse it in-process.
import fmtlib
import parselib

try:
  args = argv()
  src = read_text(args[0])
  comments = false
  if len(args) > 1:
    if args[1] == "--comments":
      comments = true
  print fmtlib.fmt_source(src, comments)
except as e:
  print "error: " + parselib.strip_raise(e)
  raise "fmt failed"
