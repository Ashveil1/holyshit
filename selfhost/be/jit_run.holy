# Experimental eager in-process compilation. The emitted _start exits the
# process, so the compiler driver never resumes and the OS owns final cleanup.
import parselib
import normalize
import irbuild
import verify
import be
import pyrt
import asm
import jitimage
import jitmem
import jitbind
import jitcache
extern:
  U0 exit(I64 status)
def trailing_line(s):
  n = len(s)
  k = n
  while k > 0 and find("0123456789", s[k - 1]) >= 0:
    k = k - 1
  if k == n or k < 9:
    return [s, null]
  if s[k - 9:k] != " at line ":
    return [s, null]
  return [s[0:k - 9], s[k:n]]
def error_exit(e):
  # Match the interpreter's "error: {msg} at line {line}" on stderr, rc 1.
  # py_err strings carry the target line after a u0002 marker; hs raise then
  # appends " at line N" for the driver line, so py_eline's j+1 skip reads
  # the marker's own digits. Plain raises (parselib) get the same appended
  # suffix after their baked target line, so strip one suffix only when two
  # are present.
  i = find(e, pyrt.EMARK)
  if i >= 0:
    rest = e[i + len(pyrt.EMARK):len(e)]
    j = find(rest, "u0002")
    msg = rest[0:j]
    tail = rest[j + 5:len(rest)]
    k = 0
    while k < len(tail) and find("0123456789", tail[k]) >= 0:
      k = k + 1
    if k > 0:
      msg = msg + " at line " + tail[0:k]
  else:
    msg = e
    once = trailing_line(e)
    if once[1] != null and trailing_line(once[0])[1] != null:
      msg = once[0]
  f = open("/dev/stderr", "w")
  write(f, "error: " + msg + "\n")
  close(f)
  exit(1)
def emit_prologue():
  # Forward arguments and the Linux process environment through an initial
  # stack frame. Addresses are formed at runtime, after RIP-relative relocation.
  args = argv()
  entries = ["hs-jit"] + args[1:len(args)]
  argc = len(entries)
  rawenv = read_text("/proc/self/environ")
  for value in split(rawenv, "\0"):
    if len(value) > 0:
      append(entries, value)
  entry = len(asm.state()["code"])
  slots = len(entries) + 3
  if slots % 2 == 0:
    slots = slots + 1
  asm.sub_ri32("rsp", slots * 8)
  asm.mov_ri32("rax", argc)
  asm.mov_mr("rsp", "rax", 0)
  position = 1
  for i in range(len(entries)):
    if i == argc:
      asm.mov_ri32("rax", 0)
      asm.mov_mr("rsp", "rax", position * 8)
      position = position + 1
    label = "jit_arg_" + str(i)
    asm.data_label(label)
    asm.data_bytes(pyrt.py_encode(entries[i], "utf-8"))
    asm.data_bytes([0])
    asm.lea_rip("rax", label)
    asm.mov_mr("rsp", "rax", position * 8)
    position = position + 1
  asm.mov_ri32("rax", 0)
  asm.mov_mr("rsp", "rax", position * 8)
  if len(entries) == argc:
    asm.mov_mr("rsp", "rax", (position + 1) * 8)
  asm.jmp("_start")
  return entry
def prepare():
  parselib.P["wide_literals"] = true
  srcpath = argv()[0]
  basedir = pyrt.py_os_path_dirname(srcpath)
  raw = jitcache.load_raw(srcpath)
  if raw == null:
    m = irbuild.build_module(normalize.parse(read_text(srcpath)), "")
    verify.verify_module(m)
    g = be.GenIR(m, basedir, false)
    sections = g.build_ir_extern_sections()
    jitcache.save(srcpath, g)
    handles = jitbind.bind(g.ffi_libs, g.ffi_syms, g.ffi_owners, basedir)
    entry = emit_prologue()
    image = jitimage.publish()
    return image["ptr"] + entry
  # Cache-hit fast path: no assembler-state reconstruction, no label
  # dictionaries - cache fixups are pre-resolved triples (FORMAT 2). The
  # prologue is emitted into the fresh assembler state and its named fixups
  # are resolved here to the same triple shape.
  entry_off = raw[3]
  got_plus = raw[4]
  fixups_str = raw[5]
  fixup_count = raw[6]
  code_str = raw[7]
  data_str = raw[8]
  entry = len(code_str)
  emit_prologue()
  pro = asm.state()
  pro_fixups = []
  for f in pro["fixups"]:
    name = f[1]
    if name in pro["labels"]:
      append(pro_fixups, [f[0] + entry, entry + pro["labels"][name], 0])
    elif name == "_start":
      append(pro_fixups, [f[0] + entry, entry_off, 0])
    elif name in pro["data_labels"]:
      append(pro_fixups, [f[0] + entry, len(data_str) + pro["data_labels"][name], 1])
    else:
      raise "jit: undefined label " + name
  image = jitmem.publish_raw(code_str, pro["code"], data_str, pro["data"], fixups_str, fixup_count, pro_fixups)
  got = 0
  if len(raw[1]) > 0:
    got = got_plus - 1
  handles = jitbind.bind_mem(raw[0], raw[1], raw[2], basedir, image["data"], got)
  return image["ptr"] + entry
try:
  pointer = prepare()
except as e:
  error_exit(e)
unsafe:
  I64 result = call0(as_ptr(pointer))
