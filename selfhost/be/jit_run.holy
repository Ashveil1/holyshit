# Experimental eager in-process compilation. The emitted _start exits the
# process, so the compiler driver never resumes and the OS owns final cleanup.
import parselib
import normalize
import irbuild
import verify
import be
import pyrt
import asm
import jitimage
import jitmem
import jitbind
import jitcache
extern:
  U0 exit(I64 status)
def trailing_line(s):
  n = len(s)
  k = n
  while k > 0 and find("0123456789", s[k - 1]) >= 0:
    k = k - 1
  if k == n or k < 9:
    return [s, null]
  if s[k - 9:k] != " at line ":
    return [s, null]
  return [s[0:k - 9], s[k:n]]
def error_exit(e):
  # Match the interpreter's "error: {msg} at line {line}" on stderr, rc 1.
  # py_err strings carry the target line after a u0002 marker; hs raise then
  # appends " at line N" for the driver line, so py_eline's j+1 skip reads
  # the marker's own digits. Plain raises (parselib) get the same appended
  # suffix after their baked target line, so strip one suffix only when two
  # are present.
  i = find(e, pyrt.EMARK)
  if i >= 0:
    rest = e[i + len(pyrt.EMARK):len(e)]
    j = find(rest, "u0002")
    msg = rest[0:j]
    tail = rest[j + 5:len(rest)]
    k = 0
    while k < len(tail) and find("0123456789", tail[k]) >= 0:
      k = k + 1
    if k > 0:
      msg = msg + " at line " + tail[0:k]
  else:
    msg = e
    once = trailing_line(e)
    if once[1] != null and trailing_line(once[0])[1] != null:
      msg = once[0]
  f = open("/dev/stderr", "w")
  write(f, "error: " + msg + "\n")
  close(f)
  # A compile-time failure normally exits 1 like the interpreter. When the
  # caller sets HS_JIT_FALLBACK_RC (hs run's auto path does), exit with that
  # code instead so the caller can tell "never ran the program" apart from a
  # runtime failure and fall back to another backend safely.
  # env() is null when the variable is unset, and x64 and/or do not
  # short-circuit - guard before len().
  stamp = env("HS_JIT_FALLBACK_RC")
  if stamp != null:
    if stamp != "" and len(stamp) < 4:
      ok = true
      k = 0
      while k < len(stamp):
        if find("0123456789", stamp[k]) < 0:
          ok = false
        k = k + 1
      if ok:
        exit(int(stamp))
  exit(1)
def emit_prologue():
  # Forward arguments and the Linux process environment through an initial
  # stack frame. Addresses are formed at runtime, after RIP-relative relocation.
  args = argv()
  entries = ["hs-jit"] + args[1:len(args)]
  argc = len(entries)
  rawenv = read_text("/proc/self/environ")
  for value in split(rawenv, "\0"):
    if len(value) > 0:
      append(entries, value)
  entry = len(asm.state()["code"])
  slots = len(entries) + 3
  if slots % 2 == 0:
    slots = slots + 1
  asm.sub_ri32("rsp", slots * 8)
  asm.mov_ri32("rax", argc)
  asm.mov_mr("rsp", "rax", 0)
  position = 1
  for i in range(len(entries)):
    if i == argc:
      asm.mov_ri32("rax", 0)
      asm.mov_mr("rsp", "rax", position * 8)
      position = position + 1
    label = "jit_arg_" + str(i)
    asm.data_label(label)
    asm.data_bytes(pyrt.py_encode(entries[i], "utf-8"))
    asm.data_bytes([0])
    asm.lea_rip("rax", label)
    asm.mov_mr("rsp", "rax", position * 8)
    position = position + 1
  asm.mov_ri32("rax", 0)
  asm.mov_mr("rsp", "rax", position * 8)
  if len(entries) == argc:
    asm.mov_mr("rsp", "rax", (position + 1) * 8)
  asm.jmp("_start")
  return entry
def ple32(code, v):
  append(code, v & 255)
  append(code, v >> 8 & 255)
  append(code, v >> 16 & 255)
  append(code, v >> 24 & 255)
def pmov_ri32(code, imm):
  # mov rax, imm32: 48 C7 C0 le32
  append(code, 72)
  append(code, 199)
  append(code, 192)
  ple32(code, imm)
def pmov_mr_rsp(code, disp):
  # mov [rsp+disp], rax: 48 89 modrm 24 [disp]
  append(code, 72)
  append(code, 137)
  if disp == 0:
    append(code, 4)
    append(code, 36)
  elif disp <= 127:
    append(code, 68)
    append(code, 36)
    append(code, disp)
  else:
    append(code, 132)
    append(code, 36)
    ple32(code, disp)
def emit_prologue_fast(entry, entry_off, data_base):
  # Byte-identical instruction/data layout to emit_prologue(), but emitted
  # as raw bytes with fixups resolved to (pos, target_off, is_data) triples
  # in merged-image offsets - no assembler label/fixup dictionaries. This
  # is the flat ~1.3ms of assembler overhead on every warm start.
  args = argv()
  entries = ["hs-jit"] + args[1:len(args)]
  argc = len(entries)
  rawenv = read_text("/proc/self/environ")
  for value in split(rawenv, "\0"):
    if len(value) > 0:
      append(entries, value)
  slots = len(entries) + 3
  if slots % 2 == 0:
    slots = slots + 1
  code = []
  data = []
  fixups = []
  # sub rsp, slots*8: 48 81 EC le32
  append(code, 72)
  append(code, 129)
  append(code, 236)
  ple32(code, slots * 8)
  pmov_ri32(code, argc)
  pmov_mr_rsp(code, 0)
  position = 1
  for i in range(len(entries)):
    if i == argc:
      pmov_ri32(code, 0)
      pmov_mr_rsp(code, position * 8)
      position = position + 1
    doff = len(data)
    for b in pyrt.py_encode(entries[i], "utf-8"):
      append(data, b & 255)
    append(data, 0)
    # lea rax, [rip+rel32] -> jit_arg_i in the data section
    append(code, 72)
    append(code, 141)
    append(code, 5)
    append(fixups, [entry + len(code), data_base + doff, 1])
    ple32(code, 0)
    pmov_mr_rsp(code, position * 8)
    position = position + 1
  pmov_ri32(code, 0)
  pmov_mr_rsp(code, position * 8)
  if len(entries) == argc:
    pmov_mr_rsp(code, (position + 1) * 8)
  # jmp _start (rel32 into the cached code section)
  append(code, 233)
  append(fixups, [entry + len(code), entry_off, 0])
  ple32(code, 0)
  return [code, data, fixups]
def prepare():
  parselib.P["wide_literals"] = true
  srcpath = argv()[0]
  basedir = pyrt.py_os_path_dirname(srcpath)
  raw = jitcache.load_raw(srcpath)
  if raw == null:
    m = irbuild.build_module(normalize.parse(read_text(srcpath)), "")
    verify.verify_module(m)
    g = be.GenIR(m, basedir, false)
    sections = g.build_ir_extern_sections()
    jitcache.save(srcpath, g)
    handles = jitbind.bind(g.ffi_libs, g.ffi_syms, g.ffi_owners, basedir)
    entry = emit_prologue()
    image = jitimage.publish()
    return image["ptr"] + entry
  # Cache-hit fast path: no assembler-state reconstruction, no label
  # dictionaries - cache fixups are pre-resolved triples (FORMAT 2). The
  # prologue is emitted into the fresh assembler state and its named fixups
  # are resolved here to the same triple shape.
  entry_off = raw[3]
  got_plus = raw[4]
  fixups_str = raw[5]
  fixup_count = raw[6]
  code_str = raw[7]
  data_str = raw[8]
  entry = len(code_str)
  pp = emit_prologue_fast(entry, entry_off, len(data_str))
  image = jitmem.publish_raw(code_str, pp[0], data_str, pp[1], fixups_str, fixup_count, pp[2])
  got = 0
  if len(raw[1]) > 0:
    got = got_plus - 1
  handles = jitbind.bind_mem(raw[0], raw[1], raw[2], basedir, image["data"], got)
  return image["ptr"] + entry
try:
  pointer = prepare()
except as e:
  error_exit(e)
unsafe:
  I64 result = call0(as_ptr(pointer))
