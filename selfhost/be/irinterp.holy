# Full-semantics IR interpreter tier, written in holyshit. Values are plain hs
# values; the structure mirrors the Python reference executor (ir.py _exec).
# Unsafe s* ops, ffi and builtins outside the subset are refused up front by
# preflight so no program output happens before a refusal. import/attr/setattr
# are supported: preflight_imports statically walks the import graph (parse +
# irbuild only, no execution) so unsupported ops inside modules are also
# refused up front; find/parse failures are left to the runtime path, which
# reproduces interp.py's rc-1 errors.
import normalize
import irbuild
import verify
import pyrt
import irprofile
import parselib
JUMP = "u0001IRJUMPu0001"
def trailing_line(s):
  n = len(s)
  k = n
  while k > 0 and find("0123456789", s[k - 1]) >= 0:
    k = k - 1
  if k == n or k < 9:
    return [s, null]
  if s[k - 9:k] != " at line ":
    return [s, null]
  return [s[0:k - 9], s[k:n]]
def strip_lines(e):
  s = e
  one = trailing_line(s)
  while one[1] != null:
    s = one[0]
    one = trailing_line(s)
  return s
def ir_eline(e):
  i = find(e, pyrt.EMARK)
  if i < 0:
    return null
  rest = e[i + len(pyrt.EMARK):len(e)]
  j = find(rest, "u0002")
  r = rest[j + 5:len(rest)]
  k = 0
  while k < len(r) and find("0123456789", r[k]) >= 0:
    k = k + 1
  if k == 0:
    return null
  return int(r[0:k])
def ir_emsg(e):
  i = find(e, pyrt.EMARK)
  if i < 0:
    return e
  rest = e[i + len(pyrt.EMARK):len(e)]
  return rest[0:find(rest, "u0002")]
def conv(e, ln):
  # Normalise a caught host error into an IR error carrier at line ln.
  if find(e, pyrt.EMARK) >= 0 or find(e, JUMP) >= 0:
    return e
  return pyrt.py_err(strip_lines(e), ln)
def fail(msg, ln):
  raise pyrt.py_err(msg, ln)
def new_frame(st, parent, root, gnames):
  st["nid"] = st["nid"] + 1
  return {"id": st["nid"], "vars": {}, "bound": {}, "parent": parent, "root": root, "globals": gnames, "basedir": null}
def frame_get(frame, name, ln):
  f = frame
  while f != null:
    vs = f["vars"]
    if name in vs:
      if name in f["bound"]:
        if f["bound"][name]:
          return vs[name]
    f = f["parent"]
  fail("unknown variable '" + name + "'", ln)
def bind(frame, name, val):
  frame["vars"][name] = val
  frame["bound"][name] = true
def frame_set(frame, name, val):
  if name in frame["globals"]:
    bind(frame["root"], name, val)
  else:
    bind(frame, name, val)
def frame_basedir(frame):
  f = frame
  while f != null:
    if f["basedir"] != null:
      return f["basedir"]
    f = f["parent"]
  return null
def owns(hframe, frame):
  f = frame
  while f != null:
    if f["id"] == hframe["id"]:
      return true
    f = f["parent"]
  return false
def callable_handle(record):
  # Guest functions are host closures, never guest-constructible Dict records.
  def handle():
    return record
  return handle
def is_callable_rec(v, tag):
  if pyrt.py_type(v) != "func":
    return false
  return tag in v()
def display(v):
  kind = pyrt.py_type(v)
  if kind == "func":
    record = v()
    if "hs_ir_fn" in record:
      return "<func " + record["name"] + ">"
    if "hs_ir_builtin" in record:
      return "<builtin " + record["hs_ir_builtin"] + ">"
    if "hs_ir_mod" in record:
      return "<module " + record["hs_ir_mod"] + ">"
  if kind == "list":
    parts = []
    for item in v:
      append(parts, display(item))
    return "[" + join(", ", parts) + "]"
  if kind == "dict":
    parts = []
    for key in keys(v):
      append(parts, display(key) + ": " + display(v[key]))
    return "{" + join(", ", parts) + "}"
  return str(v)
def json_guest_check(v, depth, ln):
  # Match reference conversion order before host encoding sees opaque closures.
  if depth > 200:
    fail("json too deeply nested", ln)
  kind = pyrt.py_type(v)
  if kind == "func":
    fail("not JSON-serializable: " + type_name(v), ln)
  if kind == "list":
    for item in v:
      json_guest_check(item, depth + 1, ln)
  if kind == "dict":
    names = keys(v)
    for key in names:
      if pyrt.py_type(key) != "str":
        fail("json_str needs Str keys", ln)
    for key in names:
      json_guest_check(v[key], depth + 1, ln)
BUILTIN_ARITY = {"write_bytes": 2, "append": 2, "find": 2, "join": 2, "has": 2, "contains": 2, "keys": 1, "values": 1, "read_text": 1, "write_text": 2, "append_text": 2, "append_bytes": 2, "exists": 1, "ls": 1, "mkdir": 1, "env": 1, "argv": 0, "input": 0, "json_parse": 1, "json_str": 1, "json_load": 1, "json_save": 2, "open": 2, "read": 1, "write": 2, "close": 1, "system": 1}
BUILTIN_ARITY_ERROR = {"write_bytes": "write_bytes wants write_bytes(path, [Int 0..255]|bytes)", "append": "append wants append(list, x)", "find": "find wants find(s, sub)", "join": "join wants join(sep, list)", "has": "has wants has(dict, key)", "contains": "contains wants contains(container, x)", "keys": "keys wants keys(dict)", "values": "values wants values(dict)", "read_text": "read_text wants read_text(path)", "write_text": "write_text wants write_text(path, str)", "append_text": "append_text wants append_text(path, str)", "append_bytes": "append_bytes wants append_bytes(path, [Int 0..255]|bytes)", "exists": "exists wants exists(path)", "ls": "ls wants ls(dir)", "mkdir": "mkdir wants mkdir(path)", "env": "env wants env(name)", "argv": "argv takes no args", "input": "input takes no args", "json_parse": "json_parse wants json_parse(str)", "json_str": "json_str wants json_str(x)", "json_load": "json_load wants json_load(path)", "json_save": "json_save wants json_save(path, x)", "open": "open wants open(path, mode)", "read": "read wants read(f)", "write": "write wants write(f, str)", "close": "close wants close(f)", "system": "system wants system(cmd)"}
def call_builtin(name, args, ln):
  n = len(args)
  # Validate guest arity before indexing or invoking a host builtin. Otherwise
  # extra arguments disappear and missing arguments become host index errors.
  if name in ["len", "str", "int", "float"] and n != 1:
    fail(name + " wants 1 arg, got " + str(n), ln)
  if name in BUILTIN_ARITY:
    if n != BUILTIN_ARITY[name]:
      fail(BUILTIN_ARITY_ERROR[name], ln)
  if name == "range" and n != 1 and n != 2:
    fail("range wants range(n) or range(a, b) with Ints", ln)
  if name == "split" and n != 1 and n != 2:
    fail("split wants split(s) or split(s, sep)", ln)
  try:
    if name == "len":
      if pyrt.py_type(args[0]) == "func":
        fail("len of " + type_name(args[0]), ln)
      return len(args[0])
    if name == "str":
      return display(args[0])
    if name == "int":
      if pyrt.py_type(args[0]) == "func":
        fail("cannot convert " + type_name(args[0]) + " to Int", ln)
      return int(args[0])
    if name == "float":
      kind = type_name(args[0])
      if kind not in ["Bool", "Int", "Float", "Str"]:
        fail("cannot convert " + kind + " to Float", ln)
      return float(args[0])
    if name == "range":
      # The guest reference accepts numeric endpoints and truncates Float.
      # Validate both kinds before conversion; Bool is not a guest number.
      for endpoint in args:
        if pyrt.py_type(endpoint) not in ["int", "float"]:
          fail("range wants range(n) or range(a, b) with Ints", ln)
      if n == 1:
        return range(int(args[0]))
      return range(int(args[0]), int(args[1]))
    if name == "append":
      return append(args[0], args[1])
    if name == "split":
      if n == 1:
        return split(args[0])
      return split(args[0], args[1])
    if name == "find":
      return find(args[0], args[1])
    if name == "join":
      return join(args[0], args[1])
    if name == "has":
      return has(args[0], args[1])
    if name == "contains":
      if pyrt.py_type(args[0]) == "func":
        fail("'in' needs a Str, List or Dict, got " + type_name(args[0]), ln)
      if pyrt.py_type(args[0]) == "str":
        if pyrt.py_type(args[1]) == "func":
          fail("'in <Str>' needs a Str, got " + type_name(args[1]), ln)
      return contains(args[0], args[1])
    if name == "keys":
      return keys(args[0])
    if name == "values":
      return values(args[0])
    if name == "read_text":
      return read_text(args[0])
    if name == "write_bytes":
      if pyrt.py_type(args[0]) != "str" or pyrt.py_type(args[1]) != "list":
        # this tier has no Bytes producer, so a guest Bytes cannot reach
        # here; the string still matches interp for parity
        fail("write_bytes wants write_bytes(path, [Int 0..255]|bytes)", ln)
      for byte in args[1]:
        if pyrt.py_type(byte) != "int":
          fail("write_bytes wants a list of Ints 0..255", ln)
        if byte < 0 or byte > 255:
          fail("write_bytes wants a list of Ints 0..255", ln)
      return write_bytes(args[0], args[1])
    if name == "write_text":
      return write_text(args[0], args[1])
    if name == "append_text":
      return append_text(args[0], args[1])
    if name == "append_bytes":
      if pyrt.py_type(args[0]) != "str" or pyrt.py_type(args[1]) != "list":
        # this tier has no Bytes producer, so a guest Bytes cannot reach
        # here; the string still matches interp for parity
        fail("append_bytes wants append_bytes(path, [Int 0..255]|bytes)", ln)
      for byte in args[1]:
        if pyrt.py_type(byte) != "int":
          fail("append_bytes wants a list of Ints 0..255", ln)
        if byte < 0 or byte > 255:
          fail("append_bytes wants a list of Ints 0..255", ln)
      return append_bytes(args[0], args[1])
    if name == "exists":
      return exists(args[0])
    if name == "ls":
      return ls(args[0])
    if name == "mkdir":
      return mkdir(args[0])
    if name == "env":
      return env(args[0])
    if name == "argv":
      av = argv()
      return av[1:len(av)]
    if name == "input":
      return input()
    if name == "json_parse":
      return json_parse(args[0])
    if name == "json_str":
      json_guest_check(args[0], 0, ln)
      return json_str(args[0])
    if name == "json_load":
      return json_load(args[0])
    if name == "json_save":
      if pyrt.py_type(args[0]) == "str":
        json_guest_check(args[1], 0, ln)
      return json_save(args[0], args[1])
    if name == "open":
      return open(args[0], args[1])
    if name == "read":
      return read(args[0])
    if name == "write":
      return write(args[0], args[1])
    if name == "close":
      return close(args[0])
    if name == "system":
      return system(args[0])
  except as e:
    raise conv(e, ln)
  fail("IR: builtin '" + name + "' not in subset", ln)
def call_value(st, fn, args, ln):
  if is_callable_rec(fn, "hs_ir_builtin"):
    return call_builtin(fn()["hs_ir_builtin"], args, ln)
  if is_callable_rec(fn, "hs_ir_fn"):
    record = fn()
    key = record["hs_ir_fn"]
    fdef = st["funcs"][key]
    if len(args) != len(fdef["params"]):
      fail(fdef["dispname"] + " wants " + str(len(fdef["params"])) + " args, got " + str(len(args)), ln)
    if st["dispatch"] != null:
      native = st["dispatch"](key, fdef, args)
      if native[0]:
        return native[1]
    fr = new_frame(st, record["closure"], record["closure"]["root"], fdef["globals"])
    i = 0
    while i < len(args):
      bind(fr, fdef["params"][i], args[i])
      i = i + 1
    return run_fn(st, key, fdef, fr)
  fail("not callable: " + type_name(fn), ln)
PARS = {}
def is_mod(v):
  return is_callable_rec(v, "hs_ir_mod")
def mod_find(name, basedir, ln):
  rel = pyrt.py_replace(name, ".", "/")
  hspath = [d for d in pyrt.py_split(pyrt.py_hspath(), ":") if d]
  for d in [basedir] + hspath + [pyrt.py_os_getcwd()]:
    if not d:
      continue
    p = pyrt.py_os_path_join(d, rel + ".holy")
    if not pyrt.py_os_path_isfile(p):
      p = pyrt.py_os_path_join(d, rel + ".hs")
    if pyrt.py_os_path_isfile(p):
      return pyrt.py_os_path_abspath(p)
  fail("cannot find module '" + name + "'", ln)
def mod_wrap(name, e, ln):
  if find(e, pyrt.EMARK) >= 0:
    return pyrt.py_err("in module '" + name + "': " + ir_emsg(e), ir_eline(e))
  return pyrt.py_err("in module '" + name + "': " + strip_lines(e), ln)
def mod_build(name, path):
  src = read_text(path)
  prog = normalize.parse(src)
  merge_structs()
  sub = irbuild.build_module(prog, name + ".")
  verify.verify_module(sub)
  return sub
def mod_exec(st, name, path, ln):
  if path in st["mods"]:
    ent = st["mods"][path]
    if ent["state"] == "done":
      return ent["mod"]
    if ent["state"] == "busy":
      fail("circular import '" + name + "'", ln)
  sub = null
  if path in PARS:
    sub = PARS[path]
  else:
    try:
      sub = mod_build(name, path)
    except as e:
      raise mod_wrap(name, e, ln)
    PARS[path] = sub
  mod = {"hs_ir_mod": name, "basedir": pyrt.py_os_path_dirname(path)}
  fr = new_frame(st, st["broot"], null, sub["funcs"][sub["entry"]]["globals"])
  fr["root"] = fr
  fr["basedir"] = mod["basedir"]
  mod["frame"] = fr
  mod = callable_handle(mod)
  st["mods"][path] = {"state": "busy", "mod": mod}
  for key in sub["order"]:
    st["funcs"][key] = sub["funcs"][key]
    by = {}
    for block in sub["funcs"][key]["blocks"]:
      by[block["label"]] = block
    st["by"][key] = by
  try:
    run_fn(st, sub["entry"], sub["funcs"][sub["entry"]], fr)
  except as e:
    st["mods"][path] = {"state": "failed"}
    if find(e, JUMP) >= 0:
      raise e
    raise mod_wrap(name, e, ln)
  st["mods"][path]["state"] = "done"
  return mod
def mod_shell(st, name):
  if name in st["shells"]:
    return st["shells"][name]
  fr = new_frame(st, st["broot"], null, [])
  fr["root"] = fr
  fr["basedir"] = ""
  m = callable_handle({"hs_ir_mod": name, "frame": fr, "basedir": ""})
  st["shells"][name] = m
  return m
def mod_import(st, name, frame, ln):
  if find(name, ".") >= 0:
    parts = pyrt.py_split(name, ".")
    leaf = parts[len(parts) - 1]
    parent = name[0:len(name) - len(leaf) - 1]
    pmod = null
    try:
      pmod = mod_import(st, parent, frame, ln)[0]
    except as e:
      if find(e, "cannot find module '" + parent + "'") < 0:
        raise e
      pmod = mod_shell(st, parent)
    path = mod_find(name, frame_basedir(frame), ln)
    leafmod = mod_exec(st, name, path, ln)
    bind(pmod()["frame"], leaf, leafmod)
    topname = parts[0]
    topmod = null
    try:
      topmod = mod_import(st, topname, frame, ln)[0]
    except as e:
      topmod = mod_shell(st, topname)
    return [leafmod, topmod, topname]
  if name in st["shells"]:
    m = st["shells"][name]
    return [m, m, name]
  path = mod_find(name, frame_basedir(frame), ln)
  m = mod_exec(st, name, path, ln)
  return [m, m, name]
def type_name(v):
  t = pyrt.py_type(v)
  if t == "null":
    return "Null"
  if t == "bool":
    return "Bool"
  if t == "int":
    return "Int"
  if t == "float":
    return "Float"
  if t == "str":
    return "Str"
  if t == "list":
    return "List"
  if t == "func":
    if is_callable_rec(v, "hs_ir_fn"):
      return "Func"
    if is_callable_rec(v, "hs_ir_builtin"):
      return "Builtin"
    if is_mod(v):
      return "Module"
  if t == "dict":
    return "Dict"
  return "?"
def do_binop(op, l, r, ln):
  # Keep guest numeric rejection out of host helpers with malformed errors.
  if op in ["-", "*", "/", "%"]:
    if pyrt.py_type(l) not in ["int", "float"] or pyrt.py_type(r) not in ["int", "float"]:
      fail("operator '" + op + "' needs numbers, got " + type_name(l) + " and " + type_name(r), ln)
  try:
    if op == "+":
      return l + r
    if op == "-":
      return l - r
    if op == "*":
      return l * r
    if op == "/":
      return l / r
    if op == "%":
      return l % r
    if op == "<<":
      return l << r
    if op == ">>":
      return l >> r
    if op == "&":
      return l & r
    if op == "|":
      return l | r
    if op == "^":
      return l ^ r
    if op == "==":
      return l == r
    if op == "!=":
      return l != r
    if op == "<":
      return l < r
    if op == ">":
      return l > r
    if op == "<=":
      return l <= r
    if op == ">=":
      return l >= r
  except as e:
    if pyrt.py_type(l) == "func" or pyrt.py_type(r) == "func":
      left = type_name(l)
      right = type_name(r)
      if op == "+":
        fail("cannot add " + left + " and " + right, ln)
      if op in ["-", "*", "/", "%"]:
        fail("operator '" + op + "' needs numbers, got " + left + " and " + right, ln)
      if op in ["<<", ">>", "&", "|", "^"]:
        fail("operator '" + op + "' needs Ints, got " + left + " and " + right, ln)
      if op in ["<", ">", "<=", ">="]:
        fail("cannot compare " + left + " and " + right, ln)
    raise conv(e, ln)
  fail("IR: bad binop '" + op + "'", ln)
def do_unop(op, v, ln):
  try:
    if op == "neg":
      return -v
    if op == "unot":
      return ~v
    if op == "not":
      return not v
  except as e:
    if pyrt.py_type(v) == "func":
      if op == "neg":
        fail("cannot negate " + type_name(v), ln)
      if op == "unot":
        fail("cannot bitwise-not " + type_name(v), ln)
    raise conv(e, ln)
  fail("IR: bad unop '" + op + "'", ln)
def do_slice(obj, lo, hi, ln):
  if pyrt.py_type(obj) not in ["list", "str"]:
    fail("cannot slice " + type_name(obj), ln)
  try:
    if lo == null and hi == null:
      return obj[0:len(obj)]
    if lo == null:
      return obj[0:hi]
    if hi == null:
      return obj[lo:len(obj)]
    return obj[lo:hi]
  except as e:
    raise conv(e, ln)
def step(st, ins, temps, frame, prev):
  op = ins["op"]
  ln = ins["line"]
  if op == "const":
    temps[ins["dest"]] = ins["val"]
  elif op == "load":
    v = frame_get(frame, ins["name"], ln)
    if is_uv(v):
      v = uv_box(v[1], v[2], ln)
    temps[ins["dest"]] = v
  elif op == "stvar":
    frame_set(frame, ins["name"], temps[ins["src"]])
  elif op == "stglobal":
    bind(frame["root"], ins["name"], temps[ins["src"]])
  elif op == "mkfunc":
    temps[ins["dest"]] = callable_handle({"hs_ir_fn": ins["func"], "closure": frame, "name": st["funcs"][ins["func"]]["dispname"]})
  elif op == "bin":
    temps[ins["dest"]] = do_binop(ins["binop"], temps[ins["l"]], temps[ins["r"]], ln)
  elif op == "un":
    temps[ins["dest"]] = do_unop(ins["unop"], temps[ins["v"]], ln)
  elif op == "call":
    args = []
    for a in ins["args"]:
      append(args, temps[a])
    temps[ins["dest"]] = call_value(st, temps[ins["fn"]], args, ln)
  elif op == "print":
    line = ""
    first = true
    for a in ins["args"]:
      v = temps[a]
      if not first:
        line = line + " "
      first = false
      if pyrt.py_type(v) == "str":
        line = line + v
      else:
        line = line + display(v)
    print line
  elif op == "build_list":
    items = []
    for x in ins["items"]:
      append(items, temps[x])
    temps[ins["dest"]] = items
  elif op == "build_dict":
    d = {}
    for pair in ins["pairs"]:
      try:
        d[temps[pair[0]]] = temps[pair[1]]
      except as e:
        raise conv(e, ln)
    temps[ins["dest"]] = d
  elif op == "index":
    # Container kind wins over index typing, as in the guest reference.
    if pyrt.py_type(temps[ins["obj"]]) not in ["str", "list", "dict"]:
      fail("cannot index " + type_name(temps[ins["obj"]]), ln)
    try:
      temps[ins["dest"]] = temps[ins["obj"]][temps[ins["idx"]]]
    except as e:
      raise conv(e, ln)
  elif op == "slice":
    lo = null
    hi = null
    if ins["start"] != null:
      lo = temps[ins["start"]]
      if pyrt.py_type(lo) != "int":
        fail("slice index must be Int", ln)
    if ins["stop"] != null:
      hi = temps[ins["stop"]]
      if pyrt.py_type(hi) != "int":
        fail("slice index must be Int", ln)
    temps[ins["dest"]] = do_slice(temps[ins["obj"]], lo, hi, ln)
  elif op == "sconst":
    temps[ins["dest"]] = uvmk(ins["stype"], ins["val"])
  elif op == "sload":
    temps[ins["dest"]] = sload_exec(frame, ins["name"], ln)
  elif op == "sdecl":
    sdecl_exec(frame, ins["name"], ins["utype"], temps[ins["src"]], ln)
  elif op == "sset":
    sset_exec(frame, ins["name"], temps[ins["src"]], ln)
  elif op == "dset":
    v = temps[ins["src"]]
    f = frame
    done = false
    while f != null:
      if ins["name"] in f["vars"]:
        old = f["vars"][ins["name"]]
        if is_uv(old):
          f["vars"][ins["name"]] = uvmk(old[1], uv_unbox(v, old[1], ln))
        else:
          f["vars"][ins["name"]] = v
        done = true
        break
      f = f["parent"]
    if not done:
      frame_set(frame, ins["name"], v)
  elif op == "sstore":
    pv = temps[ins["ptr"]]
    vv = temps[ins["val"]]
    if not uv_is_ptr(pv[1]):
      fail("cannot store through " + pv[1] + " (need Ptr)", ln)
    if vv[1] != "LIT" and vv[1] != "I64" and vv[1] != "U64":
      fail("cannot store " + vv[1] + " to memory (need integer)", ln)
    us_store(st, pv[2], 8, uv_coerce(vv[1], vv[2], "I64", ln), ln)
  elif op == "sfstore":
    sfstore_exec(st, temps[ins["obj"]], ins["name"], temps[ins["idx"]] if ins["idx"] != null else null, temps[ins["val"]], ln)
  elif op == "sbin":
    temps[ins["dest"]] = do_sbinop(st, ins["binop"], temps[ins["l"]], temps[ins["r"]], ln)
  elif op == "sun":
    temps[ins["dest"]] = do_sunop(ins["unop"], temps[ins["v"]], ln)
  elif op == "scall":
    sargs = []
    for a in ins["args"]:
      append(sargs, temps[a])
    temps[ins["dest"]] = do_scall(st, ins["name"], sargs, ln)
  elif op == "sderef":
    v = temps[ins["v"]]
    if not uv_is_ptr(v[1]):
      fail("cannot dereference " + v[1] + " (need Ptr)", ln)
    temps[ins["dest"]] = uvmk("I64", us_load(st, v[2], 8, ln))
  elif op == "sfield":
    temps[ins["dest"]] = sfield_exec(st, temps[ins["obj"]], ins["name"], temps[ins["idx"]] if ins["idx"] != null else null, ln)
  elif op == "box":
    v = temps[ins["src"]]
    temps[ins["dest"]] = uv_box(v[1], v[2], ln)
  elif op == "sraw":
    temps[ins["dest"]] = temps[ins["src"]][2]
  elif op == "snz":
    v = temps[ins["src"]]
    if not is_uv(v):
      fail("IR: snz of dynamic", ln)
    temps[ins["dest"]] = uvmk("I64", 0 if v[2] == 0 else 1)
  elif op == "svarptr":
    v = sload_exec(frame, ins["var"], ln)
    if ins["conv"] == "as_ptr":
      if v[1] != "LIT" and v[1] != "I64" and v[1] != "U64" and not uv_is_ptr(v[1]):
        fail("as_ptr needs an integer, got " + v[1], ln)
      temps[ins["dest"]] = uvmk("Ptr", uv_unbox(v[2], "Ptr", ln))
    else:
      if not uv_is_ptr(v[1]):
        fail("as_int needs Ptr, got " + v[1], ln)
      temps[ins["dest"]] = uvmk("U64", v[2])
  elif op == "sstr":
    temps[ins["dest"]] = ins["val"]
  elif op == "serr":
    fail(ins["imsg"], ln)
  elif op == "ssizeof":
    if ins["stype"] == "I64" or ins["stype"] == "U64" or ins["stype"] == "Ptr":
      temps[ins["dest"]] = uvmk("I64", 8)
    else:
      temps[ins["dest"]] = uvmk("I64", struct_lookup(ins["stype"], ln)["size"])
  elif op == "setindex":
    if pyrt.py_type(temps[ins["obj"]]) not in ["list", "dict"]:
      fail("cannot assign into " + type_name(temps[ins["obj"]]), ln)
    try:
      temps[ins["obj"]][temps[ins["idx"]]] = temps[ins["val"]]
    except as e:
      raise conv(e, ln)
  elif op == "iterseq":
    v = temps[ins["src"]]
    t = pyrt.py_type(v)
    if t == "dict":
      temps[ins["dest"]] = keys(v)
    elif t == "list" or t == "str":
      temps[ins["dest"]] = v
    else:
      fail("not iterable: " + type_name(v), ln)
  elif op == "copy":
    temps[ins["dest"]] = temps[ins["src"]]
  elif op == "phi":
    found = false
    for arm in ins["arms"]:
      if not found and arm[0] == prev:
        temps[ins["dest"]] = temps[arm[1]]
        found = true
    if not found:
      fail("IR: no phi arm for entry", ln)
  elif op == "try_push":
    append(st["handlers"], [frame, ins["handler"]])
  elif op == "try_pop":
    if len(st["handlers"]) > 0 and st["handlers"][len(st["handlers"]) - 1][0]["id"] == frame["id"]:
      pop_handler(st)
  elif op == "exc_str":
    act = st["active"]
    if len(act) == 0:
      fail("raise without active exception", ln)
    top = act[len(act) - 1]
    s = top[0]
    if top[1] != null:
      s = s + " at line " + str(top[1])
    temps[ins["dest"]] = s
  elif op == "exc_pop":
    if len(st["active"]) > 0:
      pop_active(st)
  elif op == "unbind":
    frame["bound"][ins["name"]] = false
  elif op == "reraise":
    act = st["active"]
    if len(act) == 0:
      fail("raise without active exception", ln)
    top = act[len(act) - 1]
    raise pyrt.py_err(top[0], top[1])
  elif op == "import":
    r = mod_import(st, ins["name"], frame, ln)
    frame_set(frame, r[2], r[1])
  elif op == "attr":
    obj = temps[ins["obj"]]
    if not is_mod(obj):
      fail("only modules have attributes", ln)
    obj = obj()
    nm = ins["name"]
    mvs = obj["frame"]["vars"]
    bound = obj["frame"]["bound"]
    present = false
    if nm in mvs and nm in bound:
      present = bound[nm]
    if not present:
      fail("module '" + obj["hs_ir_mod"] + "' has no attribute '" + nm + "'", ln)
    v = mvs[nm]
    if is_uv(v):
      v = uv_box(v[1], v[2], ln)
    temps[ins["dest"]] = v
  elif op == "setattr":
    obj = temps[ins["obj"]]
    if not is_mod(obj):
      fail("only modules have attributes", ln)
    bind(obj()["frame"], ins["name"], temps[ins["val"]])
  else:
    fail("IR: bad op '" + op + "'", ln)
def pop_handler(st):
  n = len(st["handlers"])
  st["handlers"] = st["handlers"][0:n - 1]
def pop_active(st):
  n = len(st["active"])
  st["active"] = st["active"][0:n - 1]
def unwind(st, frame):
  while len(st["handlers"]) > 0 and not owns(st["handlers"][len(st["handlers"]) - 1][0], frame):
    pop_handler(st)
  if len(st["handlers"]) == 0:
    return null
  top = st["handlers"][len(st["handlers"]) - 1]
  pop_handler(st)
  return top
def do_raise(st, tm, temps):
  ln = tm["line"]
  if tm["src"] == null:
    act = st["active"]
    if len(act) == 0:
      fail("raise without active exception", ln)
    top = act[len(act) - 1]
    raise pyrt.py_err(top[0], top[1])
  v = temps[tm["src"]]
  if pyrt.py_type(v) != "str":
    fail("raise wants Str", ln)
  fail(v, ln)
def run_fn(st, key, fdef, frame):
  by = st["by"][key]
  profile = st["profile"]
  if profile != null:
    types = []
    for name in fdef["params"]:
      append(types, type_name(frame["vars"][name]))
    irprofile.record(profile, key, "entry", "", types)
  temps = {}
  lab = fdef["entry"]
  prev = null
  while true:
    b = by[lab]
    if profile != null:
      irprofile.record(profile, key, "block", lab, null)
    caught = null
    try:
      for ins in b["instrs"]:
        step(st, ins, temps, frame, prev)
      tm = b["term"]
      t = tm["term"]
      if t == "jmp":
        prev = lab
        lab = tm["to"]
      elif t == "br":
        prev = lab
        if temps[tm["cond"]]:
          lab = tm["then"]
        else:
          lab = tm["els"]
      elif t == "ret":
        if tm["val"] != null:
          return temps[tm["val"]]
        return null
      elif t == "raise":
        do_raise(st, tm, temps)
      else:
        fail("IR: bad terminator", tm["line"])
    except as e:
      caught = e
    if caught != null:
      err = caught
      if find(err, JUMP) >= 0:
        j = st["jump"]
        if j[0] != frame["id"]:
          raise err
        append(st["active"], [j[2], j[3]])
        lab = j[1]
        prev = null
      else:
        if find(err, pyrt.EMARK) < 0:
          err = pyrt.py_err(strip_lines(err), null)
        msg = ir_emsg(err)
        eline = ir_eline(err)
        tgt = unwind(st, frame)
        if tgt == null:
          raise err
        if tgt[0]["id"] != frame["id"]:
          st["jump"] = [tgt[0]["id"], tgt[1], msg, eline]
          raise JUMP
        append(st["active"], [msg, eline])
        lab = tgt[1]
        prev = null
SUPPORTED = ["const", "load", "stvar", "stglobal", "mkfunc", "bin", "un", "call", "print", "build_list", "build_dict", "index", "slice", "setindex", "iterseq", "copy", "phi", "try_push", "try_pop", "exc_str", "exc_pop", "unbind", "reraise", "import", "attr", "setattr", "sconst", "sdecl", "sset", "dset", "sstore", "sfstore", "sload", "sderef", "sfield", "sbin", "sun", "scall", "snz", "svarptr", "sstr", "serr", "ssizeof", "box", "sraw"]
BUILTIN_NAMES = ["len", "str", "int", "float", "range", "append", "split", "find", "join", "has", "contains", "keys", "values", "read_text", "write_bytes", "write_text", "append_text", "append_bytes", "exists", "ls", "mkdir", "env", "argv", "input", "json_parse", "json_str", "json_load", "json_save", "open", "read", "write", "close", "system"]
OTHER_BUILTINS = ["byte_len", "byte_find", "byte_at", "alloc", "as_int", "as_ptr", "http_get", "load32", "load64", "load8", "meminfo", "pmm_alloc", "pmm_free", "pmm_total", "read_mem", "readkey", "readkey_code", "readkey_nav", "readkey_event", "store32", "store64", "store8", "tcp_accept", "tcp_close", "tcp_connect", "tcp_listen", "tcp_recv", "tcp_send", "ticks"]

# ---- unsafe static execution ----
# Guest UnsafeVal = [UVTAG, utype, val]; utype in I64/U64/LIT/Ptr/Ptr:Struct.
# val is a plain hs Int holding the signed 64-bit interpretation. Words whose
# value escapes the 62-bit Int range follow the hosted backends' box behavior
# rather than interp.py's exact big-int arithmetic (documented tier boundary);
# everything inside the range is exact.
UVTAG = "\0uv"
def is_uv(v):
  return pyrt.py_type(v) == "list" and len(v) == 3 and v[0] == UVTAG
def uvmk(utype, val):
  return [UVTAG, utype, val]
def uv_is_ptr(t):
  return t == "Ptr" or t[0:4] == "Ptr:"
def uv_ptr_struct(t):
  if t[0:4] == "Ptr:":
    return t[4:]
  return null

# Host-side helpers: one unsafe op each, so guest 64-bit arithmetic uses real
# hardware wrap semantics instead of trapping on the host's 62-bit Int range.
def h_alloc(n):
  unsafe:
    return as_int(alloc(n))
def h_load(base, addr, size):
  unsafe:
    Ptr p = as_ptr(base + addr)
    I64 r = 0
    I64 i = 0
    while i < size:
      r = r | (load8(p + i) << (i * 8))
      i = i + 1
    return r
def h_store(base, addr, size, v):
  unsafe:
    Ptr p = as_ptr(base + addr)
    I64 vv = v
    I64 i = 0
    while i < size:
      store8(p + i, (vv >> (i * 8)) & 255)
      i = i + 1
    return 0
def h_i64add(a, b):
  unsafe:
    I64 x = a
    I64 y = b
    return x + y
def h_i64sub(a, b):
  unsafe:
    I64 x = a
    I64 y = b
    return x - y
def h_i64mul(a, b):
  unsafe:
    I64 x = a
    I64 y = b
    return x * y
def h_i64div(a, b):
  unsafe:
    I64 x = a
    I64 y = b
    return x / y
def h_i64mod(a, b):
  unsafe:
    I64 x = a
    I64 y = b
    return x % y
def h_u64div(a, b):
  unsafe:
    U64 x = a
    U64 y = b
    return x / y
def h_u64mod(a, b):
  unsafe:
    U64 x = a
    U64 y = b
    return x % y
def h_i64shl(a, b):
  unsafe:
    I64 x = a
    I64 y = b
    return x << y
def h_i64neg(a):
  unsafe:
    I64 x = a
    return 0 - x

# Struct layouts accumulate per program across module parses (interp.py's
# HS_STRUCTS lifetime); parselib resets P["structs"] on each parse, so every
# parse result is merged here right after the parse call.
ISTRUCTS = {}
def merge_structs():
  for k in keys(parselib.P["structs"]):
    lay = parselib.P["structs"][k]
    if has(ISTRUCTS, k) and ISTRUCTS[k] != lay:
      raise "struct '" + k + "' redefined with a different layout"
    ISTRUCTS[k] = lay
def struct_lookup(sname, ln):
  if not has(ISTRUCTS, sname):
    fail("unknown struct '" + sname + "'", ln)
  return ISTRUCTS[sname]
def struct_field_of(sname, fname, ln):
  lay = struct_lookup(sname, ln)
  if not has(lay["fields"], fname):
    fail("struct '" + sname + "' has no field '" + fname + "'", ln)
  return lay["fields"][fname]

# Guest simulated memory: 1MB, addresses are indices, 0 = NULL, US_TOP = 8.
def us_mem(st):
  if st["us_base"] == 0:
    st["us_base"] = h_alloc(1048576)
  return st["us_base"]
def us_check(addr, size, ln):
  if addr == 0:
    fail("null pointer dereference", ln)
  if addr < 0 or addr + size > 1048576:
    fail("unsafe: address out of bounds", ln)
def us_load(st, addr, size, ln):
  us_check(addr, size, ln)
  return h_load(us_mem(st), addr, size)
def us_store(st, addr, size, v, ln):
  us_check(addr, size, ln)
  h_store(us_mem(st), addr, size, v)
def us_alloc(st, n, ln):
  if n < 0:
    fail("alloc of negative size " + str(n), ln)
  n = (n + 7) - (n + 7) % 8
  if st["us_top"] + n > 1048576:
    fail("unsafe: out of memory (1MB sim)", ln)
  addr = st["us_top"]
  base = us_mem(st)
  i = 0
  while i < n:
    h_store(base, addr + i, 1, 0)
    i = i + 1
  st["us_top"] = addr + n
  return addr

def uv_box(utype, v, ln):
  if utype == "I64" or utype == "LIT" or utype == "U64" or uv_is_ptr(utype):
    return v
  fail("bad static type " + utype, ln)
def uv_unbox(v, target, ln):
  if pyrt.py_type(v) == "bool":
    if v:
      v = 1
    else:
      v = 0
  if target == "I64":
    if pyrt.py_type(v) == "int":
      return v
    fail("cannot use " + type_name(v) + " as I64", ln)
  if target == "U64" or uv_is_ptr(target):
    if pyrt.py_type(v) == "int":
      if v < 0:
        fail("negative value " + str(v) + " as " + target, ln)
      return v
    fail("cannot use " + type_name(v) + " as " + target, ln)
  fail("bad static type " + target, ln)
def uv_coerce(st_, sv, target, ln):
  if st_ == "LIT":
    return uv_unbox(sv, target, ln)
  if st_ == target:
    return sv
  if uv_is_ptr(st_) and uv_is_ptr(target):
    return sv
  if target == "I64" and st_ == "U64":
    return sv
  if target == "U64" and st_ == "I64":
    if sv < 0:
      fail("negative value " + str(sv) + " as U64", ln)
    return sv
  fail("cannot convert " + st_ + " to " + target, ln)

def do_sbinop(st, op, l, r, ln):
  lt = l[1]
  lv = l[2]
  rt = r[1]
  rv = r[2]
  if op == "==" or op == "!=":
    if uv_is_ptr(lt) or uv_is_ptr(rt):
      if not (uv_is_ptr(lt) and uv_is_ptr(rt)):
        fail("cannot compare " + lt + " and " + rt, ln)
      eq = lv == rv
    else:
      kset = {}
      if lt != "LIT":
        kset[lt] = true
      if rt != "LIT":
        kset[rt] = true
      if len(kset) == 2 and has(kset, "I64") and has(kset, "U64"):
        fail("cannot compare I64 and U64 (convert explicitly)", ln)
      tgt = "I64"
      if len(kset) > 0:
        tgt = keys(kset)[0]
      eq = uv_coerce(lt, lv, tgt, ln) == uv_coerce(rt, rv, tgt, ln)
    if op == "==":
      return uvmk("I64", 1 if eq else 0)
    return uvmk("I64", 0 if eq else 1)
  if op == "<" or op == ">" or op == "<=" or op == ">=":
    if uv_is_ptr(lt) or uv_is_ptr(rt):
      fail("cannot order pointers (use == / !=)", ln)
    if lt != rt and ((lt == "I64" and rt == "U64") or (lt == "U64" and rt == "I64")):
      fail("cannot compare I64 and U64 (convert explicitly)", ln)
    tgt = lt
    if lt == "LIT":
      tgt = rt
    if tgt == "LIT":
      tgt = "I64"
    a = uv_coerce(lt, lv, tgt, ln)
    b = uv_coerce(rt, rv, tgt, ln)
    res = false
    if op == "<":
      res = a < b
    elif op == ">":
      res = a > b
    elif op == "<=":
      res = a <= b
    else:
      res = a >= b
    return uvmk("I64", 1 if res else 0)
  if uv_is_ptr(lt) or uv_is_ptr(rt):
    lxs = uv_ptr_struct(lt)
    rxs = uv_ptr_struct(rt)
    if op == "+" and lxs != null and (rt == "I64" or rt == "U64" or rt == "LIT"):
      return uvmk(lt, h_i64add(lv, h_i64mul(uv_coerce(rt, rv, "I64", ln), struct_lookup(lxs, ln)["size"])))
    if op == "+" and rxs != null and (lt == "I64" or lt == "U64" or lt == "LIT"):
      return uvmk(rt, h_i64add(rv, h_i64mul(uv_coerce(lt, lv, "I64", ln), struct_lookup(rxs, ln)["size"])))
    if op == "-" and lxs != null and (rt == "I64" or rt == "U64" or rt == "LIT"):
      return uvmk(lt, h_i64sub(lv, h_i64mul(uv_coerce(rt, rv, "I64", ln), struct_lookup(lxs, ln)["size"])))
    if op == "-" and lxs != null and rxs != null and lxs == rxs:
      d = h_i64sub(lv, rv)
      q = h_i64div(d if d >= 0 else 0 - d, struct_lookup(lxs, ln)["size"])
      return uvmk("I64", 0 - q if d < 0 else q)
    if lt == "Ptr" or rt == "Ptr":
      if op == "+" and lt == "Ptr" and (rt == "I64" or rt == "U64" or rt == "LIT"):
        return uvmk("Ptr", h_i64add(lv, uv_coerce(rt, rv, "I64", ln)))
      if op == "+" and rt == "Ptr" and (lt == "I64" or lt == "U64" or lt == "LIT"):
        return uvmk("Ptr", h_i64add(rv, uv_coerce(lt, lv, "I64", ln)))
      if op == "-" and lt == "Ptr" and (rt == "I64" or rt == "U64" or rt == "LIT"):
        return uvmk("Ptr", h_i64sub(lv, uv_coerce(rt, rv, "I64", ln)))
      if op == "-" and lt == "Ptr" and rt == "Ptr":
        return uvmk("I64", h_i64sub(lv, rv))
    fail("cannot apply '" + op + "' to pointers", ln)
  tgt = lt
  if lt == "LIT":
    tgt = rt
  if tgt == "LIT":
    tgt = "I64"
  a = uv_coerce(lt, lv, tgt, ln)
  b = uv_coerce(rt, rv, tgt, ln)
  res = 0
  if op == "+":
    res = h_i64add(a, b)
  elif op == "-":
    res = h_i64sub(a, b)
  elif op == "*":
    res = h_i64mul(a, b)
  elif op == "/":
    if b == 0:
      fail("division by zero", ln)
    if tgt == "U64":
      res = h_u64div(a, b)
    else:
      res = h_i64div(a, b)
  elif op == "%":
    if b == 0:
      fail("division by zero", ln)
    if tgt == "U64":
      res = h_u64mod(a, b)
    else:
      res = h_i64mod(a, b)
  elif op == "&":
    res = a & b
  elif op == "|":
    res = a | b
  elif op == "^":
    res = a ^ b
  elif op == "<<":
    if b < 0 or b > 63:
      fail("shift count " + str(b) + " out of range (0..63)", ln)
    res = h_i64shl(a, b)
  elif op == ">>":
    if b < 0 or b > 63:
      fail("shift count " + str(b) + " out of range (0..63)", ln)
    res = a >> b
  else:
    fail("bad operator " + op, ln)
  return uvmk(tgt, res)

def do_sunop(op, v, ln):
  st_ = v[1]
  sv = v[2]
  if op == "neg":
    if uv_is_ptr(st_):
      fail("cannot negate Ptr", ln)
    if st_ == "LIT":
      return uvmk("LIT", 0 - sv)
    if st_ == "I64":
      return uvmk("I64", h_i64neg(sv))
    return uvmk("U64", h_i64neg(sv))
  if op == "unot":
    if uv_is_ptr(st_):
      fail("cannot bitwise-not Ptr", ln)
    return uvmk(st_, 0 - sv - 1)
  if op == "not":
    return uvmk("I64", 0 if sv != 0 else 1)
  fail("IR: bad sunop '" + op + "'", ln)

def do_scall(st, name, args, ln):
  if name not in ["alloc", "load8", "load32", "load64", "store8", "store32", "store64", "as_ptr", "as_int", "asm", "call0"]:
    fail("cannot call '" + name + "' from unsafe (only: alloc, as_int, as_ptr, asm, call0, load32, load64, load8, store32, store64, store8)", ln)
  if name == "call0":
    if len(args) != 1:
      fail("call0 wants call0(p)", ln)
    if not uv_is_ptr(args[0][1]):
      fail("call0 needs Ptr", ln)
    if args[0][2] == 0:
      fail("call0 needs non-null Ptr", ln)
    fail("call0 needs foreign executable memory", ln)
  if name == "alloc":
    if len(args) != 1:
      fail("alloc wants alloc(n)", ln)
    return uvmk("Ptr", us_alloc(st, uv_coerce(args[0][1], args[0][2], "I64", ln), ln))
  if name == "load8" or name == "load32" or name == "load64":
    if len(args) != 1:
      fail(name + " wants " + name + "(p)", ln)
    if not uv_is_ptr(args[0][1]):
      fail(name + " needs Ptr, got " + args[0][1], ln)
    sz = 1
    if name == "load32":
      sz = 4
    if name == "load64":
      sz = 8
    return uvmk("I64", us_load(st, args[0][2], sz, ln))
  if name == "store8" or name == "store32" or name == "store64":
    if len(args) != 2:
      fail(name + " wants " + name + "(p, v)", ln)
    if not uv_is_ptr(args[0][1]):
      fail(name + " needs Ptr, got " + args[0][1], ln)
    vv = uv_coerce(args[1][1], args[1][2], "I64", ln)
    sz = 1
    mask = 255
    if name == "store32":
      sz = 4
      mask = 4294967295
    if name == "store64":
      sz = 8
      mask = 0
    us_store(st, args[0][2], sz, vv, ln)
    if mask == 0:
      return uvmk("I64", vv)
    return uvmk("I64", vv & mask)
  if name == "as_ptr":
    if len(args) != 1:
      fail("as_ptr wants as_ptr(int)", ln)
    at = args[0][1]
    if at != "LIT" and at != "I64" and at != "U64" and not uv_is_ptr(at):
      fail("as_ptr needs an integer, got " + at, ln)
    return uvmk("Ptr", uv_unbox(args[0][2], "Ptr", ln))
  if name == "as_int":
    if len(args) != 1:
      fail("as_int wants as_int(p)", ln)
    if not uv_is_ptr(args[0][1]):
      fail("as_int needs Ptr, got " + args[0][1], ln)
    return uvmk("U64", args[0][2])
  if name == "asm":
    fail("asm requires native build (hs.py build)", ln)
  fail("bad unsafe call " + name, ln)

def sdecl_exec(frame, name, utype, v, ln):
  if name in frame["vars"]:
    fail("'" + name + "' already defined in this scope", ln)
  frame["vars"][name] = uvmk(utype, uv_coerce(v[1], v[2], utype, ln))
  frame["bound"][name] = true
def sset_exec(frame, name, v, ln):
  f = frame
  while f != null:
    if name in f["vars"]:
      old = f["vars"][name]
      if is_uv(old):
        f["vars"][name] = uvmk(old[1], uv_coerce(v[1], v[2], old[1], ln))
      else:
        frame_set(frame, name, uv_box(v[1], v[2], ln))
      return
    f = f["parent"]
  frame_set(frame, name, uv_box(v[1], v[2], ln))
def sload_exec(frame, name, ln):
  f = frame
  while f != null:
    if name in f["vars"]:
      v = f["vars"][name]
      if is_uv(v):
        return v
      return uvmk("I64", uv_unbox(v, "I64", ln))
    f = f["parent"]
  fail("unknown variable '" + name + "'", ln)
def sfield_exec(st, obj, name, idx, ln):
  st_ = obj[1]
  sv = obj[2]
  xs = uv_ptr_struct(st_)
  if xs == null:
    fail("cannot access field of " + st_ + " (need a struct pointer)", ln)
  if sv == 0:
    fail("null pointer dereference", ln)
  f = struct_field_of(xs, name, ln)
  ft = f[0]
  off = f[1]
  count = f[2]
  i = 0
  if count > 1:
    if idx == null:
      fail("array field '" + name + "' needs an index", ln)
    i = uv_coerce(idx[1], idx[2], "I64", ln)
    if i < 0 or i >= count:
      fail("index " + str(i) + " out of range for '" + name + "'[" + str(count) + "]", ln)
  else:
    if idx != null:
      fail("field '" + name + "' is not an array", ln)
  return uvmk(ft, us_load(st, sv + off + i * 8, 8, ln))
def sfstore_exec(st, obj, name, idx, val, ln):
  xs = uv_ptr_struct(obj[1])
  if xs == null:
    fail("cannot store field of " + obj[1] + " (need a struct pointer)", ln)
  if obj[2] == 0:
    fail("null pointer dereference", ln)
  f = struct_field_of(xs, name, ln)
  ft = f[0]
  off = f[1]
  count = f[2]
  i = 0
  if count > 1:
    if idx == null:
      fail("array field '" + name + "' needs an index", ln)
    i = uv_coerce(idx[1], idx[2], "I64", ln)
    if i < 0 or i >= count:
      fail("index " + str(i) + " out of range for '" + name + "'[" + str(count) + "]", ln)
  else:
    if idx != null:
      fail("field '" + name + "' is not an array", ln)
  us_store(st, obj[2] + off + i * 8, 8, uv_coerce(val[1], val[2], ft, ln), ln)
def preflight(irmod):
  # Returns null when every instruction is supported, else a refusal message.
  # Builtins outside the supported subset are refused when the program loads
  # such a name without ever binding it itself.
  assigned = {}
  for key in irmod["order"]:
    fn = irmod["funcs"][key]
    for p in fn["params"]:
      assigned[p] = true
    for block in fn["blocks"]:
      for ins in block["instrs"]:
        if ins["op"] == "stvar" or ins["op"] == "stglobal":
          assigned[ins["name"]] = true
  for key in irmod["order"]:
    fn = irmod["funcs"][key]
    for block in fn["blocks"]:
      for ins in block["instrs"]:
        if ins["op"] not in SUPPORTED:
          return "irinterp: unsupported instruction " + ins["op"]
        if ins["op"] == "load" and ins["name"] in OTHER_BUILTINS and ins["name"] not in assigned:
          return "irinterp: unsupported builtin " + ins["name"]
  return null
def preflight_imports(irmod, basedir):
  # Statically walk the import graph (parse + irbuild only, no execution) so
  # unsupported ops inside reachable modules are refused up front, like the
  # root module's. Modules that fail to find or build are skipped: the
  # runtime path then reproduces interp.py's rc-1 errors. Parsed modules are
  # cached in PARS so execution does not rebuild them.
  queue = [[irmod, basedir]]
  seen = {}
  while len(queue) > 0:
    cur = queue[0]
    queue = queue[1:len(queue)]
    irm = cur[0]
    bdir = cur[1]
    for key in irm["order"]:
      fn = irm["funcs"][key]
      for block in fn["blocks"]:
        for ins in block["instrs"]:
          if ins["op"] == "import":
            name = ins["name"]
            path = null
            try:
              path = mod_find(name, bdir, null)
            except as e:
              path = null
            if path == null:
              continue
            if path in seen:
              continue
            seen[path] = true
            sub = null
            try:
              sub = mod_build(name, path)
            except as e:
              sub = null
            if sub == null:
              continue
            PARS[path] = sub
            r = preflight(sub)
            if r != null:
              return r
            append(queue, [sub, pyrt.py_os_path_dirname(path)])
  return null
def create(irmod, basedir):
  st = {"funcs": {}, "by": {}, "handlers": [], "active": [], "jump": null, "nid": 0, "entry": irmod["entry"], "basedir": basedir, "broot": null, "profile": null, "dispatch": null, "mods": {}, "shells": {}, "us_base": 0, "us_top": 8}
  for key in irmod["order"]:
    st["funcs"][key] = irmod["funcs"][key]
    by = {}
    for block in irmod["funcs"][key]["blocks"]:
      by[block["label"]] = block
    st["by"][key] = by
  return st
def run(st):
  root = new_frame(st, null, null, [])
  root["root"] = root
  root["basedir"] = st["basedir"]
  st["broot"] = root
  for name in BUILTIN_NAMES:
    bind(root, name, callable_handle({"hs_ir_builtin": name}))
  main = st["funcs"][st["entry"]]
  frame = new_frame(st, root, root, main["globals"])
  frame["root"] = frame
  frame["basedir"] = st["basedir"]
  run_fn(st, st["entry"], main, frame)
