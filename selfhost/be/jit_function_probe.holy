# Exact IR-key direct calls with immediate arguments, not a public function ABI.
import jitboundary
import jitmem
args = argv()
if len(args) != 3:
  raise "function probe wants SOURCE EXACT_IR_KEY JSON_ARGUMENT_SETS"
sets = json_parse(args[2])
state = jitboundary.prepare_function(args[0], true, args[1], sets)
initial = jitboundary.scalar_outcome(state, state[1], false)
results = []
if initial[0] == 0:
  for pointer in state[5]:
    append(results, jitboundary.scalar_outcome(state, pointer, true))
arenas = jitboundary.release_heap(state, false)
jitmem.release(state[0])
print "JIT FUNCTION INITIAL", json_str(initial)
print "JIT FUNCTION RESULTS", json_str(results)
print "JIT FUNCTION RELEASED", arenas, state[0]["live"]
