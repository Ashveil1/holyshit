# Executable bounded cold IR subset. No target machine-code generation.
import pyrt
import verify
def integer(value):
  if pyrt.py_type(value) != "int" or value < -536870912 or value > 536870911:
    raise "cold scalar: wants signed30-bit integer"
  return value
def scalar(value):
  kind = pyrt.py_type(value)
  if kind == "int":
    integer(value)
  elif kind != "bool" and value != null:
    raise "cold scalar: unsupported value"
  return value
def text(value):
  if len(value) > 1024:
    raise "cold scalar: text exceeds1024 bytes"
  for character in value:
    if (character < " " or character > "~") and character not in ["\n", "\t", "\r"]:
      raise "cold scalar: text supports printable ASCII/newline/tab/return only"
  return value
def constant(value):
  if pyrt.py_type(value) == "str":
    return text(value)
  return scalar(value)
def text_charge(state, length):
  if length > 1024 or state[10] + length > 65536:
    raise "cold scalar: text byte budget exhausted"
  state[10] = state[10] + length
def preflight(irmod):
  verify.verify_module(irmod)
  if len(irmod["order"]) > 256:
    raise "cold scalar: more than256 functions"
  plans = {}
  for key in irmod["order"]:
    fn = irmod["funcs"][key]
    locals = {}
    blocks = {}
    for name in fn["params"]:
      locals[name] = true
    for block in fn["blocks"]:
      blocks[block["label"]] = block
      for ins in block["instrs"]:
        op = ins["op"]
        if op == "const":
          constant(ins["val"])
        elif op == "bin":
          if ins["binop"] not in ["+", "-", "*", "==", "!=", "<", "<=", ">", ">="]:
            raise "cold scalar: unsupported binary operator"
        elif op == "un":
          if ins["unop"] not in ["neg", "not", "pos"]:
            raise "cold scalar: unsupported unary operator"
        elif op == "mkfunc":
          if key != irmod["entry"]:
            raise "cold scalar: nested functions unsupported"
        elif op == "stvar":
          if ins["name"] not in fn["globals"]:
            locals[ins["name"]] = true
        elif op not in ["load", "stglobal", "call", "phi", "copy", "build_list", "index", "setindex", "slice", "iterseq", "print"]:
          raise "cold scalar: unsupported instruction " + op
      if block["term"]["term"] not in ["ret", "jmp", "br"]:
        raise "cold scalar: unsupported terminator"
    plans[key] = [locals, blocks]
  return plans
def create(irmod, limit):
  limit = integer(limit)
  if limit < 1 or limit > 10000000:
    raise "cold scalar: step limit must be1..10000000"
  plans = preflight(irmod)
  counts = {}
  for key in irmod["order"]:
    counts[key] = 0
  return [irmod, plans, {}, 0, limit, 0, counts, false, 0, 0, 0]
# Explicit trusted host bridge, not hot compilation or native object sharing.
# Install only before run. Normal source global assignment still shadows it.
def bind_scalar_bridge(state, name, handler, context):
  if state[7]:
    raise "cold scalar: cannot bind after start"
  if len(name) < 1 or len(name) > 128:
    raise "cold scalar: invalid bridge identifier"
  for index in range(len(name)):
    allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    if index != 0:
      allowed = allowed + "0123456789"
    if find(allowed, name[index]) < 0:
      raise "cold scalar: invalid bridge identifier"
  state[2][name] = {"cold_kind": "scalar_bridge", "handler": handler, "context": context, "calls": 0}
def tick(state):
  if state[3] >= state[4]:
    raise "cold scalar: instruction budget exhausted"
  state[3] = state[3] + 1
def binary(state, op, left, right):
  left_text = pyrt.py_type(left) == "str"
  right_text = pyrt.py_type(right) == "str"
  if left_text or right_text:
    if not left_text or not right_text:
      raise "cold scalar: text operands must both be Str"
    if op == "+":
      length = len(left) + len(right)
      text_charge(state, length)
      return left + right
    if op == "==":
      return left == right
    if op == "!=":
      return left != right
    if op == "<":
      return left < right
    if op == "<=":
      return left <= right
    if op == ">":
      return left > right
    if op == ">=":
      return left >= right
    raise "cold scalar: unsupported text operator"
  scalar(left)
  scalar(right)
  if op == "==":
    return left == right
  if op == "!=":
    return left != right
  left = integer(left)
  right = integer(right)
  if op == "+":
    return integer(left + right)
  if op == "-":
    return integer(left - right)
  if op == "*":
    return integer(left * right)
  if op == "<":
    return left < right
  if op == "<=":
    return left <= right
  if op == ">":
    return left > right
  return left >= right
# Source lists are explicit interpreter-owned records, never raw Func records.
# Flat scalar elements keep cycles/nested identity outside this first boundary.
def list_items(value):
  if pyrt.py_type(value) != "dict" or "cold_kind" not in value or value["cold_kind"] != "list":
    raise "cold scalar: wants flat scalar List"
  return value["items"]
def truth(value):
  if pyrt.py_type(value) == "str":
    return len(value) != 0
  if pyrt.py_type(value) == "dict" and "cold_kind" in value and value["cold_kind"] == "list":
    return len(value["items"]) != 0
  scalar(value)
  return not not value
def list_index(items, index):
  index = integer(index)
  if index < 0:
    index = index + len(items)
  if index < 0 or index >= len(items):
    raise "cold scalar: list index out of range"
  return index
def charge(state, slots, created):
  if slots > 4096:
    raise "cold scalar: list exceeds4096 elements"
  if created and state[8] >= 1024 or state[9] + slots > 65536:
    raise "cold scalar: list allocation budget exhausted"
  if created:
    state[8] = state[8] + 1
  state[9] = state[9] + slots
def builtin(state, name, args):
  if name == "range":
    if len(args) < 1 or len(args) > 2:
      raise "cold scalar: range wants range(n) or range(a, b)"
    start = 0
    if len(args) == 2:
      start = integer(args[0])
    stop = integer(args[len(args) - 1])
    count = stop - start
    if count < 0:
      count = 0
    if count > 4096:
      raise "cold scalar: list exceeds4096 elements"
    charge(state, count, true)
    items = []
    i = start
    while i < stop:
      append(items, i)
      i = i + 1
    return {"cold_kind": "list", "items": items}
  if name == "str":
    if len(args) != 1:
      raise "cold scalar: str wants 1 arg"
    value = args[0]
    if pyrt.py_type(value) == "str":
      return value
    if pyrt.py_type(value) == "dict":
      raise "cold scalar: str conversion wants scalar"
    texted = str(value)
    text_charge(state, len(texted))
    return texted
  if name == "int":
    if len(args) != 1:
      raise "cold scalar: int wants 1 arg"
    value = args[0]
    if pyrt.py_type(value) == "dict":
      raise "cold scalar: int conversion wants scalar"
    return integer(int(value))
  if name == "split":
    if len(args) < 1 or len(args) > 2 or pyrt.py_type(args[0]) != "str":
      raise "cold scalar: split wants split(s) or split(s, sep)"
    if len(args) == 2:
      if pyrt.py_type(args[1]) != "str":
        raise "cold scalar: split wants split(s) or split(s, sep)"
      parts = split(args[0], args[1])
    else:
      parts = split(args[0])
    total = 0
    for part in parts:
      total = total + len(part)
    if total > 0:
      text_charge(state, total)
    charge(state, len(parts), true)
    return {"cold_kind": "list", "items": parts}
  if name == "join":
    if len(args) != 2 or pyrt.py_type(args[0]) != "str":
      raise "cold scalar: join wants join(sep, list)"
    items = list_items(args[1])
    for item in items:
      if pyrt.py_type(item) != "str":
        raise "cold scalar: join needs a list of Str"
    result = join(args[0], items)
    text_charge(state, len(result))
    return result
  if name == "find":
    if len(args) != 2 or pyrt.py_type(args[0]) != "str" or pyrt.py_type(args[1]) != "str":
      raise "cold scalar: find wants find(s, sub)"
    return find(args[0], args[1])
  if name == "contains":
    if len(args) != 2:
      raise "cold scalar: contains wants contains(container, x)"
    container = args[0]
    needle = args[1]
    if pyrt.py_type(container) == "str":
      if pyrt.py_type(needle) != "str":
        raise "cold scalar: in Str wants a Str"
      return find(container, needle) >= 0
    if pyrt.py_type(container) != "dict" or "cold_kind" not in container or container["cold_kind"] != "list":
      raise "cold scalar: not a search container"
    for item in container["items"]:
      item_text = pyrt.py_type(item) == "str"
      needle_text = pyrt.py_type(needle) == "str"
      if item_text or needle_text:
        if item_text and needle_text and item == needle:
          return true
      elif item == needle:
        return true
    return false
  if name == "len":
    if len(args) != 1:
      raise "cold scalar: len wants one argument"
    if pyrt.py_type(args[0]) == "str":
      return len(args[0])
    return len(list_items(args[0]))
  if len(args) != 2:
    raise "cold scalar: append wants two arguments"
  items = list_items(args[0])
  item = constant(args[1])
  if len(items) >= 4096:
    raise "cold scalar: list exceeds4096 elements"
  charge(state, 1, false)
  append(items, item)
  return null
def invoke(state, key, arguments):
  fn = state[0]["funcs"][key]
  if len(arguments) != len(fn["params"]):
    raise "cold scalar: exact arity required"
  if state[5] >= 64:
    raise "cold scalar: call depth exceeded"
  state[5] = state[5] + 1
  state[6][key] = state[6][key] + 1
  try:
    return execute(state, key, arguments)
  finally:
    state[5] = state[5] - 1
def execute(state, key, arguments):
  fn = state[0]["funcs"][key]
  plan = state[1][key]
  values = {}
  variables = {}
  for i in range(len(arguments)):
    variables[fn["params"][i]] = arguments[i]
  label = fn["entry"]
  previous = null
  while true:
    block = plan[1][label]
    # Phi values read the predecessor snapshot, then publish simultaneously.
    phis = {}
    for ins in block["instrs"]:
      if ins["op"] == "phi":
        found = false
        for arm in ins["arms"]:
          if arm[0] == previous:
            phis[ins["dest"]] = values[arm[1]]
            found = true
        if not found:
          raise "cold scalar: missing phi predecessor"
    for name in keys(phis):
      values[name] = phis[name]
    for ins in block["instrs"]:
      tick(state)
      op = ins["op"]
      value = null
      if op == "const":
        value = ins["val"]
        if pyrt.py_type(value) == "str":
          text_charge(state, len(value))
      elif op == "load":
        name = ins["name"]
        if key != state[0]["entry"] and name in plan[0]:
          if name not in variables:
            raise "cold scalar: unbound local " + name
          value = variables[name]
        else:
          if name in state[2]:
            value = state[2][name]
          elif name in ["len", "append", "find", "contains", "split", "join", "str", "int", "range"]:
            value = {"cold_kind": "builtin", "name": name}
          else:
            raise "cold scalar: unbound global " + name
      elif op == "stvar" or op == "stglobal":
        name = ins["name"]
        value = values[ins["src"]]
        if key == state[0]["entry"] or op == "stglobal" or name in fn["globals"]:
          state[2][name] = value
        else:
          variables[name] = value
      elif op == "mkfunc":
        value = {"cold_kind": "function", "key": ins["func"]}
      elif op == "call":
        callee = values[ins["fn"]]
        if pyrt.py_type(callee) != "dict" or "cold_kind" not in callee:
          raise "cold scalar: not callable"
        args = []
        for arg in ins["args"]:
          append(args, values[arg])
        if callee["cold_kind"] == "function":
          value = invoke(state, callee["key"], args)
        elif callee["cold_kind"] == "builtin":
          value = builtin(state, callee["name"], args)
        elif callee["cold_kind"] == "scalar_bridge":
          for argument in args:
            integer(argument)
          if callee["calls"] >= 4096:
            raise "cold scalar: bridge call budget exhausted"
          callee["calls"] = callee["calls"] + 1
          handler = callee["handler"]
          value = integer(handler(callee["context"], args))
        else:
          raise "cold scalar: not callable"
      elif op == "build_list":
        items = []
        for item in ins["items"]:
          append(items, constant(values[item]))
        charge(state, len(items), true)
        value = {"cold_kind": "list", "items": items}
      elif op == "index":
        obj = values[ins["obj"]]
        if pyrt.py_type(obj) == "str":
          index = list_index(obj, values[ins["idx"]])
          text_charge(state, 1)
          value = obj[index]
        else:
          items = list_items(obj)
          value = items[list_index(items, values[ins["idx"]])]
      elif op == "setindex":
        items = list_items(values[ins["obj"]])
        index = list_index(items, values[ins["idx"]])
        item = constant(values[ins["val"]])
        items[index] = item
      elif op == "slice":
        obj = values[ins["obj"]]
        low = 0
        if ins["start"] != null:
          low = integer(values[ins["start"]])
        high = null
        if ins["stop"] != null:
          high = integer(values[ins["stop"]])
        if pyrt.py_type(obj) != "str":
          if pyrt.py_type(obj) == "dict" and "cold_kind" in obj and obj["cold_kind"] == "list":
            raise "cold scalar: List slices unsupported"
          raise "cold scalar: cannot slice scalar"
        size = len(obj)
        if high == null:
          high = size
        if low < 0:
          low = low + size
        if high < 0:
          high = high + size
        if low < 0:
          low = 0
        if low > size:
          low = size
        if high < 0:
          high = 0
        if high > size:
          high = size
        if low >= high:
          value = ""
        else:
          text_charge(state, high - low)
          value = obj[low:high]
      elif op == "iterseq":
        obj = values[ins["src"]]
        if pyrt.py_type(obj) == "str":
          value = obj
        elif pyrt.py_type(obj) == "dict" and "cold_kind" in obj and obj["cold_kind"] == "list":
          value = obj
        else:
          raise "cold scalar: not iterable"
      elif op == "bin":
        value = binary(state, ins["binop"], values[ins["l"]], values[ins["r"]])
      elif op == "un":
        arg = values[ins["v"]]
        if ins["unop"] == "not":
          value = not truth(arg)
        elif ins["unop"] == "neg":
          value = integer(0 - integer(arg))
        else:
          value = integer(arg)
      elif op == "copy":
        value = values[ins["src"]]
      elif op == "print":
        pieces = []
        for arg in ins["args"]:
          item = constant(values[arg])
          if pyrt.py_type(item) == "str":
            append(pieces, item)
          else:
            append(pieces, str(item))
        line = ""
        i = 0
        while i < len(pieces):
          if i > 0:
            line = line + " "
          line = line + pieces[i]
          i = i + 1
        print line
        value = line
      if op != "phi" and "dest" in ins:
        values[ins["dest"]] = value
    tick(state)
    term = block["term"]
    if term["term"] == "ret":
      return values[term["val"]] if term["val"] != null else null
    previous = label
    if term["term"] == "jmp":
      label = term["to"]
    else:
      condition = truth(values[term["cond"]])
      label = term["then"] if condition else term["els"]
def run(state):
  if state[7]:
    raise "cold scalar: state already started"
  state[7] = true
  return invoke(state, state[0]["entry"], [])
