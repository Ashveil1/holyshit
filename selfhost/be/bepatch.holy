# bepatch.holy: Python-free port of the mkbe patch step (was the
# python3 heredoc in scripts/mkbe.sh + selfhost/be/patches.py).
# argv: SRC DST. Applies the mechanical py_ -> pyrt.py_ rewrite,
# the import header, the py_open default, the tuple-loop scratch
# rename, and the maintained PATCHES list, in the same order.
# The PATCHES data below is GENERATED from the old patches.py; keep
# entries in sync by editing this file (patches.py is deleted).

PATCHES = []
append(PATCHES, ["    lo = layout(len(asm.state()[\"code\"]), len(asm.state()[\"data\"]))\n    code = asm.resolve_at(lo[\"text_vaddr\"], lo[\"data_vaddr\"])\n    start_off = asm.state()[\"labels\"][\"_start\"]\n    return pack(code, pyrt.py_bytes(asm.state()[\"data\"]), start_off, lo)", "    lo = elf.layout(len(asm.state()[\"code\"]))\n    code = asm.resolve_at(lo[\"text_vaddr\"], lo[\"data_vaddr\"])\n    start_off = asm.state()[\"labels\"][\"_start\"]\n    return elf.pack(code, asm.state()[\"data\"], start_off, lo)"])
