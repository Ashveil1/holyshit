append(PATCHES, ["str(e.msg)), e.line)", "str(pyrt.py_ewrap(e))), pyrt.py_eline(e))"])

def is_ident_ch(c):
  if c >= "0" and c <= "9":
    return true
  if c >= "a" and c <= "z":
    return true
  if c >= "A" and c <= "Z":
    return true
  return c == "_"

def replace_all(s, old, new):
  parts = []
  i = 0
  while true:
    j = find(s[i:], old)
    if j < 0:
      break
    append(parts, s[i:(i + j)])
    append(parts, new)
    i = i + j + len(old)
  append(parts, s[i:])
  return join("", parts)

def py_prefix(s):
  # re.sub(r"\bpy_(\w+)\(", r"pyrt.py_\1(", s)
  parts = []
  last = 0
  i = 0
  n = len(s)
  while i + 3 < n:
    if s[i:(i + 3)] == "py_" and (i == 0 or not is_ident_ch(s[(i - 1):i])):
      j = i + 3
      while j < n and is_ident_ch(s[j:(j + 1)]):
        j = j + 1
      if j < n and j > i + 3 and s[j:(j + 1)] == "(":
        append(parts, s[last:i])
        append(parts, "pyrt." + s[i:(j + 1)])
        last = j + 1
        i = j + 1
        continue
    i = i + 1
  append(parts, s[last:])
  return join("", parts)

def fix_py_open(s):
  # re.sub(r"pyrt\.py_open\(([^,()]+)\)", r"pyrt.py_open(\1, null)", s)
  parts = []
  last = 0
  i = 0
  n = len(s)
  needle = "pyrt.py_open("
  while true:
    k = find(s[i:], needle)
    if k < 0:
      break
    k = k + i
    j = k + len(needle)
    m = j
    ok = true
    while m < n:
      c = s[m:(m + 1)]
      if c == ")":
        break
      if c == "," or c == "(":
        ok = false
        break
      m = m + 1
    if ok and m < n and m > j:
      append(parts, s[last:m])
      append(parts, ", null")
      last = m
      i = m
    else:
      i = k + len(needle)
  append(parts, s[last:])
  return join("", parts)

def rename_scratch(s):
  # re.search(r"for (_f[0-9]+_0), label in pyrt.py_sorted\(pyrt.py_items\(self.bi_stubs\)", s)
  # then s.replace(match.group(1), "_f5833_0") - all occurrences of the name
  anchor = "for _f"
  tail = "_0, label in pyrt.py_sorted(pyrt.py_items(self.bi_stubs"
  k = find(s, anchor)
  while k >= 0:
    j = k + len(anchor)
    m = j
    while m < len(s) and s[m:(m + 1)] >= "0" and s[m:(m + 1)] <= "9":
      m = m + 1
    if m > j and s[m:(m + len(tail))] == tail:
      return replace_all(s, "_f" + s[j:m] + "_0", "_f5833_0")
    nk = find(s[(k + 1):], anchor)
    if nk < 0:
      return s
    k = k + 1 + nk
  return s

args = argv()
s = read_text(args[0])
s = py_prefix(s)
s = "import pyrt\nimport asm\nimport gcrt\nimport elf\n\n" + s
s = fix_py_open(s)
s = rename_scratch(s)
for p in PATCHES:
  if find(s, p[0]) < 0:
    print "PATCH MISSING: " + p[0][0:70]
    raise "patch missing"
  s = replace_all(s, p[0], p[1])
write_text(args[1], s)
