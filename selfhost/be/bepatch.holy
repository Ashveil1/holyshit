append(PATCHES, ["        self.bi_stubs[pyrt.py_key([name, n])] = (\"hsBI_\" + str(bid) + \"_\" + str(n))", "        self.bi_stubs[pyrt.py_key([name, n])] = [n, (\"hsBI_\" + str(bid) + \"_\" + str(n))]"])
append(PATCHES, ["asm.jmp(self.bi_stubs[pyrt.py_key([name, n])])", "asm.jmp(self.bi_stubs[pyrt.py_key([name, n])][1])"])
