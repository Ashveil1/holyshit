# Experimental isolated module boundary, not a mixed-tier runtime.
# No language objects cross. Error capture is opt-in; fatal exits remain.
import parselib
import normalize
import irbuild
import verify
import be
import pyrt
import asm
import jitimage
import jitmem
extern:
  I64 munmap(Ptr addr, U64 length)
def prepare(source, capture_error):
  return prepare_function(source, capture_error, null, null)
def prepare_function(source, capture_error, function_key, argument_sets):
  return prepare_config(source, capture_error, function_key, argument_sets, null)
def prepare_global(source, name, argument_sets):
  return prepare_config(source, true, null, argument_sets, name)
def prepare_config(source, capture_error, function_key, argument_sets, global_name):
  parselib.P["wide_literals"] = true
  irmod = irbuild.build_module(normalize.parse(read_text(source)), "")
  if global_name != null:
    if len(global_name) < 1 or len(global_name) > 128:
      raise "dispatch probe: invalid global identifier"
    for i in range(len(global_name)):
      allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_" if i == 0 else "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"
      if find(allowed, global_name[i]) < 0:
        raise "dispatch probe: invalid global identifier"
    if len(argument_sets) < 1 or len(argument_sets) > 32:
      raise "dispatch probe: wants 1..32 argument sets"
    params = []
    for i in range(len(argument_sets[0])):
      append(params, "_arg" + str(i))
    # This native wrapper uses the compiler's ordinary dynamic call lowering.
    # It loads the global on every invocation, not an exported code address.
    call = global_name + "(" + join(", ", params) + ")"
    helper = irbuild.build_module(normalize.parse("def boundary_global_call(" + join(", ", params) + "):\n  return " + call + "\n"), "__global_boundary__")
    for key in helper["order"]:
      if key != helper["entry"]:
        if key in irmod["funcs"]:
          raise "dispatch probe: private function collision"
        irmod["funcs"][key] = helper["funcs"][key]
        append(irmod["order"], key)
        function_key = key
  if capture_error:
    # Ensure the existing exception runtime is emitted even for a target
    # without try/raise. This private, unreachable IR function has no effects.
    helper = irbuild.build_module(normalize.parse("def boundary_handler_anchor():\n  try:\n    pass\n  except:\n    pass\n"), "__return_boundary__")
    for key in helper["order"]:
      if key != helper["entry"]:
        if key in irmod["funcs"]:
          raise "return boundary: private function collision"
        irmod["funcs"][key] = helper["funcs"][key]
        append(irmod["order"], key)
  verify.verify_module(irmod)
  generator = be.GenIR(irmod, pyrt.py_os_path_dirname(source), false)
  generator.build_ir_sections()
  function_entries = []
  if function_key != null:
    if not capture_error or function_key == irmod["entry"] or function_key not in irmod["funcs"]:
      raise "function probe: requires exact local non-entry IR function key"
    frame = generator.frames[function_key]
    if len(frame["caps"]) != 0:
      raise "function probe: closure captures not supported"
    if len(argument_sets) < 1 or len(argument_sets) > 32:
      raise "function probe: wants 1..32 argument sets"
    for arguments in argument_sets:
      if len(arguments) != len(frame["params"]):
        raise "function probe: exact arity required"
      for value in arguments:
        value = value | 0
        if value < -536870912 or value > 536870911:
          raise "function probe: argument outside signed30-bit range"
  # Standard C ABI callee-saved registers; no process-entry signal changes.
  entry = len(asm.state()["code"])
  for reg in ["rbx", "rbp", "r12", "r13", "r14", "r15"]:
    asm.push_r(reg)
  asm.mov_rr("rbp", "rsp")
  # argc=1, argv[0], argv terminator, environment strings, env terminator.
  # argc is not on the stack: cmd_argc_/cmd_argv_ are initialized directly.
  entries = ["hs-return-probe"]
  for value in split(read_text("/proc/self/environ"), "\0"):
    if len(value) > 0:
      append(entries, value)
  slots = len(entries) + 2
  if slots % 2 == 0:
    slots = slots + 1
  asm.sub_ri32("rsp", slots * 8)
  asm.mov_ri32("rax", 1)
  asm.mov_mr_rip("cmd_argc_", "rax")
  asm.mov_mr_rip("cmd_argv_", "rsp")
  position = 0
  for i in range(len(entries)):
    if i == 1:
      asm.mov_ri32("rax", 0)
      asm.mov_mr("rsp", "rax", position * 8)
      position = position + 1
    label = "return_probe_arg_" + str(i)
    asm.data_label(label)
    asm.data_bytes(pyrt.py_encode(entries[i], "utf-8"))
    asm.data_bytes([0])
    asm.lea_rip("rax", label)
    asm.mov_mr("rsp", "rax", position * 8)
    position = position + 1
  asm.mov_ri32("rax", 0)
  asm.mov_mr("rsp", "rax", position * 8)
  if len(entries) == 1:
    asm.mov_mr("rsp", "rax", (position + 1) * 8)
  asm.mov_mr_rip("gc_stk_", "rsp")
  if capture_error:
    asm.data_label("return_boundary_error")
    for i in range(3):
      asm.data_qword(0)
    asm.call("hs_try_push0")
    asm.test_rr("rax", "rax")
    asm.jcc("ne", "return_boundary_caught")
  asm.call("hs_main")
  if capture_error:
    asm.call("hs_try_pop")
    asm.mov_ri32("rax", 0)
    asm.jmp("return_boundary_done")
    asm.label("return_boundary_caught")
    # Root handler truncates active values to zero then pushes one triple:
    # raw message pointer/length/line. Copy metadata before dropping it.
    asm.lea_rip("rcx", "exc_vals")
    asm.lea_rip("rdx", "return_boundary_error")
    for offset in [0, 8, 16]:
      asm.mov_rm("rax", "rcx", offset)
      asm.mov_mr("rdx", "rax", offset)
    asm.call("hs_exc_pop")
    asm.mov_ri32("rax", 1)
    asm.label("return_boundary_done")
  asm.mov_rr("rsp", "rbp")
  for reg in ["r15", "r14", "r13", "r12", "rbp", "rbx"]:
    asm.pop_r(reg)
  asm.ret()
  if function_key != null:
    asm.data_label("function_probe_value")
    asm.data_qword(0)
    for index in range(len(argument_sets)):
      append(function_entries, len(asm.state()["code"]))
      for reg in ["rbx", "rbp", "r12", "r13", "r14", "r15"]:
        asm.push_r(reg)
      asm.mov_rr("rbp", "rsp")
      # Root scan reaches this invocation's live stack, never the old main frame.
      asm.mov_mr_rip("gc_stk_", "rsp")
      asm.call("hs_try_push0")
      asm.test_rr("rax", "rax")
      caught = "function_probe_caught_" + str(index)
      done = "function_probe_done_" + str(index)
      asm.jcc("ne", caught)
      arguments = argument_sets[index]
      for i in range(len(arguments)):
        value = arguments[len(arguments) - i - 1]
        asm.mov_ri64("rax", (value << 2) | 1)
        asm.push_r("rax")
      asm.mov_ri32("rax", 0)
      asm.push_r("rax")
      asm.mov_ri32("rsi", 0)
      asm.call(generator.flabel[function_key])
      asm.add_ri32("rsp", (len(arguments) + 1) * 8)
      asm.mov_mr_rip("function_probe_value", "rax")
      asm.call("hs_try_pop")
      asm.mov_ri32("rax", 0)
      asm.jmp(done)
      asm.label(caught)
      asm.lea_rip("rcx", "exc_vals")
      asm.lea_rip("rdx", "return_boundary_error")
      for offset in [0, 8, 16]:
        asm.mov_rm("rax", "rcx", offset)
        asm.mov_mr("rdx", "rax", offset)
      asm.call("hs_exc_pop")
      asm.mov_ri32("rax", 1)
      asm.label(done)
      asm.mov_rr("rsp", "rbp")
      for reg in ["r15", "r14", "r13", "r12", "rbp", "rbx"]:
        asm.pop_r(reg)
      asm.ret()
  image = jitimage.publish()
  entries = []
  for offset in function_entries:
    append(entries, image["ptr"] + offset)
  return [image, image["ptr"] + entry, asm.state()["data_labels"]["gc_tab_"], asm.state()["data_labels"]["gc_n_"], asm.state()["data_labels"]["return_boundary_error"] if capture_error else -1, entries, asm.state()["data_labels"]["function_probe_value"] if function_key != null else -1]
def readword(address):
  unsafe:
    return load64(as_ptr(address))
def release_heap(state, checkpoints):
  # Only called after controlled target return, with its image still live.
  image = state[0]
  tabaddr = image["data"] + state[2]
  countaddr = image["data"] + state[3]
  table = readword(tabaddr)
  count = readword(countaddr)
  if count < 0 or count > 1024 or count > 0 and table == 0:
    raise "return probe: invalid heap ownership table"
  # Snapshot all owned ranges before the first unmap. Valid only for the
  # current audited gcrt layout, never for untrusted foreign metadata.
  ranges = []
  for index in range(count):
    row = table + index * 32
    base = readword(row)
    end = readword(row + 8)
    bitmap = readword(row + 16)
    size = end - base
    if base <= 0 or bitmap <= 0 or size < 16777216 or size % 4096 != 0 or base % 4096 != 0 or bitmap % 4096 != 0:
      raise "return probe: invalid owned arena"
    append(ranges, [base, size])
    append(ranges, [bitmap, (size >> 7 + 4095) & -4096])
  if table != 0:
    append(ranges, [table, 32768])
  if checkpoints:
    print "JIT OWNED RANGES", json_str(ranges)
    input()
  for region in ranges:
    if munmap(region[0], region[1]) != 0:
      raise "return probe: heap unmap failed; do not retry"
  if checkpoints:
    print "JIT HEAP UNMAPPED"
    input()
  return count

# Copy error bytes before teardown. No target pointer escapes this helper.
def invoke(pointer):
  unsafe:
    return call0(as_ptr(pointer))
def finish(state, checkpoints):
  result = invoke(state[1])
  if result not in [0, 1]:
    raise "status probe: invalid native outcome"
  # Copy bytes into the driver's independent heap while target mappings live.
  # No target object or raw pointer may escape the teardown below.
  error = null
  if result == 1:
    record = state[0]["data"] + state[4]
    address = readword(record)
    length = readword(record + 8)
    line = readword(record + 16)
    if address <= 0 or length < 0:
      raise "status probe: invalid error metadata"
    error = [read_mem(address, length), line]
  arenas = release_heap(state, checkpoints)
  jitmem.release(state[0])
  return [result, error, arenas, state[0]["live"]]

def scalar_outcome(state, pointer, has_value):
  status = invoke(pointer)
  if status == 1:
    record = state[0]["data"] + state[4]
    message = readword(record)
    length = readword(record + 8)
    line = readword(record + 16)
    return [1, [read_mem(message, length), line]]
  if status != 0:
    raise "function probe: invalid native status"
  if not has_value:
    return [0, null]
  value = readword(state[0]["data"] + state[6])
  # Scalar-only boundary. Never read, box or export a target heap object.
  if value & 3 != 1:
    raise "function probe: non-integer return not supported"
  return [0, value >> 2]
