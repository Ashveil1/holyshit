# Experimental x86-64 hot pure-scalar leaves. No shared objects or target heap.
import asm
import pyrt
def create(threshold, max_sites, max_images):
  for value in [threshold, max_sites, max_images]:
    if pyrt.py_type(value) != "int" or value < 1 or value > 4096:
      raise "hotleaf: limits must be Int 1..4096"
  return {"threshold": threshold, "max_sites": max_sites, "max_images": max_images, "sites": {}, "images": [], "live": true, "compiled": 0, "calls": 0, "fallbacks": 0, "rejected": 0, "dropped": 0}
def small(v):
  if pyrt.py_type(v) != "int":
    return false
  return v >= (0 - 536870912) and v <= 536870911
def finite(v):
  # inf and NaN fail this; both signed zeros pass.
  return pyrt.py_type(v) == "float" and v * 0.0 == 0.0
def f64bytes(v):
  # Eight little-endian bytes of a finite double. py_f64bits loses the
  # negative-zero sign, which the str spelling still carries.
  if v == 0 and str(v)[0:1] == "-":
    return [0, 0, 0, 0, 0, 0, 0, 128]
  return pyrt.py_f64bits(v)
def f64frombytes(bs):
  # Exact inverse of f64bytes for finite values: every step (mantissa over
  # 2^52, doubling, halving) is exact in doubles, so the round trip keeps
  # every bit, including subnormals and -0.0.
  sign = 1.0
  if bs[7] >= 128:
    sign = -1.0
  exp = (bs[7] & 127) * 16 + (bs[6] >> 4)
  if exp == 2047:
    raise "hotleaf: non-finite native result"
  m = bs[6] & 15
  m = m * 256 + bs[5]
  m = m * 256 + bs[4]
  m = m * 256 + bs[3]
  m = m * 256 + bs[2]
  m = m * 256 + bs[1]
  m = m * 256 + bs[0]
  frac = m / 4503599627370496.0
  if exp == 0:
    v = frac
    k = 1022
    while k > 0:
      v = v / 2.0
      k = k - 1
    return v * sign
  v = 1.0 + frac
  e = exp - 1023
  while e > 0:
    v = v * 2.0
    e = e - 1
  while e < 0:
    v = v / 2.0
    e = e + 1
  return v * sign
def fmod_scratch(o8, o16, o24, retry):
  # [rbp-o24] = truncating remainder of [rbp-o8] by [rbp-o16] via x87 fprem.
  # fprem is exact; the C2 retry loop covers huge quotients. rax clobbered.
  asm.mov_rr("rax", "rbp")
  asm.sub_ri32("rax", o16)
  asm.fld_m64("rax", 0)
  asm.mov_rr("rax", "rbp")
  asm.sub_ri32("rax", o8)
  asm.fld_m64("rax", 0)
  asm.label(retry)
  asm.fprem()
  asm.fnstsw_ax()
  asm.sahf()
  asm.jcc("p", retry)
  asm.fstp_st1()
  asm.mov_rr("rax", "rbp")
  asm.sub_ri32("rax", o24)
  asm.fstp_m64("rax", 0)
def plan(fn, kinds):
  if len(fn["blocks"]) < 1 or len(fn["blocks"]) > 16 or len(fn["params"]) > 6 or len(fn["globals"]) != 0:
    return null
  if len(kinds) != len(fn["params"]):
    return null
  pkind = {}
  for i in range(len(fn["params"])):
    pkind[fn["params"][i]] = kinds[i]
  by = {}
  preds = {}
  remaining = {}
  for b in fn["blocks"]:
    lab = b["label"]
    if lab in by:
      return null
    by[lab] = b
    preds[lab] = []
    remaining[lab] = 0
  if fn["entry"] not in by:
    return null
  for b in fn["blocks"]:
    tm = b["term"]
    targets = []
    if tm["term"] == "jmp":
      targets = [tm["to"]]
    elif tm["term"] == "br":
      targets = [tm["then"], tm["els"]]
    elif tm["term"] != "ret" or tm["val"] == null:
      return null
    for target in targets:
      if target not in by:
        return null
      append(preds[target], b["label"])
      remaining[target] = remaining[target] + 1
  if remaining[fn["entry"]] != 0:
    return null
  # Dominators, by fixpoint on this small bounded CFG. An edge X->Y is a
  # back edge only when the header Y dominates the latch X; plain cycle
  # edges do not qualify.
  dom = {}
  for b in fn["blocks"]:
    dom[b["label"]] = {}
    for other in fn["blocks"]:
      dom[b["label"]][other["label"]] = true
  dom[fn["entry"]] = {}
  dom[fn["entry"]][fn["entry"]] = true
  changed = true
  while changed:
    changed = false
    for b in fn["blocks"]:
      if b["label"] == fn["entry"]:
        continue
      if len(preds[b["label"]]) == 0:
        continue
      newd = {}
      for other in fn["blocks"]:
        common = true
        for parent in preds[b["label"]]:
          if other["label"] not in dom[parent]:
            common = false
        if common:
          newd[other["label"]] = true
      newd[b["label"]] = true
      for key in by:
        if (key in newd) != (key in dom[b["label"]]):
          changed = true
      dom[b["label"]] = newd
  # Every edge X->Y where the header Y dominates the latch X is a back edge.
  # Back edges group by header into natural loops: one loop per header, with
  # one or more latches each (a continue edge is a second latch).
  back_edges = {}
  for b in fn["blocks"]:
    tm = b["term"]
    targets = []
    if tm["term"] == "jmp":
      targets = [tm["to"]]
    elif tm["term"] == "br":
      targets = [tm["then"], tm["els"]]
    for target in targets:
      if target in dom[b["label"]] and target != b["label"]:
        if b["label"] not in back_edges:
          back_edges[b["label"]] = {}
        back_edges[b["label"]][target] = true
  loop_headers = {}
  preheaders = {}
  latches = {}
  loop_block_sets = {}
  for b in fn["blocks"]:
    lab = b["label"]
    my_latches = []
    for src in back_edges:
      if lab in back_edges[src]:
        append(my_latches, src)
    if len(my_latches) == 0:
      continue
    # Each latch jumps unconditionally to the header, and the header's only
    # other predecessor is the preheader outside the loop.
    for latch in my_latches:
      if by[latch]["term"]["term"] != "jmp":
        return null
    if len(preds[lab]) != len(my_latches) + 1:
      return null
    preheader = null
    for parent in preds[lab]:
      if parent not in back_edges or lab not in back_edges[parent]:
        if preheader != null:
          return null
        preheader = parent
    if preheader == null:
      return null
    # Loop blocks reach a latch without passing through the header.
    blocks = {}
    for cand in by:
      if cand == lab:
        continue
      seen = {}
      stack = [cand]
      while len(stack) > 0:
        cur = stack[len(stack) - 1]
        stack = stack[:len(stack) - 1]
        if cur in seen or cur == lab:
          continue
        seen[cur] = true
        tm = by[cur]["term"]
        if tm["term"] == "jmp":
          append(stack, tm["to"])
        elif tm["term"] == "br":
          append(stack, tm["then"])
          append(stack, tm["els"])
      for latch in my_latches:
        if latch in seen:
          blocks[cand] = true
    blocks[lab] = true
    if preheader in blocks:
      return null
    # No path enters the loop body from outside it.
    for cand in blocks:
      if cand == lab:
        continue
      for parent in preds[cand]:
        if parent not in blocks:
          return null
    loop_headers[lab] = true
    preheaders[lab] = preheader
    latches[lab] = my_latches
    loop_block_sets[lab] = blocks
    remaining[lab] = remaining[lab] - len(my_latches)
  # Loops may share blocks only by nesting: for every pair that shares a
  # block, the smaller loop's blocks must lie entirely inside the larger's.
  # Partial overlap cannot come from structured control flow and refuses.
  hdrs = []
  for h in loop_block_sets:
    append(hdrs, h)
  for i in range(len(hdrs)):
    for j in range(i + 1, len(hdrs)):
      shared = false
      for cand in loop_block_sets[hdrs[i]]:
        if cand in loop_block_sets[hdrs[j]]:
          shared = true
      if shared:
        a_in_b = true
        for cand in loop_block_sets[hdrs[i]]:
          if cand not in loop_block_sets[hdrs[j]]:
            a_in_b = false
        b_in_a = true
        for cand in loop_block_sets[hdrs[j]]:
          if cand not in loop_block_sets[hdrs[i]]:
            b_in_a = false
        if not a_in_b and not b_in_a:
          return null
  stored = {}
  stored_in = {}
  for b in fn["blocks"]:
    for ins in b["instrs"]:
      if ins["op"] == "stvar":
        stored[ins["name"]] = true
        for h in loop_block_sets:
          if b["label"] in loop_block_sets[h]:
            if h not in stored_in:
              stored_in[h] = {}
            stored_in[h][ins["name"]] = true
  queue = [fn["entry"]]
  order = []
  available = {}
  lavailable = {}
  slots = {}
  types = {}
  local_loads = {}
  local_phis = {}
  lp_count = 0
  pending_arms = []
  count = 0
  result_type = null
  qi = 0
  while qi < len(queue):
    lab = queue[qi]
    qi = qi + 1
    b = by[lab]
    have = {}
    lhave = {}
    if len(preds[lab]) == 0:
      # A stored parameter starts from a synthetic entry version of the raw
      # argument, so later versions and the argument itself can meet in phis.
      for i in range(len(fn["params"])):
        name = fn["params"][i]
        if name in stored:
          tmp = "lpar" + str(i)
          slots[tmp] = (len(slots) + 1) * 8
          types[tmp] = pkind[name]
          have[tmp] = true
          lhave[name] = tmp
          if lab not in local_phis:
            local_phis[lab] = []
          append(local_phis[lab], {"op": "load", "dest": tmp, "name": name})
    if lab in loop_headers:
      # Header: only the preheader edge has a processed version state. Names
      # stored inside the loop become loop phis whose latch arms are filled
      # once the latch blocks have been walked; other names flow through.
      preheader = preheaders[lab]
      hstored = {}
      if lab in stored_in:
        hstored = stored_in[lab]
      for temp in available[preheader]:
        have[temp] = true
      for name in lavailable[preheader]:
        src = lavailable[preheader][name]
        if name not in hstored:
          lhave[name] = src
        else:
          lp_count = lp_count + 1
          tmp = "lphi" + str(lp_count)
          slots[tmp] = (len(slots) + 1) * 8
          types[tmp] = types[src]
          have[tmp] = true
          lhave[name] = tmp
          if lab not in local_phis:
            local_phis[lab] = []
          ins = {"op": "phi", "dest": tmp, "arms": [[preheader, src]]}
          append(local_phis[lab], ins)
          append(pending_arms, [ins, name, lab])
    elif len(preds[lab]) > 0:
      first = available[preds[lab][0]]
      for temp in first:
        common = true
        for parent in preds[lab]:
          if temp not in available[parent]:
            common = false
        if common:
          have[temp] = true
      # A local bound on every incoming path stays visible. Arms that bind
      # one local to different available temps of one static kind meet in a
      # synthetic phi, lowered like any other join.
      first_l = lavailable[preds[lab][0]]
      for name in first_l:
        common = true
        for parent in preds[lab]:
          if name not in lavailable[parent]:
            common = false
        if common:
          src0 = first_l[name]
          same = true
          arms = []
          for parent in preds[lab]:
            src = lavailable[parent][name]
            if src != src0:
              same = false
            append(arms, [parent, src])
          if same:
            lhave[name] = src0
          else:
            ty0 = types[src0]
            for arm in arms:
              if types[arm[1]] != ty0:
                return null
            lp_count = lp_count + 1
            tmp = "lphi" + str(lp_count)
            slots[tmp] = (len(slots) + 1) * 8
            types[tmp] = ty0
            have[tmp] = true
            lhave[name] = tmp
            if lab not in local_phis:
              local_phis[lab] = []
            append(local_phis[lab], {"op": "phi", "dest": tmp, "arms": arms})
    for ins in b["instrs"]:
      count = count + 1
      if count > 128:
        return null
      op = ins["op"]
      ty = "Int"
      if op == "stvar":
        # Local and parameter stores bind a new private scalar version of the
        # name. The stored temporary must be available; an earlier version is
        # shadowed, and paths that diverge meet again through the join phis.
        if ins["src"] not in have:
          return null
        lhave[ins["name"]] = ins["src"]
        continue
      if op == "phi":
        # Each incoming edge supplies one available scalar of the same kind.
        if len(ins["arms"]) != len(preds[lab]) or len(ins["arms"]) == 0:
          return null
        seen_arms = {}
        phi_type = null
        for arm in ins["arms"]:
          parent = arm[0]
          if parent not in preds[lab] or parent in seen_arms:
            return null
          seen_arms[parent] = true
          if arm[1] not in available[parent]:
            return null
          arm_type = types[arm[1]]
          if phi_type != null and phi_type != arm_type:
            return null
          phi_type = arm_type
        ty = phi_type
      elif op == "load":
        if ins["name"] in lhave:
          src = lhave[ins["name"]]
          if src not in have:
            return null
          local_loads[ins["dest"]] = src
          ty = types[src]
        elif ins["name"] not in fn["params"]:
          return null
        else:
          ty = pkind[ins["name"]]
      elif op == "const":
        if pyrt.py_type(ins["val"]) == "bool":
          ty = "Bool"
        elif small(ins["val"]):
          ty = "Int"
        elif finite(ins["val"]):
          ty = "Float"
        else:
          return null
      elif op == "bin":
        if ins["l"] not in have or ins["r"] not in have:
          return null
        both_int = types[ins["l"]] == "Int" and types[ins["r"]] == "Int"
        bool_eq = types[ins["l"]] == "Bool" and types[ins["r"]] == "Bool" and ins["binop"] in ["==", "!="]
        both_float = types[ins["l"]] == "Float" and types[ins["r"]] == "Float"
        mixed_num = (types[ins["l"]] == "Float" or types[ins["r"]] == "Float") and (types[ins["l"]] == "Int" or types[ins["r"]] == "Int")
        if not both_int and not bool_eq and not both_float and not mixed_num:
          return null
        if ins["binop"] in ["<", "<=", ">", ">=", "==", "!="]:
          ty = "Bool"
        elif both_float or mixed_num:
          # Mixed Int/Float arithmetic converts the Int operand exactly:
          # every admitted Int is Int30, far below 2^53, so the conversion
          # never rounds and IEEE arithmetic matches the interpreter.
          if ins["binop"] not in ["+", "-", "*", "/", "%"]:
            return null
          ty = "Float"
        elif ins["binop"] not in ["+", "-", "*", "%", "&", "|", "^", "<<", ">>"]:
          return null
      elif op == "un":
        if ins["v"] not in have:
          return null
        if ins["unop"] == "not":
          ty = "Bool"
        elif ins["unop"] == "neg" and types[ins["v"]] == "Float":
          ty = "Float"
        elif ins["unop"] not in ["neg", "unot"] or types[ins["v"]] != "Int":
          return null
      else:
        return null
      if ins["dest"] in slots:
        return null
      slots[ins["dest"]] = (len(slots) + 1) * 8
      types[ins["dest"]] = ty
      have[ins["dest"]] = true
    tm = b["term"]
    targets = []
    if tm["term"] == "ret":
      if tm["val"] not in have:
        return null
      # One statically known scalar result kind crosses the native boundary.
      # Mixed-kind returns remain interpreted, without truth coercion.
      kind = types[tm["val"]]
      if result_type != null and result_type != kind:
        return null
      result_type = kind
    elif tm["term"] == "jmp":
      targets = [tm["to"]]
    else:
      if tm["cond"] not in have:
        return null
      targets = [tm["then"], tm["els"]]
    available[lab] = have
    lavailable[lab] = lhave
    append(order, b)
    for target in targets:
      if lab in back_edges and target in back_edges[lab]:
        continue
      remaining[target] = remaining[target] - 1
      if remaining[target] == 0:
        append(queue, target)
  # An unresolved cycle or an unreachable block cannot enter this walk.
  if len(order) != len(fn["blocks"]):
    return null
  # Loop phis resolve one arm per latch from each latch's final version
  # state, all kind-checked against the preheader arm's kind.
  for pending in pending_arms:
    ins = pending[0]
    name = pending[1]
    header = pending[2]
    for latch in latches[header]:
      if name not in lavailable[latch]:
        return null
      latch_src = lavailable[latch][name]
      if types[latch_src] != types[ins["dest"]]:
        return null
      append(ins["arms"], [latch, latch_src])
  return [order, slots, types, result_type, local_loads, local_phis]
def guard():
  asm.cmp_ri32("rax", 0 - 536870912)
  asm.jcc("l", "fallback")
  asm.cmp_ri32("rax", 536870911)
  asm.jcc("g", "fallback")
def compile_leaf(fn, p):
  # Independent RW data page and initially RW code page, then RX code only.
  ptr = scall(9, 0, 8192, 3, 34, 0 - 1, 0)
  if ptr < 0 or ptr == 0:
    raise "hotleaf: mmap failed"
  try:
    asm.reset()
    has_fmod = false
    for block in p[0]:
      for ins in block["instrs"]:
        if ins["op"] == "bin" and ins["binop"] == "%" and (p[2][ins["l"]] == "Float" or p[2][ins["r"]] == "Float"):
          has_fmod = true
    asm.push_r("rbp")
    asm.mov_rr("rbp", "rsp")
    frame_extra = 0
    if has_fmod:
      frame_extra = 24
    asm.sub_ri32("rsp", (len(p[1]) * 8 + frame_extra + 15) & (0 - 16))
    asm.mov_ri64("rdi", ptr + 4096)
    # Status slot after the six argument slots: 0 success, 1 replay. The
    # result itself never carries a sentinel, so every 64-bit result
    # pattern, including Float bits, is unambiguous.
    asm.mov_ri32("rax", 0)
    asm.mov_mr("rdi", "rax", 48)
    block_ids = {}
    for i in range(len(p[0])):
      block_ids[p[0][i]["label"]] = i
    # Finite float constants live in the data page past the status and
    # result slots; the leaf loads their raw bits from there.
    fconst_off = {}
    fconst_bytes = []
    fnext = 64
    for block in p[0]:
      for ins in block["instrs"]:
        if ins["op"] == "const" and p[2][ins["dest"]] == "Float":
          fconst_off[ins["dest"]] = fnext
          append(fconst_bytes, [fnext, f64bytes(ins["val"])])
          fnext = fnext + 8
    for block in p[0]:
      asm.label("block_" + block["label"])
      instrs = []
      if block["label"] in p[5]:
        instrs = p[5][block["label"]]
      for ins in instrs + block["instrs"]:
        op = ins["op"]
        if op == "stvar":
          continue
        if op == "phi":
          done_phi = "phi_done_" + str(p[1][ins["dest"]])
          for i in range(len(ins["arms"])):
            arm = ins["arms"][i]
            next_arm = "phi_next_" + str(p[1][ins["dest"]]) + "_" + str(i)
            asm.cmp_ri32("r8", block_ids[arm[0]])
            asm.jcc("ne", next_arm)
            asm.mov_rm("rax", "rbp", 0 - p[1][arm[1]])
            asm.jmp(done_phi)
            asm.label(next_arm)
          asm.jmp("fallback")
          asm.label(done_phi)
        elif op == "load":
          if ins["dest"] in p[4]:
            asm.mov_rm("rax", "rbp", 0 - p[1][p[4][ins["dest"]]])
          else:
            idx = 0
            while fn["params"][idx] != ins["name"]:
              idx = idx + 1
            asm.mov_rm("rax", "rdi", idx * 8)
        elif op == "const":
          if ins["dest"] in fconst_off:
            asm.mov_rm("rax", "rdi", fconst_off[ins["dest"]])
          else:
            asm.mov_ri64("rax", int(ins["val"]))
        elif op == "un":
          asm.mov_rm("rax", "rbp", 0 - p[1][ins["v"]])
          if ins["unop"] == "not":
            if p[2][ins["v"]] == "Float":
              # ±0.0 are the only falsey doubles; NaN stays truthy.
              asm.shl_ri8("rax", 1)
            asm.cmp_ri32("rax", 0)
            asm.setcc_al("e")
            asm.movzx_eax_al()
          elif ins["unop"] == "unot":
            asm.not_r("rax")
          elif p[2][ins["v"]] == "Float":
            # IEEE negation is a sign-bit flip.
            asm.mov_rr("rcx", "rax")
            asm.mov_ri64("rax", 1)
            asm.shl_ri8("rax", 63)
            asm.xor_rr("rax", "rcx")
          else:
            asm.neg_r("rax")
        elif op == "bin" and (p[2][ins["l"]] == "Float" or p[2][ins["r"]] == "Float"):
          asm.mov_rm("rax", "rbp", 0 - p[1][ins["l"]])
          asm.mov_rm("rcx", "rbp", 0 - p[1][ins["r"]])
          if p[2][ins["l"]] == "Float":
            asm.movq_xr(0, "rax")
          else:
            # Int30 converts exactly; the guest's mixed arithmetic matches.
            asm.cvtsi2sd(0, "rax")
          if p[2][ins["r"]] == "Float":
            asm.movq_xr(1, "rcx")
          else:
            asm.cvtsi2sd(1, "rcx")
          if ins["binop"] == "+":
            asm.addsd(0, 1)
          elif ins["binop"] == "-":
            asm.subsd(0, 1)
          elif ins["binop"] == "*":
            asm.mulsd(0, 1)
          elif ins["binop"] == "/":
            # The guest raises on a zero divisor of either kind, so replay.
            if p[2][ins["r"]] == "Float":
              asm.mov_rr("r11", "rcx")
              asm.shl_ri8("r11", 1)
              asm.test_rr("r11", "r11")
            else:
              asm.cmp_ri32("rcx", 0)
            asm.jcc("e", "fallback")
            asm.divsd(0, 1)
          elif ins["binop"] == "%":
            # Python modulo: the exact x87 remainder, then the divisor's
            # sign. A zero divisor of either kind replays the guest error.
            if p[2][ins["r"]] == "Float":
              asm.mov_rr("r11", "rcx")
              asm.shl_ri8("r11", 1)
              asm.test_rr("r11", "r11")
            else:
              asm.cmp_ri32("rcx", 0)
            asm.jcc("e", "fallback")
            # The x87 path needs doubles; take the converted operands, not
            # the raw Int/Float bit patterns still in rax/rcx.
            asm.movq_rx("rax", 0)
            asm.movq_rx("rcx", 1)
            fs8 = len(p[1]) * 8 + 8
            fs16 = len(p[1]) * 8 + 16
            fs24 = len(p[1]) * 8 + 24
            asm.mov_mr("rbp", "rax", 0 - fs8)
            asm.mov_mr("rbp", "rcx", 0 - fs16)
            fretry = "fmod_" + str(p[1][ins["dest"]])
            fmod_scratch(fs8, fs16, fs24, fretry)
            asm.mov_rm("rax", "rbp", 0 - fs24)
            # Sign mask 0x8000000000000000 built without a wide immediate.
            asm.mov_ri64("rdx", 1)
            asm.shl_ri8("rdx", 63)
            fzero = "fmodz_" + str(p[1][ins["dest"]])
            fdone = "fmodd_" + str(p[1][ins["dest"]])
            asm.mov_rr("r11", "rax")
            asm.shl_ri8("r11", 1)
            asm.test_rr("r11", "r11")
