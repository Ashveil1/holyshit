def dispatch(ctx, key, fn, args):
  if not ctx["live"]:
    raise "hotleaf: released context"
  if key not in ctx["sites"]:
    if len(ctx["sites"]) >= ctx["max_sites"]:
      if ctx["dropped"] < 2147483647:
        ctx["dropped"] = ctx["dropped"] + 1
      return [false, null]
    ctx["sites"][key] = {"count": 0, "image": null, "rejected": false}
  site = ctx["sites"][key]
  if site["count"] < 2147483647:
    site["count"] = site["count"] + 1
  if site["rejected"] or site["count"] < ctx["threshold"]:
    return [false, null]
  kinds = []
  bad = false
  for value in args:
    if small(value):
      append(kinds, "Int")
    elif finite(value):
      append(kinds, "Float")
    else:
      bad = true
  if bad:
    ctx["fallbacks"] = ctx["fallbacks"] + 1
    return [false, null]
  if site["image"] != null:
    # One argument-kind signature per site; a later call of a different
    # shape replays in the interpreter.
    sig = site["sig"]
    match = len(sig) == len(kinds)
    i = 0
    while match and i < len(sig):
      if sig[i] != kinds[i]:
        match = false
      i = i + 1
    if not match:
      ctx["fallbacks"] = ctx["fallbacks"] + 1
      return [false, null]
  if site["image"] == null:
    p = plan(fn, kinds)
    if p == null or len(ctx["images"]) >= ctx["max_images"]:
      site["rejected"] = true
      ctx["rejected"] = ctx["rejected"] + 1
      return [false, null]
    # Compilation/publication is optional. Its cleanup owns partial mappings;
    # failure must not turn a valid interpreted call into a language error.
    image = null
    try:
      image = compile_leaf(fn, p)
    except:
      site["rejected"] = true
      ctx["rejected"] = ctx["rejected"] + 1
      return [false, null]
    site["image"] = image
    site["sig"] = kinds
    append(ctx["images"], site["image"])
    ctx["compiled"] = ctx["compiled"] + 1
  image = site["image"]
  for i in range(len(args)):
    v = args[i]
    address = image["data"] + i * 8
    if kinds[i] == "Int":
      unsafe:
        store64(as_ptr(address), v)
    else:
      bs = f64bytes(v)
      for k in range(8):
        b = bs[k]
        unsafe:
          store8(as_ptr(address + k), b)
  address = image["ptr"]
  value = null
  unsafe:
    value = call0(as_ptr(address))
  status = 0
  data = image["data"]
  unsafe:
    status = load64(as_ptr(data + 48))
  if status != 0:
    ctx["fallbacks"] = ctx["fallbacks"] + 1
    return [false, null]
  ctx["calls"] = ctx["calls"] + 1
  if image["result_type"] == "Bool":
    return [true, value != 0]
  if image["result_type"] == "Float":
    rbs = []
    for k in range(8):
      rb = 0
      unsafe:
        rb = load8(as_ptr(data + 56 + k))
      append(rbs, rb)
    return [true, f64frombytes(rbs)]
  return [true, value]
def release(ctx):
  if not ctx["live"]:
    raise "hotleaf: context already released"
  for image in ctx["images"]:
    if image["live"]:
      if scall(11, image["ptr"], 8192, 0, 0, 0, 0) != 0:
        raise "hotleaf: munmap failed"
      image["live"] = false
  ctx["live"] = false
