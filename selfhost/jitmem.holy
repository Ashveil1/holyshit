# Linux x86-64 executable-memory ownership for future JIT code.
# No page is writable and executable at the same time. This is not a JIT.
extern:
  I64 mmap(Ptr addr, U64 length, I64 prot, I64 flags, I64 fd, I64 offset)
  I64 mprotect(Ptr addr, U64 length, I64 prot)
  I64 munmap(Ptr addr, U64 length)
def publish(code):
  # Validate before allocating; reject Bool and non-byte values.
  code = code + []
  n = len(code)
  if n < 1 or n > 16777216:
    raise "jitmem: code size must be 1..16777216"
  for b in code:
    if b & 255 != b:
      raise "jitmem: code must contain bytes"
  return publish_sections(code, [], null)
def checked_bytes(xs):
  xs = xs + []
  if len(xs) > 16777216:
    raise "jitmem: section too large"
  for b in xs:
    if b & 255 != b:
      raise "jitmem: section must contain bytes"
  return xs
def publish_sections(code, data, relocate):
  code = checked_bytes(code)
  data = checked_bytes(data)
  n = len(code)
  if n < 1:
    raise "jitmem: empty code section"
  code_size = (n + 4095) & -4096
  data_size = (len(data) + 4095) & -4096
  size = code_size + data_size
  ptr = mmap(0, size, 3, 34, -1, 0)
  if ptr == -1 or ptr == 0:
    raise "jitmem: mmap failed"
  try:
    if relocate != null:
      code = checked_bytes(relocate(ptr, ptr + code_size))
      if len(code) != n:
        raise "jitmem: relocation changed code size"
    unsafe:
      Ptr p = as_ptr(ptr)
    i = 0
    while i + 8 <= n:
      b0 = code[i]
      b1 = code[i + 1]
      b2 = code[i + 2]
      b3 = code[i + 3]
      b4 = code[i + 4]
      b5 = code[i + 5]
      b6 = code[i + 6]
      b7 = code[i + 7]
      unsafe:
        store8(p + i, b0)
        store8(p + i + 1, b1)
        store8(p + i + 2, b2)
        store8(p + i + 3, b3)
        store8(p + i + 4, b4)
        store8(p + i + 5, b5)
        store8(p + i + 6, b6)
        store8(p + i + 7, b7)
      i = i + 8
    while i < n:
      b = code[i]
      unsafe:
        store8(p + i, b)
      i = i + 1
    nd = len(data)
    i = 0
    while i + 8 <= nd:
      b0 = data[i]
      b1 = data[i + 1]
      b2 = data[i + 2]
      b3 = data[i + 3]
      b4 = data[i + 4]
      b5 = data[i + 5]
      b6 = data[i + 6]
      b7 = data[i + 7]
      unsafe:
        store8(p + code_size + i, b0)
        store8(p + code_size + i + 1, b1)
        store8(p + code_size + i + 2, b2)
        store8(p + code_size + i + 3, b3)
        store8(p + code_size + i + 4, b4)
        store8(p + code_size + i + 5, b5)
        store8(p + code_size + i + 6, b6)
        store8(p + code_size + i + 7, b7)
      i = i + 8
    while i < nd:
      b = data[i]
      unsafe:
        store8(p + code_size + i, b)
      i = i + 1
    if mprotect(ptr, code_size, 5) != 0:
      raise "jitmem: mprotect failed"
  except as e:
    munmap(ptr, size)
    raise e
  return {"ptr": ptr, "size": size, "length": n, "live": true, "data": ptr + code_size, "data_size": data_size}
def publish_resolved(code, data, relocate):
  # Fast path for jitimage.publish: the code list comes straight from the
  # assembler and relocate() is jitimage.resolve_at, so both are already
  # valid byte lists - skip the checked_bytes passes and copy once.
  n = len(code)
  if n < 1:
    raise "jitmem: empty code section"
  code_size = (n + 4095) & -4096
  data_size = (len(data) + 4095) & -4096
  size = code_size + data_size
  ptr = mmap(0, size, 3, 34, -1, 0)
  if ptr == -1 or ptr == 0:
    raise "jitmem: mmap failed"
  try:
    if relocate != null:
      code = relocate(ptr, ptr + code_size)
      if len(code) != n:
        raise "jitmem: relocation changed code size"
    unsafe:
      Ptr p = as_ptr(ptr)
    i = 0
    while i + 8 <= n:
      b0 = code[i]
      b1 = code[i + 1]
      b2 = code[i + 2]
      b3 = code[i + 3]
      b4 = code[i + 4]
      b5 = code[i + 5]
      b6 = code[i + 6]
      b7 = code[i + 7]
      unsafe:
        store8(p + i, b0)
        store8(p + i + 1, b1)
        store8(p + i + 2, b2)
        store8(p + i + 3, b3)
        store8(p + i + 4, b4)
        store8(p + i + 5, b5)
        store8(p + i + 6, b6)
        store8(p + i + 7, b7)
      i = i + 8
    while i < n:
      b = code[i]
      unsafe:
        store8(p + i, b)
      i = i + 1
    nd = len(data)
    i = 0
    while i + 8 <= nd:
      b0 = data[i]
      b1 = data[i + 1]
      b2 = data[i + 2]
      b3 = data[i + 3]
      b4 = data[i + 4]
      b5 = data[i + 5]
      b6 = data[i + 6]
      b7 = data[i + 7]
      unsafe:
        store8(p + code_size + i, b0)
        store8(p + code_size + i + 1, b1)
        store8(p + code_size + i + 2, b2)
        store8(p + code_size + i + 3, b3)
        store8(p + code_size + i + 4, b4)
        store8(p + code_size + i + 5, b5)
        store8(p + code_size + i + 6, b6)
        store8(p + code_size + i + 7, b7)
      i = i + 8
    while i < nd:
      b = data[i]
      unsafe:
        store8(p + code_size + i, b)
      i = i + 1
    if mprotect(ptr, code_size, 5) != 0:
      raise "jitmem: mprotect failed"
  except as e:
    munmap(ptr, size)
    raise e
  return {"ptr": ptr, "size": size, "length": n, "live": true, "data": ptr + code_size, "data_size": data_size}
def release(image):
  if not image["live"]:
    raise "jitmem: image already released"
  if munmap(image["ptr"], image["size"]) != 0:
    raise "jitmem: munmap failed"
  image["live"] = false
  image["ptr"] = 0
  image["data"] = 0
